# credentials — never commit
.env
zk/.env
kraft/.env
zk/monitoring/.env
epc/.env

# reference files not needed in repo
docker-compose-ref.yml

# built bundles and saved docker images — published via GitHub Releases
dist/
images/
docker-offline/
security-reports/
.DS_Store

# Generated TLS certs (created at install time)
zk/certs/
kraft/certs/
epc/certs/
certs/

# local working docs — not part of the repo
PLAN.md
HANDOFF.md
docs/

# interim VM survey tooling — not part of the repo build
vm-survey.sh
vm-survey.mk

# local validation tooling — source and releases only in the remote repo
tests/

# Site-specific SSO settings and credentials; only local defaults are shipped.
epc/auth/*
!epc/auth/ui/
epc/auth/ui/*
!epc/auth/ui/local.yml
kraft/auth/*
!kraft/auth/ui/
kraft/auth/ui/*
!kraft/auth/ui/local.yml
monitoring/auth/*
!monitoring/auth/local.ini
sso/site*.json

# Python tooling bytecode
__pycache__/
*.pyc
