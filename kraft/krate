#!/usr/bin/env bash
# krate — Krate (Kafka) cluster management CLI
# Usage: krate <command> [options]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
ENV_FILE="$SCRIPT_DIR/.env"
ENV_TEMPLATE="$SCRIPT_DIR/.env.template"
IMAGES_DIR="$SCRIPT_DIR/images"
DOCKER_OFFLINE_DIR="$SCRIPT_DIR/docker-offline"
KRATE_VARIANT="kraft"
CERTS_DIR="$SCRIPT_DIR/certs"
CERT_CRT="$CERTS_DIR/server.crt"
CERT_KEY="$CERTS_DIR/server.key"
# Set when this CLI runs from a source checkout, where it can also build the
# Kafbat UI image and offline packages; empty inside an extracted package.
REPO_DIR=""
if [[ -f "$SCRIPT_DIR/../Makefile" && -f "$SCRIPT_DIR/../kafbat-ui/build.py" ]]; then
  REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
# Where a package is installed. Its settings, passwords, certificates and SSO
# files stay here across updates; each package only replaces the release files.
KRATE_HOME="${KRATE_HOME:-/opt/krate/$KRATE_VARIANT}"
# A broker container, whose labels tell where an earlier installation ran from.
BROKER_CONTAINER="krate-broker-92"

# ─── Compose binary detection (v2 plugin or v1 standalone) ───────────────────
if docker compose version &>/dev/null 2>&1; then
  COMPOSE_BIN=(docker compose)
elif command -v docker-compose &>/dev/null 2>&1; then
  COMPOSE_BIN=(docker-compose)
else
  COMPOSE_BIN=()
fi

# ─── Output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  BLUE='\033[0;34m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; BOLD=''; DIM=''; RESET=''
fi

info()  { echo -e "${BLUE}==>${RESET} $*"; }
ok()    { echo -e "${GREEN}  ✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}  !${RESET} $*"; }
err()   { echo -e "${RED}  ✗${RESET} $*" >&2; }
die()   { err "$*"; exit 1; }
step()  { echo -e "${BOLD}--- $* ---${RESET}"; }
sep()   { echo -e "${DIM}────────────────────────────────────────${RESET}"; }

# ─── Version helpers ──────────────────────────────────────────────────────────
# Returns 0 (true) if semver $1 >= $2
version_gte() {
  local a b
  IFS='.' read -ra a <<< "${1//[^0-9.]/}"
  IFS='.' read -ra b <<< "${2//[^0-9.]/}"
  for i in 0 1 2; do
    local x="${a[$i]:-0}" y="${b[$i]:-0}"
    (( 10#$x > 10#$y )) && return 0
    (( 10#$x < 10#$y )) && return 1
  done
  return 0
}

get_compose_version() {
  "${COMPOSE_BIN[@]}" version --short 2>/dev/null | tr -d 'v'
}

# ─── Prerequisites ────────────────────────────────────────────────────────────
require_docker() {
  if ! command -v docker &>/dev/null; then
    die "Docker not found. Run: krate docker-install"
  fi
  if ! docker info &>/dev/null 2>&1; then
    die "Docker daemon is not running or not accessible.
    Try: sudo systemctl start docker
    Or:  newgrp docker  (if you were just added to the docker group)"
  fi
}

require_compose() {
  require_docker
  if [[ ${#COMPOSE_BIN[@]} -eq 0 ]]; then
    die "Docker Compose not found. Need 'docker compose' plugin or 'docker-compose' ≥1.29.2.
Run: krate docker-install"
  fi
}

require_compose_file() {
  [[ -f "$COMPOSE_FILE" ]] || die "docker-compose.yml not found in $SCRIPT_DIR"
}

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    if [[ -f "$ENV_TEMPLATE" ]]; then
      cp "$ENV_TEMPLATE" "$ENV_FILE"
      chmod 600 "$ENV_FILE"
      ok "Created .env from template. Change settings with: krate config set KEY=VALUE"
    else
      die ".env not found and no .env.template available. Create $ENV_FILE with KAFKA_UI_USER and KAFKA_UI_PASSWORD."
    fi
  fi
}

# Image pins belong to the release, not the site: keep every *_IMAGE in an .env
# equal to its template, so an .env copied from an older package or before a
# `make kafbat-ui` rebuild never sends Compose after an image that is not here.
# Other settings are left alone. To change a pin, edit the template, or export
# the variable in the shell for one run (Compose prefers it over the .env).
sync_image_pins() {
  local env_file="$1" template="$2" keys tmp
  [[ -f "$env_file" && -f "$template" ]] || return 0
  keys="$(awk -F= '
    NR == FNR { if ($1 ~ /^[A-Z0-9_]+_IMAGE$/) pin[$1] = substr($0, length($1) + 2); next }
    $1 in pin { cur[$1] = substr($0, length($1) + 2); seen[$1] = 1 }
    END { for (k in pin) if (!(k in seen) || cur[k] != pin[k]) print k }
  ' "$template" "$env_file" | LC_ALL=C sort | xargs)"
  [[ -n "$keys" ]] || return 0
  tmp="$(mktemp)"
  awk -F= '
    NR == FNR { if ($1 ~ /^[A-Z0-9_]+_IMAGE$/) pin[$1] = substr($0, length($1) + 2); next }
    $1 in pin { seen[$1] = 1; $0 = $1 "=" pin[$1] }
    { print }
    END { for (k in pin) if (!(k in seen)) print k "=" pin[k] }
  ' "$template" "$env_file" > "$tmp" || { rm -f "$tmp"; die "Cannot update image pins in $env_file"; }
  # Rewrite in place so the file keeps its owner and mode (it holds secrets).
  cat "$tmp" > "$env_file"
  rm -f "$tmp"
  warn "Updated $keys in $env_file to match ${template##*/}" >&2
}

# A random secret of letters and digits (24 characters unless given), which
# neither .env quoting nor Compose interpolation alters.
random_secret() {
  local length="${1:-24}" secret=""
  while (( ${#secret} < length )); do
    secret+="$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9')"
  done
  echo "${secret:0:length}"
}

# Set KEY=VALUE in an env file, replacing its line or appending one. The new
# content is written to a temporary file beside the target (mode 600) and
# renamed over it, so a reader never sees a partial file and a crash leaves
# the old one intact.
set_env_file_value() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp "$(dirname "$file")/.${file##*/}.XXXXXX")" || die "Cannot create a temporary file beside $file"
  chmod 600 "$tmp"
  # Passed through the environment: awk -v would expand backslashes in values.
  KRATE_KEY="$key" KRATE_VALUE="$value" awk -F= '
    BEGIN { key = ENVIRON["KRATE_KEY"]; value = ENVIRON["KRATE_VALUE"] }
    $1 == key { if (!done) print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }
  ' "$file" > "$tmp" || { rm -f "$tmp"; die "Cannot update $key in $file"; }
  mv -f "$tmp" "$file" || { rm -f "$tmp"; die "Cannot replace $file"; }
}

# Whether a named volume of a Compose project exists.
compose_volume_exists() {
  [[ -n "$(docker volume ls -q --filter "label=com.docker.compose.project=$1" \
    --filter "label=com.docker.compose.volume=$2" 2>/dev/null)" ]]
}

# Fill each KEY whose value in an env file is still a placeholder (empty or
# REPLACE_ME) with a random secret of the given length, and print the keys
# filled. Values a site set are never changed; the old default `changeme` is
# a set value, so it is reported as insecure rather than replaced.
fill_secrets() {
  local file="$1" length="$2" key
  shift 2
  for key in "$@"; do
    case "$(env_value_file "$file" "$key")" in
      ""|REPLACE_ME) ;;
      changeme) warn "$key is changeme (insecure); set it: krate config set $key=..." >&2; continue ;;
      *) continue ;;
    esac
    set_env_file_value "$file" "$key" "$(random_secret "$length")"
    echo "$key"
  done
}

# The Compose project, which names the cluster's network and data volumes. It
# is fixed (krate-<edition>) so the data never depends on the directory a
# package was unpacked to. Installations made before that were named after their
# directory; prepare records that name as KRATE_PROJECT so their data stays in use.
cluster_project() {
  local project="${KRATE_PROJECT:-}"
  [[ -n "$project" ]] || project="$(env_value KRATE_PROJECT)"
  echo "${project:-krate-${KRATE_VARIANT}}"
}

# Compose projects holding a volume of the given name.
volume_projects() {
  docker volume ls --filter "label=com.docker.compose.volume=$1" \
    --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | LC_ALL=C sort -u
}

# Compose projects other than the fixed one that hold this edition's data
# volumes: installations from before the project name was fixed. KRaft keeps
# Kafka data in volumes (the frozen ZooKeeper edition also has zookeeper-data);
# EPC keeps it on the host and has only the Keycloak database volume.
legacy_projects() {
  local marker=kafka-92-data other=zookeeper-data
  if [[ "$KRATE_VARIANT" == epc ]]; then
    marker=keycloak_db_data other=kafka-92-data
  fi
  LC_ALL=C comm -23 <(volume_projects "$marker") <(volume_projects "$other") | grep -vx "krate-${KRATE_VARIANT}" || true
}

# Keep using the data volumes of an installation from before the fixed project
# name, so an update never starts on empty storage.
adopt_legacy_project() {
  local legacy running
  [[ -z "${KRATE_PROJECT:-}" && -z "$(env_value KRATE_PROJECT)" ]] || return 0
  legacy="$(legacy_projects | xargs)"
  # When this edition's containers exist, their project is the one being updated.
  running="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$BROKER_CONTAINER" 2>/dev/null || true)"
  if [[ -n "$running" && " $legacy " == *" $running "* ]]; then
    legacy="$running"
  fi
  case "$legacy" in
    "") return 0 ;;
    *" "*) die "Several earlier installations hold data volumes: $legacy
Choose the one this installation uses: krate config set KRATE_PROJECT=<name>" ;;
  esac
  set_env_file_value "$ENV_FILE" KRATE_PROJECT "$legacy"
  ok "Using the existing data volumes of Compose project $legacy (KRATE_PROJECT in .env)"
}

# A package is being run from the directory it was extracted to, rather than
# from the installation directory or a source checkout.
is_package() {
  [[ -z "$REPO_DIR" && -d "$IMAGES_DIR" && "$SCRIPT_DIR" != "$(cd "$KRATE_HOME" 2>/dev/null && pwd)" ]]
}

# Create the installation directory, owned by the user running krate.
ensure_home_dir() {
  if mkdir -p "$KRATE_HOME" 2>/dev/null && [[ -w "$KRATE_HOME" ]]; then
    return 0
  fi
  local -a sudo_cmd=()
  if [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    sudo_cmd=(sudo)
  fi
  info "Creating the installation directory $KRATE_HOME"
  if ! { "${sudo_cmd[@]}" mkdir -p "$KRATE_HOME" && "${sudo_cmd[@]}" chown "$(id -u):$(id -g)" "$KRATE_HOME"; }; then
    die "Could not create $KRATE_HOME. Create it, or install elsewhere: KRATE_HOME=/path ./krate install"
  fi
}

# Copy the site files of an earlier installation, or ones made by hand in the
# package directory, into the installation when it does not have them yet:
# .env, monitoring/.env, certs/, SSO files under auth/ and monitoring/auth/,
# and sso/site*.json. Existing files are never replaced.
import_site_files() {
  local src="$1" f
  [[ -d "$src" && "$(cd "$src" && pwd)" != "$(cd "$KRATE_HOME" && pwd)" ]] || return 0
  ( cd "$src" && { for f in .env monitoring/.env; do [[ -f "$f" ]] && echo "$f"; done
      find certs auth monitoring/auth -type f 2>/dev/null
      find sso -maxdepth 1 -type f -name 'site*.json' 2>/dev/null; } ) | while IFS= read -r f; do
    [[ -e "$KRATE_HOME/$f" ]] && continue
    mkdir -p "$KRATE_HOME/$(dirname "$f")"
    cp -p "$src/$f" "$KRATE_HOME/$f"
    echo "$f"
  done
}

# Install this package's release files into KRATE_HOME, replacing the previous
# release's. Site files are not part of a package and are never overwritten.
# Images were loaded from the package and are not copied. On a first install,
# site files come from --from DIR, the package directory or the directory the
# running (or stopped) cluster was started from.
deploy_release() {
  local from="$1" taken previous
  ensure_home_dir
  ( cd "$SCRIPT_DIR" && tar -cf - --exclude=./images --exclude=./docker-offline --exclude=./.env \
      --exclude=./certs --exclude=./auth --exclude=./monitoring/.env --exclude=./monitoring/auth \
      --exclude='./sso/site*.json' . ) | ( cd "$KRATE_HOME" && tar -xf - ) \
    || die "Could not copy the release files to $KRATE_HOME"
  mkdir -p "$KRATE_HOME/auth/ui" "$KRATE_HOME/auth/keycloak/truststores"
  cp "$SCRIPT_DIR/auth/ui/local.yml" "$KRATE_HOME/auth/ui/local.yml"
  if [[ -f "$SCRIPT_DIR/monitoring/auth/local.ini" ]]; then
    mkdir -p "$KRATE_HOME/monitoring/auth"
    cp "$SCRIPT_DIR/monitoring/auth/local.ini" "$KRATE_HOME/monitoring/auth/local.ini"
  fi
  ok "Installed $(basename "$SCRIPT_DIR") into $KRATE_HOME"

  if [[ -n "$from" ]]; then
    [[ -f "$from/.env" ]] || die "--from $from has no .env"
  elif [[ -f "$SCRIPT_DIR/.env" ]]; then
    from="$SCRIPT_DIR"
  elif [[ ! -f "$KRATE_HOME/.env" ]]; then
    previous="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$BROKER_CONTAINER" 2>/dev/null || true)"
    [[ -n "$previous" && -f "$previous/.env" ]] && from="$previous"
  fi
  [[ -n "$from" ]] || return 0
  taken="$(import_site_files "$from" | xargs)"
  if [[ -n "$taken" ]]; then
    ok "Took over from $from: $taken"
  fi
}

# Passwords and secrets of the cluster .env. Keycloak keeps its admin, database
# and client secrets from its first start, so those are generated only while
# its database is known to be pristine; when that cannot be told, the cluster
# still starts and `krate identity up` reports the reason. The secret
# PingFederate issued (PING_KEYCLOAK_CLIENT_SECRET) is asked for by
# `krate auth apply`.
generate_secrets() {
  local keys=(KAFKA_UI_PASSWORD) generated state
  state="$(identity_state)" || exit 1
  case "${state%% *}" in
    pristine) keys+=("${IDENTITY_KEYS[@]}") ;;
    existing) ;;
    *) warn "Identity secrets not generated: ${state#unknown }" ;;
  esac
  generated="$(fill_secrets "$ENV_FILE" 24 "${keys[@]}" | xargs)"
  if [[ -n "$generated" ]]; then
    ok "Generated $generated in .env"
  fi
}

# monitoring/.env: created from its template, image pins kept current, and its
# passwords and keys generated. Grafana keeps the admin password from its first
# start, so that one is generated only before Grafana's volume exists.
prepare_monitor_env() {
  local env_file="$MONITOR_DIR/.env" keys=(PERSES_ADMIN_PASSWORD) generated
  if [[ ! -f "$env_file" ]]; then
    cp "$MONITOR_DIR/.env.template" "$env_file"
    ok "Created monitoring/.env from its template"
  fi
  chmod 600 "$env_file"
  sync_image_pins "$env_file" "$MONITOR_DIR/.env.template"
  if ! compose_volume_exists "krate-${KRATE_VARIANT}-monitoring" grafana_data; then
    keys+=(GRAFANA_PASSWORD)
  else
    # Grafana keeps the password its volume was created with; .env cannot
    # change it, so say what is in use rather than generate a value in vain.
    case "$(env_value_file "$env_file" GRAFANA_PASSWORD)" in
      "") warn "GRAFANA_PASSWORD is empty but Grafana's volume exists: its stored password stays in use. Record it with: krate config set GRAFANA_PASSWORD=..." ;;
      changeme) warn "GRAFANA_PASSWORD is changeme (insecure) and Grafana's volume exists: change it in Grafana, then record it with: krate config set GRAFANA_PASSWORD=..." ;;
    esac
  fi
  generated="$({ fill_secrets "$env_file" 24 "${keys[@]}"
    fill_secrets "$env_file" 32 PERSES_ENCRYPTION_KEY OAUTH2_PROXY_COOKIE_SECRET; } | xargs)"
  if [[ -n "$generated" ]]; then
    ok "Generated $generated in monitoring/.env"
  fi
}

# GNU Make 4+ runs the build (macOS's make is 3.81; Homebrew installs gmake).
make_cmd() {
  local bin major
  for bin in gmake make; do
    command -v "$bin" >/dev/null 2>&1 || continue
    major="$("$bin" --version 2>/dev/null | sed -n '1s/^GNU Make \([0-9][0-9]*\)\..*/\1/p')"
    if [[ -n "$major" ]] && (( major >= 4 )); then
      echo "$bin"
      return 0
    fi
  done
  die "Building needs GNU Make 4.0 or newer (on macOS: brew install make)."
}

host_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) die "Unsupported processor: $(uname -m)" ;;
  esac
}

# ─── setup: the one preparation step ─────────────────────────────────────────
# Every command that creates containers (start, install, auth apply, monitor
# up) runs this first, so nothing is copied or edited by hand: both settings
# files, image pins, every generated password and secret, the TLS certificate
# and, in a source checkout, the Kafbat UI image. It only fills what is
# missing, and never changes a value the site set.
prepare() {
  require_compose; require_compose_file
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_TEMPLATE" ]] || die ".env.template not found in $SCRIPT_DIR"
    cp "$ENV_TEMPLATE" "$ENV_FILE"
    ok "Created .env from .env.template"
  fi
  chmod 600 "$ENV_FILE"
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  adopt_legacy_project
  generate_secrets
  if [[ -d "$MONITOR_DIR" ]]; then
    prepare_monitor_env
  fi
  ensure_cert
  ensure_ui_image
}

cmd_setup() {
  step "Krate setup"
  prepare
  ok "Ready. Start with: krate start   Logins: krate credentials"
}

# A source checkout runs the Kafbat UI image it builds itself; build it when
# the pinned one is not on this host. Packages ship the image instead.
ensure_ui_image() {
  local image
  image="$(env_value KAFKA_UI_IMAGE)"
  [[ "$image" == krate/kafka-ui:*@sha256:* ]] || return 0
  docker image inspect "${image##*@}" >/dev/null 2>&1 && return 0
  [[ -n "$REPO_DIR" ]] || die "Kafbat UI image $image is not on this host; install from a package that includes it."
  warn "Kafbat UI image $image is not on this host; building it."
  cmd_build
}

# Build the Kafbat UI image for this host from a source checkout.
cmd_build() {
  [[ -n "$REPO_DIR" ]] || die "krate build runs in a source checkout; a package already contains the image."
  require_docker
  local make
  make="$(make_cmd)"
  info "Building the Kafbat UI image (several minutes; needs Git, Node.js, npm and internet access)..."
  "$make" -C "$REPO_DIR" kafbat-ui ARCH="$(host_arch)"
  # The build pins the new image ID in .env.template; carry it into .env.
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  ok "Kafbat UI image built"
}

# Build this edition's offline install package from a source checkout: the
# Kafbat UI image, Docker OS packages for the target and every pinned image.
cmd_package() {
  [[ -n "$REPO_DIR" ]] || die "krate package runs in a source checkout."
  local version="${1:-}" arch="${2:-}" target_os="${3:-auto}" make
  [[ "$version" =~ ^v[0-9]+$ ]] || die "Usage: krate package <vN> [amd64|arm64] [auto|none|noble|jammy|rhel9]"
  [[ -n "$arch" ]] || arch="$(host_arch)"
  require_docker
  make="$(make_cmd)"
  MAKE="$make" "$REPO_DIR/scripts/package-release.sh" "$KRATE_VARIANT" "$version" "$arch" "$target_os"
  ok "Package written to $REPO_DIR/dist/release/package-${KRATE_VARIANT}-${version}/"
}

# Every login of this installation, in one place.
cmd_credentials() {
  cmd_ui
  if [[ -f "$MONITOR_DIR/.env" ]]; then
    echo -e "${BOLD}  Monitoring${RESET}"
    sep
    monitor_logins | sed 's/^/  /'
    sep
  fi
  if identity_profile_enabled; then
    echo -e "${BOLD}  Keycloak admin${RESET}"
    sep
    echo "  URL       $(env_value KEYCLOAK_PUBLIC_URL)/admin/"
    echo "  Username  $(env_value KEYCLOAK_ADMIN_USER)"
    echo "  Password  $(env_value KEYCLOAK_ADMIN_PASSWORD)"
    sep
  fi
  echo -e "  ${DIM}Stored in .env and monitoring/.env (mode 600). Change one with: krate config set KEY=VALUE${RESET}"
}

# A source checkout pins the locally built Kafbat UI image (make kafbat-ui) as
# krate/kafka-ui:...@<image ID>. That image has no registry digest, and Docker's
# classic image store resolves name@digest only against registry digests, so
# pass Compose the bare image ID. Packages use krate-offline tags instead.
resolve_local_ui_image() {
  local action="${1:-}" arg targeted=true
  local -a services=()
  # `up` of named services that leave out kafka-ui does not need its image.
  for arg in "${@:2}"; do
    [[ "$arg" == -* ]] || services+=("$arg")
  done
  if [[ "$action" == up && ${#services[@]} -gt 0 ]]; then
    targeted=false
    for arg in "${services[@]}"; do
      if [[ "$arg" == kafka-ui ]]; then targeted=true; fi
    done
  fi
  # A set KAFKA_UI_IMAGE, even an empty one, overrides .env for Compose.
  local image
  if [[ -n "${KAFKA_UI_IMAGE+set}" ]]; then
    image="$KAFKA_UI_IMAGE"
  else
    image="$(env_value KAFKA_UI_IMAGE)"
  fi
  [[ "$image" == krate/kafka-ui:*@sha256:* ]] || return 0
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  if docker image inspect "${image##*@}" >/dev/null 2>&1; then
    export KAFKA_UI_IMAGE="${image##*@}"
  elif [[ "$action" == up ]] && $targeted; then
    # Compose would try Docker Hub, where this locally built image never exists.
    die "Kafbat UI image $image is not built on this host. Build it from the repository root: make kafbat-ui"
  fi
}

# Wrapper so all compose calls use the right files and detected binary. The
# sso profile (Keycloak and its database) joins the cluster once identity is
# enabled or Kafbat is in runtime.yml mode.
compose_cmd() {
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  resolve_local_ui_image "$@"
  if [[ -f "$ENV_FILE" ]] && identity_profile_enabled; then
    require_sso_compose
    if [[ "${1:-}" == up ]]; then
      # Compose bind-mounts these as files; were they missing, Docker would
      # create root-owned directories in their place.
      local f
      for f in auth/keycloak/krate-realm.json auth/keycloak/db-tls/ca.crt; do
        [[ -f "$SCRIPT_DIR/$f" ]] || die "$f is missing. Run: krate identity up"
      done
      if [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "runtime.yml" ]]; then
        "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" --profile sso config --format json | python3 "$(sso_dir)/preflight.py" --directory "$SCRIPT_DIR" --mode runtime.yml
        shift
        set -- up --pull never --no-build "$@"
      fi
    fi
    set -- --profile sso "$@"
  fi
  "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

# The one secret that cannot be generated: PingFederate issues it for Keycloak.
# Ask for it when SSO is applied interactively; otherwise say how to set it.
ensure_ping_secret() {
  local secret
  case "$(env_value PING_KEYCLOAK_CLIENT_SECRET)" in
    ""|REPLACE_ME) ;;
    *) return 0 ;;
  esac
  [[ -t 0 ]] || die "Set the client secret PingFederate issued for Keycloak: krate config set PING_KEYCLOAK_CLIENT_SECRET=..."
  read -rsp "  Client secret PingFederate issued for Keycloak: " secret
  echo ""
  [[ -n "$secret" ]] || die "No secret entered."
  set_env_file_value "$ENV_FILE" PING_KEYCLOAK_CLIENT_SECRET "$secret"
  ok "Saved PING_KEYCLOAK_CLIENT_SECRET in .env"
}

cmd_auth() {
  local action="${1:-}" sso_dir="$SCRIPT_DIR/sso"
  [[ -d "$sso_dir" ]] || sso_dir="$SCRIPT_DIR/../sso"
  case "$action" in
    configure)
      [[ $# -eq 2 ]] || die "Usage: krate auth configure <settings.json>"
      python3 "$sso_dir/configure-dual.py" --settings "$2" --output-dir "$SCRIPT_DIR/auth"
      mkdir -p "$SCRIPT_DIR/auth/keycloak/truststores"
      # Derive the .env values that follow from public_url instead of asking for them.
      require_env
      local public_url
      public_url="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["public_url"].rstrip("/"))' "$2")"
      set_env_file_value "$ENV_FILE" KEYCLOAK_PUBLIC_URL "$public_url/identity"
      ok "Set KEYCLOAK_PUBLIC_URL=$public_url/identity in .env"
      if [[ -z "$(env_value KAFKA_UI_FQDN)" ]]; then
        local host="${public_url#*://}"
        host="${host%%[:/]*}"
        set_env_file_value "$ENV_FILE" KAFKA_UI_FQDN "$host"
        ok "Set KAFKA_UI_FQDN=$host in .env"
      fi
      local fqdn
      fqdn="$(get_fqdn)"
      if [[ -f "$CERT_CRT" ]] && ! openssl x509 -in "$CERT_CRT" -noout -checkhost "$fqdn" 2>/dev/null | grep -q 'does match'; then
        warn "certs/server.crt does not cover $fqdn. Install the CA-issued certificate and key in certs/, or run: krate gen-cert"
      fi
      ;;
    apply)
      [[ -f "$sso_dir/activate.sh" ]] || die "Missing packaged SSO activation helper"
      prepare
      ensure_ping_secret
      # shellcheck disable=SC1091
      source "$sso_dir/activate.sh"
      apply_auth "$sso_dir"
      ;;
    *) die "Usage: krate auth {configure <settings.json>|apply}" ;;
  esac
}

# ─── identity (Keycloak and its database) ─────────────────────────────────────
# Keycloak holds the site's users and runs under the sso Compose profile beside
# the brokers, but is managed on its own: these commands need no broker. The
# database volume keycloak_db_data is the authoritative store; .env carries the
# credentials Keycloak and its database were initialised with, so the identity
# secrets are generated only before that database exists and changed later
# through `krate identity rotate`, which updates both sides.
IDENTITY_KEYS=(KEYCLOAK_ADMIN_PASSWORD KEYCLOAK_DB_PASSWORD KEYCLOAK_KAFBAT_CLIENT_SECRET KEYCLOAK_CLI_CLIENT_SECRET)
IDENTITY_REALM=krate
IDENTITY_TIMEOUT=180
IDENTITY_LOCK=""
IDENTITY_CHANGED=false
KCADM_SERVER=http://localhost:8080/identity
KCADM_CID=""
KCADM_CONFIG=""

# The SSO helpers sit beside the CLI in a package and at the root of a checkout.
sso_dir() {
  local dir="$SCRIPT_DIR/sso"
  [[ -d "$dir" ]] || dir="$SCRIPT_DIR/../sso"
  echo "$dir"
}

require_sso_compose() {
  local version
  version="$(get_compose_version)"
  version_gte "$version" "2.20.2" || die "SSO requires Docker Compose 2.20.2 or newer; found $version. Install the packaged Compose plugin."
}

# The sso profile is part of the cluster once identity is enabled, or while
# Kafbat is in runtime.yml mode (its SSO login needs Keycloak).
identity_profile_enabled() {
  [[ "$(env_value KEYCLOAK_ENABLED)" == true || "$(env_value KAFKA_UI_AUTH_CONFIG)" == runtime.yml ]]
}

# Compose with the sso profile always on, so the identity services can be
# addressed before KEYCLOAK_ENABLED is set (identity up sets it last).
identity_compose() {
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  resolve_local_ui_image
  "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" --profile sso "$@"
}

# Container ID of an identity service (running or not); empty when none.
identity_container() {
  identity_compose ps -a -q "$1" 2>/dev/null | head -1 || true
}

# Docker state of a container ID: running, exited, ... or absent.
container_status() {
  [[ -n "$1" ]] || { echo absent; return 0; }
  docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null || echo absent
}

# Health of a container ID (its state when it has no healthcheck), or absent.
container_health() {
  [[ -n "$1" ]] || { echo absent; return 0; }
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || echo absent
}

# Die unless the packaged image of every given service is loaded.
require_service_images() {
  local listing service image
  listing="$(identity_compose config --format json | python3 -c '
import json, sys
services = json.load(sys.stdin)["services"]
for name in sys.argv[1:]:
    print(name, services[name]["image"])' "$@")" || die "Cannot read the images of: $*"
  while read -r service image; do
    [[ -n "$service" ]] || continue
    docker image inspect "$image" >/dev/null 2>&1 \
      || die "Packaged image for $service is missing; run krate load-images first (in a checkout: docker pull $image)"
  done <<< "$listing"
}

# Whether Keycloak's database exists. Prints one line: pristine (no database;
# the first start imports the realm and creates the bootstrap admin), existing,
# or "unknown <reason>" when Docker could not be asked or a keycloak_db_data
# volume of another Compose project might be the one in use. A missing volume
# name alone is never taken as "empty".
identity_state() {
  local project projects other container
  adopt_legacy_project >&2
  project="$(cluster_project)"
  if ! projects="$(docker volume ls --filter label=com.docker.compose.volume=keycloak_db_data \
      --format '{{.Label "com.docker.compose.project"}}' | LC_ALL=C sort -u)"; then
    echo "unknown docker volume ls failed; is the Docker daemon running?"
    return 0
  fi
  other="$(printf '%s\n' "$projects" | grep -v '^$' | grep -vx "$project" | xargs || true)"
  if [[ -n "$other" ]]; then
    echo "unknown a keycloak_db_data volume also exists in Compose project(s) $other while this installation is $project; use it with krate config set KRATE_PROJECT=<name>, or remove it"
    return 0
  fi
  container="$(docker ps -aq --filter "label=com.docker.compose.project=$project" \
    --filter "label=com.docker.compose.service=keycloak-db" 2>/dev/null | head -1 || true)"
  if printf '%s\n' "$projects" | grep -qx "$project" || [[ -n "$container" ]]; then
    echo existing
  else
    echo pristine
  fi
}

# One identity command at a time: a directory lock (mkdir is atomic on every
# platform; macOS has no flock). A lock whose process is gone is stale.
identity_lock() {
  local dir="$SCRIPT_DIR/auth/.identity.lock" pid
  mkdir -p "$SCRIPT_DIR/auth"
  if ! mkdir "$dir" 2>/dev/null; then
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      die "Another krate identity command is running (pid $pid). Wait for it to finish."
    fi
    warn "Removing the stale identity lock left by process ${pid:-?}"
    rm -rf "$dir"
    mkdir "$dir" 2>/dev/null || die "Cannot create the lock $dir"
  fi
  echo "$$" > "$dir/pid"
  IDENTITY_LOCK="$dir"
  trap identity_cleanup EXIT
}

identity_cleanup() {
  kcadm_logout
  if [[ -n "$IDENTITY_LOCK" ]]; then
    rm -rf "$IDENTITY_LOCK"
    IDENTITY_LOCK=""
  fi
}

# Append-only record of identity operations: `<time> <command> <outcome>
# <detail>`. Details name keys, users and files, never a secret value.
identity_journal() {
  local file="$SCRIPT_DIR/auth/identity-journal.log"
  mkdir -p "$SCRIPT_DIR/auth"
  printf '%s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "${3:-}" >> "$file"
}

# kcadm runs inside the Keycloak container against its own HTTP listener. The
# session file gets a random name under the container's /tmp and is removed by
# kcadm_logout (also from the exit trap). Passwords and secrets reach kcadm as
# environment variables of the exec (KC_CLI_PASSWORD, KC_CLI_CLIENT_SECRET),
# named on the docker command line but never given as arguments.
#
# kcadm [VAR=VALUE ...] -- <kcadm command> [arguments]
kcadm() {
  local -a names=() exec_opts=()
  local rc=0
  while [[ $# -gt 0 && "$1" != -- ]]; do
    # shellcheck disable=SC2163  # the NAME=VALUE pair is the argument itself
    export "$1"
    names+=("${1%%=*}")
    exec_opts+=(-e "${1%%=*}")
    shift
  done
  if [[ "${1:-}" == -- ]]; then shift; fi
  if [[ "${KCADM_STDIN:-}" == 1 ]]; then
    docker exec -i "${exec_opts[@]}" "$KCADM_CID" /opt/keycloak/bin/kcadm.sh "$@" --config "$KCADM_CONFIG" || rc=$?
  else
    docker exec "${exec_opts[@]}" "$KCADM_CID" /opt/keycloak/bin/kcadm.sh "$@" --config "$KCADM_CONFIG" </dev/null || rc=$?
  fi
  if [[ ${#names[@]} -gt 0 ]]; then unset "${names[@]}"; fi
  return "$rc"
}

# kcadm_login <realm> user <username> <password>
# kcadm_login <realm> client <client-id> <secret>      (client credentials)
# Returns kcadm's status; the caller decides whether a refusal is fatal.
kcadm_login() {
  local realm="$1" kind="$2" name="$3" secret="$4" cid
  kcadm_logout
  cid="$(identity_container keycloak)"
  [[ -n "$cid" && "$(container_status "$cid")" == running ]] || die "Keycloak is not running. Run: krate identity up"
  KCADM_CID="$cid"
  KCADM_CONFIG="/tmp/kcadm-$(random_secret 16).config"
  trap identity_cleanup EXIT
  case "$kind" in
    # kcadm announces each login on stdout; errors still reach stderr.
    user)   kcadm "KC_CLI_PASSWORD=$secret" -- config credentials --server "$KCADM_SERVER" --realm "$realm" --user "$name" >/dev/null ;;
    client) kcadm "KC_CLI_CLIENT_SECRET=$secret" -- config credentials --server "$KCADM_SERVER" --realm "$realm" --client "$name" >/dev/null ;;
    *) die "kcadm_login: unknown kind $kind" ;;
  esac
}

kcadm_logout() {
  [[ -n "$KCADM_CONFIG" ]] || return 0
  docker exec "$KCADM_CID" rm -f "$KCADM_CONFIG" >/dev/null 2>&1 || true
  KCADM_CONFIG=""
  KCADM_CID=""
}

# IDs by exact name; empty when not found (a kcadm failure is fatal).
kcadm_user_id() {
  kcadm -- get users -r "$1" -q "username=$2" -q exact=true --fields id --format csv --noquotes | awk 'NF { print; exit }'
}

kcadm_group_id() {
  kcadm -- get groups -r "$1" -q "search=$2" -q exact=true --fields id,name --format csv --noquotes \
    | awk -F, -v g="$2" '$2 == g { print $1; exit } $1 == g { print $2; exit }'
}

kcadm_client_id() {
  kcadm -- get clients -r "$1" -q "clientId=$2" --fields id,clientId --format csv --noquotes \
    | awk -F, -v c="$2" '$2 == c { print $1; exit } $1 == c { print $2; exit }'
}

# Log in as the permanent master admin from .env; a refusal is fatal with the
# recovery options ($1 names the command for the journal).
identity_verify_admin() {
  local admin
  admin="$(env_value KEYCLOAK_ADMIN_USER)"
  if ! kcadm_login master user "$admin" "$(env_value KEYCLOAK_ADMIN_PASSWORD)"; then
    identity_journal "$1" failed "admin login as $admin refused"
    die "Keycloak refused the admin login for $admin with KEYCLOAK_ADMIN_PASSWORD from .env.
Restore a backup (krate identity restore <file>), or recover the admin as described in
sso/guides/identity-foundation.md (bootstrap-admin-recovery), then re-run: krate identity up"
  fi
  kcadm_logout
  ok "Admin login as $admin verified"
}

# Log in as the krate-cli service account in the krate realm (what user
# management uses); a refusal is fatal.
identity_verify_cli() {
  if ! kcadm_login "$IDENTITY_REALM" client krate-cli "$(env_value KEYCLOAK_CLI_CLIENT_SECRET)"; then
    identity_journal "$1" failed "client login krate-cli refused"
    die "Keycloak refused the krate-cli client login with KEYCLOAK_CLI_CLIENT_SECRET from .env.
If the secret was changed in Keycloak, put it back in step: krate identity rotate KEYCLOAK_CLI_CLIENT_SECRET
Otherwise restore a backup: krate identity restore <file>"
  fi
  kcadm_logout
  ok "krate-cli client login verified (realm $IDENTITY_REALM)"
}

# Turn the one-time bootstrap admin into the permanent one: create
# KEYCLOAK_ADMIN_USER in the master realm with the realm role admin, verify its
# login, then delete temp-admin ($1 is the bootstrap password).
identity_bootstrap_admin() {
  local admin admin_pw tries=0 uid
  admin="$(env_value KEYCLOAK_ADMIN_USER)"
  admin_pw="$(env_value KEYCLOAK_ADMIN_PASSWORD)"
  info "Creating the permanent Keycloak admin $admin from the temporary bootstrap admin..."
  until kcadm_login master user temp-admin "$1" 2>/dev/null; do
    tries=$((tries + 1))
    (( tries < 10 )) || die "Could not log in as the bootstrap admin after $tries attempts. Check: krate logs keycloak"
    sleep 3
  done
  if [[ -z "$(kcadm_user_id master "$admin")" ]]; then
    kcadm -- create users -r master -s "username=$admin" -s enabled=true >/dev/null
  fi
  kcadm "KC_CLI_PASSWORD=$admin_pw" -- set-password -r master --username "$admin"
  kcadm -- add-roles -r master --uusername "$admin" --rolename admin
  kcadm_login master user "$admin" "$admin_pw" || die "The permanent admin $admin cannot log in; the bootstrap admin was kept. Check: krate logs keycloak"
  uid="$(kcadm_user_id master temp-admin)"
  if [[ -n "$uid" ]]; then
    kcadm -- delete "users/$uid" -r master
  fi
  kcadm_logout
  ok "Permanent admin $admin created; temporary bootstrap admin removed"
}

# Site files Keycloak needs: identity secrets in .env (generated only for a
# pristine database), the database TLS material and the realm plan (both made
# once and kept). $1 = identity state.
prepare_identity() {
  local sso state="$1" generated key missing=""
  sso="$(sso_dir)"
  if [[ "$state" == pristine ]]; then
    generated="$(fill_secrets "$ENV_FILE" 24 "${IDENTITY_KEYS[@]}" | xargs)"
    if [[ -n "$generated" ]]; then
      ok "Generated $generated in .env"
      IDENTITY_CHANGED=true
    fi
  else
    for key in "${IDENTITY_KEYS[@]}"; do
      case "$(env_value "$key")" in ""|REPLACE_ME) missing+=" $key" ;; esac
    done
    [[ -z "$missing" ]] || die "The identity database exists but .env lacks${missing}.
Restore the .env of this installation, or restore a backup: krate identity restore <file>"
  fi
  mkdir -p "$SCRIPT_DIR/auth/keycloak/truststores"
  if [[ ! -f "$SCRIPT_DIR/auth/keycloak/db-tls/ca.crt" ]]; then IDENTITY_CHANGED=true; fi
  python3 "$sso/identity.py" db-tls --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" \
    || { identity_journal up refused "database TLS material incomplete or unwritable"; exit 1; }
  if [[ ! -f "$SCRIPT_DIR/auth/keycloak/krate-realm.json" ]]; then
    python3 "$sso/identity.py" plan --env-file "$ENV_FILE" --output "$SCRIPT_DIR/auth/keycloak/krate-realm.json" \
      || { identity_journal up refused "realm plan not generated"; exit 1; }
    IDENTITY_CHANGED=true
  fi
}

# .env ready for the identity services, without the rest of prepare (no
# certificate or UI image is needed to run Keycloak).
prepare_identity_env() {
  require_compose; require_compose_file; require_sso_compose
  command -v python3 >/dev/null || die "python3 is required for krate identity"
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_TEMPLATE" ]] || die ".env.template not found in $SCRIPT_DIR"
    cp "$ENV_TEMPLATE" "$ENV_FILE"
    ok "Created .env from .env.template"
  fi
  chmod 600 "$ENV_FILE"
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
}

identity_up_service() {
  identity_compose up -d --pull never --no-build --no-deps --wait --wait-timeout "$IDENTITY_TIMEOUT" "$@" \
    || { identity_journal start failed "$* not healthy within ${IDENTITY_TIMEOUT}s"
         die "$* did not become healthy within ${IDENTITY_TIMEOUT}s. Nothing was changed in .env. Check: krate logs $*"; }
}

cmd_identity_up() {
  prepare_identity_env
  identity_lock
  local state reason bootstrap_pw="" db kc
  state="$(identity_state)" || exit 1
  reason="${state#unknown }"
  state="${state%% *}"
  if [[ "$state" == unknown ]]; then
    identity_journal up refused "$reason"
    die "Cannot tell whether an identity database exists: $reason"
  fi
  if [[ "$state" == pristine && "$(env_value KEYCLOAK_ADMIN_USER)" == temp-admin ]]; then
    die "KEYCLOAK_ADMIN_USER must not be temp-admin (the temporary bootstrap admin). Set another name: krate config set KEYCLOAK_ADMIN_USER=admin"
  fi
  prepare_identity "$state"
  # Render into the validator's stdin: credentials never reach terminal output.
  identity_compose config --format json | python3 "$(sso_dir)/preflight.py" --directory "$SCRIPT_DIR" --mode identity \
    || { identity_journal up refused "preflight failed"; die "Identity preflight failed (see above)."; }
  require_service_images keycloak-db keycloak

  db="$(identity_container keycloak-db)"
  kc="$(identity_container keycloak)"
  if [[ "$(container_health "$db")" != healthy || "$(container_health "$kc")" != healthy ]]; then
    IDENTITY_CHANGED=true
  fi
  info "Starting the identity database..."
  identity_up_service keycloak-db
  if [[ "$state" == pristine ]]; then
    # Keycloak's own command creates the master realm and a temporary admin
    # before the first start (all nodes stopped, as its guide requires). The
    # password travels in an exported variable, never in an argument, and the
    # account is deleted once the permanent admin can log in.
    info "Creating the master realm and its temporary bootstrap admin..."
    bootstrap_pw="$(random_secret 24)"
    local bootstrap_log
    if ! bootstrap_log="$(KRATE_BOOTSTRAP_PASSWORD="$bootstrap_pw" identity_compose run --rm --no-deps -T -e KRATE_BOOTSTRAP_PASSWORD keycloak \
        bootstrap-admin user --username temp-admin --password:env KRATE_BOOTSTRAP_PASSWORD --no-prompt 2>&1)"; then
      printf '%s\n' "$bootstrap_log" >&2
      identity_journal up failed "bootstrap-admin user failed"
      die "Keycloak could not create its master realm and bootstrap admin (output above). Check: krate logs keycloak-db"
    fi
    printf '%s\n' "$bootstrap_log" | grep -E 'KC-SERVICES0077|temporary admin' | sed 's/^/  /' || true
  fi
  info "Starting Keycloak..."
  identity_up_service keycloak

  if [[ "$state" == pristine ]]; then
    identity_bootstrap_admin "$bootstrap_pw"
    identity_journal up bootstrapped "database initialised; permanent admin $(env_value KEYCLOAK_ADMIN_USER) created; temp-admin removed"
  else
    identity_verify_admin up
  fi
  identity_verify_cli up
  if [[ "$(env_value KEYCLOAK_ENABLED)" != true ]]; then
    set_env_file_value "$ENV_FILE" KEYCLOAK_ENABLED true
    ok "Set KEYCLOAK_ENABLED=true in .env (Keycloak now starts and stops with the cluster)"
    IDENTITY_CHANGED=true
  fi
  if $IDENTITY_CHANGED; then
    identity_journal up ok "state=$state"
  else
    identity_journal up no-change ""
    ok "No changes"
  fi
  echo ""
  cmd_identity_status
}

# Probe Keycloak from inside its container (it has bash, no curl): the
# management port 9000 is never published, and 8080 only through the proxy.
keycloak_http_probe() {
  docker exec "$1" bash -ec "{ printf 'GET $3 HTTP/1.0\r\nHost: localhost\r\n\r\n' >&0; grep -q 'HTTP/1.0 200'; } 0<>/dev/tcp/127.0.0.1/$2" >/dev/null 2>&1
}

# One line per probe; exit 1 unless the database is healthy, Keycloak is
# ready and live, and the realm answers.
cmd_identity_status() {
  require_compose; require_compose_file; require_env
  local db kc ready=true health started=no live=no kc_ready=no realm=absent probe
  db="$(identity_container keycloak-db)"
  kc="$(identity_container keycloak)"
  health="$(container_health "$db")"
  [[ "$health" == healthy ]] || ready=false
  printf "  %-22s %s\n" "keycloak-db" "$health"
  if [[ "$(container_status "$kc")" == running ]]; then
    for probe in started ready live; do
      if keycloak_http_probe "$kc" 9000 "/health/$probe"; then
        case "$probe" in started) started=yes ;; ready) kc_ready=yes ;; live) live=yes ;; esac
      fi
    done
    if keycloak_http_probe "$kc" 8080 "/identity/realms/$IDENTITY_REALM"; then realm=present; fi
    printf "  %-22s started %s, ready %s, live %s\n" "keycloak" "$started" "$kc_ready" "$live"
  else
    printf "  %-22s %s\n" "keycloak" "$(container_status "$kc")"
  fi
  [[ "$kc_ready" == yes && "$live" == yes ]] || ready=false
  printf "  %-22s %s\n" "realm $IDENTITY_REALM" "$realm"
  [[ "$realm" == present ]] || ready=false
  printf "  %-22s %s\n" "KEYCLOAK_ENABLED" "$(env_value KEYCLOAK_ENABLED)"
  if [[ -f "$SCRIPT_DIR/auth/identity-journal.log" ]]; then
    echo "  journal (last 5):"
    tail -n 5 "$SCRIPT_DIR/auth/identity-journal.log" | sed 's/^/    /'
  fi
  if $ready; then
    ok "Identity is ready"
  else
    warn "Identity is not ready. Run: krate identity up   Logs: krate logs keycloak"
    return 1
  fi
}

# True when Keycloak serves the realm (the status probes, quietly).
identity_ready() {
  cmd_identity_status >/dev/null 2>&1
}

cmd_identity_down() {
  require_compose; require_compose_file; require_env
  identity_lock
  info "Stopping Keycloak and its database (data kept)..."
  identity_compose stop keycloak keycloak-db
  identity_journal down ok "keycloak and keycloak-db stopped; volume kept"
  ok "Stopped. Start again with: krate identity up"
}

# Usernames are stored lower-case by Keycloak; keep the set simple.
identity_username() {
  local u="${1,,}"
  [[ "$u" =~ ^[a-z0-9][a-z0-9._@-]{0,62}$ ]] || die "Invalid username '$1' (letters, digits, . _ @ -)"
  echo "$u"
}

identity_users_usage() {
  die "Usage: krate identity users list
       krate identity users add <username> [--admin|--viewer] [--email <address>]
       krate identity users {enable|disable|reset-password|groups} <username>"
}

# A user's temporary password: generated, shown once, must be changed at the
# first login (UPDATE_PASSWORD) which also enrols the authenticator (CONFIGURE_TOTP).
identity_set_temp_password() {
  local user="$1" uid="$2" temp
  temp="$(random_secret 16)"
  kcadm "KC_CLI_PASSWORD=$temp" -- set-password -r "$IDENTITY_REALM" --username "$user" --temporary
  kcadm -- update "users/$uid" -r "$IDENTITY_REALM" -s 'requiredActions=["UPDATE_PASSWORD","CONFIGURE_TOTP"]'
  echo ""
  echo "  Temporary password for $user (shown once; a new one is required at first login):"
  echo "  $temp"
  echo ""
}

cmd_identity_users() {
  local action="${1:-}" user="" group="" email="" uid gid
  shift || true
  case "$action" in
    list) ;;
    add)
      user="$(identity_username "${1:-}")"; shift || identity_users_usage
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --admin)  group="$(env_value KEYCLOAK_ADMIN_GROUP)"; group="${group:-KRATE_ADMINS}"; shift ;;
          --viewer) group="$(env_value KEYCLOAK_VIEWER_GROUP)"; group="${group:-KRATE_VIEWERS}"; shift ;;
          --email)
            email="${2:-}"
            [[ "$email" == *@* && "$email" != *[[:space:]]* ]] || die "--email needs an address"
            shift 2 ;;
          *) identity_users_usage ;;
        esac
      done
      ;;
    enable|disable|reset-password|groups)
      [[ $# -eq 1 ]] || identity_users_usage
      user="$(identity_username "$1")"
      ;;
    *) identity_users_usage ;;
  esac
  require_compose; require_compose_file; require_env
  [[ "$action" == list || "$action" == groups ]] || identity_lock
  kcadm_login "$IDENTITY_REALM" client krate-cli "$(env_value KEYCLOAK_CLI_CLIENT_SECRET)" \
    || die "Keycloak refused the krate-cli client login. Check: krate identity status"
  if [[ -n "$user" && "$action" != add ]]; then
    uid="$(kcadm_user_id "$IDENTITY_REALM" "$user")"
    [[ -n "$uid" ]] || die "No user $user in realm $IDENTITY_REALM"
  fi
  case "$action" in
    list)
      printf "  %-32s %-8s %s\n" USERNAME ENABLED EMAIL
      kcadm -- get users -r "$IDENTITY_REALM" --offset 0 --limit 1000 --fields username,enabled,email --format csv --noquotes \
        | awk -F, '{ printf "  %-32s %-8s %s\n", $1, $2, $3 }'
      ;;
    add)
      [[ -z "$(kcadm_user_id "$IDENTITY_REALM" "$user")" ]] || die "User $user already exists"
      if [[ -n "$email" ]]; then
        kcadm -- create users -r "$IDENTITY_REALM" -s "username=$user" -s enabled=true -s "email=$email" >/dev/null
      else
        kcadm -- create users -r "$IDENTITY_REALM" -s "username=$user" -s enabled=true >/dev/null
      fi
      uid="$(kcadm_user_id "$IDENTITY_REALM" "$user")"
      [[ -n "$uid" ]] || die "User $user was not created"
      if [[ -n "$group" ]]; then
        gid="$(kcadm_group_id "$IDENTITY_REALM" "$group")"
        [[ -n "$gid" ]] || die "Group $group does not exist in realm $IDENTITY_REALM"
        kcadm -- update "users/$uid/groups/$gid" -r "$IDENTITY_REALM" -s "realm=$IDENTITY_REALM" -s "userId=$uid" -s "groupId=$gid" -n
      fi
      identity_set_temp_password "$user" "$uid"
      identity_journal "users add" ok "$user${group:+ group=$group}"
      ok "User $user created${group:+ in group $group}"
      ;;
    enable|disable)
      local enabled=true
      [[ "$action" == enable ]] || enabled=false
      kcadm -- update "users/$uid" -r "$IDENTITY_REALM" -s "enabled=$enabled"
      identity_journal "users $action" ok "$user"
      ok "User $user ${action}d"
      ;;
    reset-password)
      identity_set_temp_password "$user" "$uid"
      identity_journal "users reset-password" ok "$user"
      ok "Temporary password set for $user"
      ;;
    groups)
      kcadm -- get "users/$uid/groups" -r "$IDENTITY_REALM" --fields name --format csv --noquotes | sed 's/^/  /'
      ;;
  esac
  kcadm_logout
}

# Change a Keycloak credential in its authoritative store first, then in .env,
# then recreate the consumer and verify. A value is generated unless --value
# reads one from stdin (never from an argument).
cmd_identity_rotate() {
  local key="${1:-}" value state client cid id json
  case "$key" in
    KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET) ;;
    *) die "Usage: krate identity rotate {KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET} [--value]" ;;
  esac
  [[ $# -eq 1 || "${2:-}" == --value ]] || die "Usage: krate identity rotate <KEY> [--value]   (--value reads the new value from stdin)"
  prepare_identity_env; require_env
  identity_lock
  state="$(identity_state)" || exit 1
  [[ "${state%% *}" == existing ]] || die "Nothing to rotate: no identity database (state: $state). Run: krate identity up"
  if [[ "${2:-}" == --value ]]; then
    if [[ -t 0 ]]; then
      read -rsp "  New value for $key: " value; echo ""
    else
      IFS= read -r value || true
    fi
    [[ ${#value} -ge 16 ]] || die "$key must be at least 16 characters"
  else
    value="$(random_secret 24)"
  fi
  case "$key" in
    KEYCLOAK_DB_PASSWORD)
      cid="$(identity_container keycloak-db)"
      [[ "$(container_health "$cid")" == healthy ]] || die "keycloak-db is not healthy. Run: krate identity up"
      # Over the container's local socket (pg_hba: trust); the statement goes
      # through stdin. Quotes in a given value are doubled for SQL.
      printf "ALTER ROLE keycloak WITH PASSWORD '%s';\n" "${value//\'/\'\'}" \
        | docker exec -i "$cid" psql -q -v ON_ERROR_STOP=1 -U keycloak -d keycloak >/dev/null \
        || { identity_journal rotate failed "$key: ALTER ROLE refused"; die "PostgreSQL refused the new password."; }
      set_env_file_value "$ENV_FILE" "$key" "$value"
      info "Recreating Keycloak with the new database password..."
      identity_compose up -d --pull never --no-build --no-deps --force-recreate --wait --wait-timeout "$IDENTITY_TIMEOUT" keycloak
      identity_verify_admin rotate
      ;;
    KEYCLOAK_ADMIN_PASSWORD)
      identity_verify_admin rotate >/dev/null
      kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
      kcadm "KC_CLI_PASSWORD=$value" -- set-password -r master --username "$(env_value KEYCLOAK_ADMIN_USER)"
      kcadm_logout
      set_env_file_value "$ENV_FILE" "$key" "$value"
      identity_verify_admin rotate
      ;;
    KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET)
      client=krate-cli
      [[ "$key" == KEYCLOAK_CLI_CLIENT_SECRET ]] || client=krate-ui
      identity_verify_admin rotate >/dev/null
      kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
      id="$(kcadm_client_id "$IDENTITY_REALM" "$client")"
      [[ -n "$id" ]] || die "Client $client not found in realm $IDENTITY_REALM"
      # The body goes through stdin (-f -), merged into the client.
      json="${value//\\/\\\\}"; json="${json//\"/\\\"}"
      printf '{"secret":"%s"}\n' "$json" | KCADM_STDIN=1 kcadm -- update "clients/$id" -r "$IDENTITY_REALM" -f - -m
      kcadm_logout
      set_env_file_value "$ENV_FILE" "$key" "$value"
      if [[ "$client" == krate-cli ]]; then
        identity_verify_cli rotate
      elif [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == runtime.yml ]]; then
        info "Recreating Kafbat UI with the new client secret..."
        compose_cmd up -d --pull never --no-build --no-deps --force-recreate --wait --wait-timeout "$IDENTITY_TIMEOUT" kafka-ui
      fi
      ;;
  esac
  identity_journal rotate ok "$key"
  ok "$key rotated in Keycloak and .env"
}

# The backup passphrase: KRATE_BACKUP_PASSPHRASE, or asked on a terminal
# (twice when $1 is confirm). Exported for openssl's -pass env:.
identity_passphrase() {
  local p1 p2
  if [[ -n "${KRATE_BACKUP_PASSPHRASE:-}" ]]; then
    export KRATE_BACKUP_PASSPHRASE
    return 0
  fi
  [[ -t 0 ]] || die "Set KRATE_BACKUP_PASSPHRASE in the environment, or run on a terminal to be asked for it."
  read -rsp "  Backup passphrase: " p1; echo ""
  if [[ "${1:-}" == confirm ]]; then
    read -rsp "  Repeat the passphrase: " p2; echo ""
    [[ "$p1" == "$p2" ]] || die "The passphrases differ."
  fi
  [[ ${#p1} -ge 8 ]] || die "The passphrase must be at least 8 characters."
  export KRATE_BACKUP_PASSPHRASE="$p1"
}

cmd_identity_backup() {
  local file="${1:-}" cid tmp
  [[ -n "$file" ]] || die "Usage: krate identity backup <file>"
  [[ ! -e "$file" ]] || die "$file exists; choose another name."
  require_compose; require_compose_file; require_env
  identity_lock
  cid="$(identity_container keycloak-db)"
  [[ "$(container_health "$cid")" == healthy ]] || die "keycloak-db is not running. Run: krate identity up"
  identity_passphrase confirm
  tmp="$(mktemp "$(dirname "$file")/.identity-backup.XXXXXX")" || die "Cannot write beside $file"
  chmod 600 "$tmp"
  info "Dumping and encrypting the identity database..."
  if ! docker exec "$cid" pg_dump -Fc -U keycloak keycloak \
      | openssl enc -aes-256-cbc -pbkdf2 -salt -pass env:KRATE_BACKUP_PASSPHRASE -out "$tmp"; then
    rm -f "$tmp"
    identity_journal backup failed "$file"
    die "Backup failed."
  fi
  mv -f "$tmp" "$file"
  identity_journal backup ok "$file $(wc -c < "$file" | xargs) bytes"
  ok "Encrypted backup written to $file (mode 600). Keep the passphrase: krate identity restore $file needs it."
}

cmd_identity_restore() {
  local file="${1:-}" cid kc
  [[ -f "$file" ]] || die "Usage: krate identity restore <file>"
  prepare_identity_env; require_env
  identity_lock
  kc="$(identity_container keycloak)"
  [[ "$(container_status "$kc")" != running ]] || die "Keycloak is running; stop it first: krate identity down"
  cid="$(identity_container keycloak-db)"
  if [[ "$(container_health "$cid")" != healthy ]]; then
    require_service_images keycloak-db
    identity_up_service keycloak-db
    cid="$(identity_container keycloak-db)"
  fi
  identity_passphrase
  info "Restoring the identity database from $file..."
  if ! openssl enc -d -aes-256-cbc -pbkdf2 -pass env:KRATE_BACKUP_PASSPHRASE -in "$file" \
      | docker exec -i "$cid" pg_restore --clean --if-exists -U keycloak -d keycloak; then
    identity_journal restore failed "$file"
    die "Restore failed: wrong passphrase, or pg_restore reported errors above."
  fi
  identity_journal restore ok "$file"
  require_service_images keycloak
  info "Starting Keycloak..."
  identity_up_service keycloak
  identity_verify_admin restore
  ok "Identity database restored from $file"
}

cmd_identity() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    up)      cmd_identity_up ;;
    status)  cmd_identity_status ;;
    down)    cmd_identity_down ;;
    users)   cmd_identity_users "$@" ;;
    rotate)  cmd_identity_rotate "$@" ;;
    backup)  cmd_identity_backup "$@" ;;
    restore) cmd_identity_restore "$@" ;;
    *)
      echo "Usage: krate identity {up|status|down|users ...|rotate KEY [--value]|backup FILE|restore FILE}"
      return 1 ;;
  esac
}

# Returns the name of the first running broker container
find_broker() {
  local services=("kafka-92" "kafka-93" "kafka-94" "kafka-95")
  for svc in "${services[@]}"; do
    local cid
    cid=$(compose_cmd ps -q "$svc" 2>/dev/null || true)
    if [[ -n "$cid" ]]; then
      local status
      status=$(docker inspect --format='{{.State.Status}}' "$cid" 2>/dev/null || echo "")
      if [[ "$status" == "running" ]]; then
        docker inspect --format='{{.Name}}' "$cid" | sed 's|^/||'
        return 0
      fi
    fi
  done
  die "No running broker found. Run: krate start"
}

BOOTSTRAP="kafka-92:9092,kafka-93:9093,kafka-94:9094,kafka-95:9095"

# ─── Preflight helpers ────────────────────────────────────────────────────────
# Resolve a single env var from .env, echoing its value (empty if unset).
env_value() {
  [[ -f "$ENV_FILE" ]] || return 0
  grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs 2>/dev/null || true
}

# Host ports this compose file will try to bind, resolved from the file itself
# so each variant reports its own set. Numeric mappings are taken as-is;
# ${VAR:-NNN} mappings are resolved from .env, falling back to the NNN default.
get_published_ports() {
  grep -oE '"[^"]+:[0-9]+"' "$COMPOSE_FILE" 2>/dev/null | tr -d '"' | while IFS= read -r map; do
    local host="${map%:*}"   # strip the container port (everything after the last colon)
    if [[ "$host" =~ ^[0-9]+$ ]]; then
      echo "$host"
    elif [[ "$host" =~ \$\{[^}]+:-[^}]+\} ]]; then   # ${VAR:-DEFAULT}
      local inner="${host#*\$\{}"; inner="${inner%\}}"   # VAR:-DEFAULT
      local var="${inner%%:-*}" def="${inner#*:-}" val
      val="$(env_value "$var")"
      echo "${val:-$def}"
    fi
  done | sort -un
}

# ─── TLS certificate ──────────────────────────────────────────────────────────
# FQDN clients use to reach the UI: KAFKA_UI_FQDN from .env, else the host FQDN.
get_fqdn() {
  local f
  f="$(env_value KAFKA_UI_FQDN)"
  if [[ -z "$f" ]]; then
    # `hostname -f` does a resolver lookup that can hang on air-gapped hosts;
    # cap it and fall back to the short hostname.
    if command -v timeout &>/dev/null; then
      f="$(timeout 2 hostname -f 2>/dev/null || true)"
    else
      f="$(hostname -f 2>/dev/null || true)"
    fi
    [[ -n "$f" ]] || f="$(hostname 2>/dev/null || true)"
  fi
  echo "$f"
}

# Generate a self-signed TLS cert (CN/SAN = FQDN, plus the host IP) for nginx.
cmd_gen_cert() {
  command -v openssl &>/dev/null || die "openssl not found — needed to generate the TLS certificate."
  mkdir -p "$CERTS_DIR"
  local fqdn ip san
  fqdn="$(get_fqdn)"
  ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  san="DNS:${fqdn}"; [[ -n "$ip" ]] && san="${san},IP:${ip}"
  info "Generating self-signed TLS certificate (CN=${fqdn}${ip:+, IP $ip})..."
  openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
    -keyout "$CERT_KEY" -out "$CERT_CRT" \
    -subj "/CN=${fqdn}" -addext "subjectAltName=${san}" >/dev/null 2>&1 \
    || die "openssl failed to generate the certificate."
  chmod 600 "$CERT_KEY"
  ok "Certificate written to certs/server.crt (replace with an org-CA cert anytime)"
}

# Ensure a cert exists before the proxy starts; generate one if missing.
ensure_cert() {
  if [[ -f "$CERT_CRT" && -f "$CERT_KEY" ]]; then
    return 0
  fi
  warn "No TLS certificate found — generating a self-signed one."
  cmd_gen_cert
}

# Returns 0 if a TCP listener already holds the given port on this host.
port_in_use() {
  local port="$1"
  if command -v ss &>/dev/null; then
    ss -Hltn 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -qx "$port"
  else
    # No ss (macOS, minimal hosts): a listener accepts a local connection.
    ( exec 3<>"/dev/tcp/127.0.0.1/${port}" ) 2>/dev/null
  fi
}

# ─── install ──────────────────────────────────────────────────────────────────
cmd_install() {
  local from=""
  if [[ "${1:-}" == --from ]]; then
    [[ -d "${2:-}" ]] || die "Usage: krate install [--from <earlier installation directory>]"
    from="$(cd "$2" && pwd)"
  fi
  step "Krate install"
  echo ""

  # 1. Preflight — fail safe with guidance instead of half-applying
  if [[ -z "${KRATE_DEPLOYED:-}" ]]; then
    if ! cmd_doctor; then
      echo ""
      die "Preflight checks failed — fix the issues above, then re-run: krate install"
    fi
    require_compose_file
    echo ""
  fi

  # 2. From an extracted package: load its images, install its release files
  #    into KRATE_HOME and continue there, where the site's state lives.
  if is_package; then
    cmd_load_images
    echo ""
    deploy_release "$from"
    echo ""
    KRATE_DEPLOYED=1 exec "$KRATE_HOME/krate" install
  fi

  # 3. Settings, passwords and certificate
  info "Preparing settings, passwords and the TLS certificate..."
  prepare
  echo ""

  # 4. Start and wait for the cluster to become healthy
  info "Starting cluster..."
  compose_cmd up -d
  echo ""
  cmd_health || true      # wait for the cluster to settle, then show final health
  echo ""

  sep
  cmd_credentials
  echo ""
  echo -e "  ${DIM}Installed in $SCRIPT_DIR; run its ./krate from now on, e.g.:"
  echo -e "  $SCRIPT_DIR/krate status     — check running services"
  echo -e "  $SCRIPT_DIR/krate logs -f    — follow all logs${RESET}"
  echo ""
}

# ─── load-images ──────────────────────────────────────────────────────────────
cmd_load_images() {
  require_docker
  [[ -d "$IMAGES_DIR" ]] || die "images/ directory not found in $SCRIPT_DIR"

  shopt -s nullglob
  local tars=("$IMAGES_DIR"/*.tar)
  shopt -u nullglob

  [[ ${#tars[@]} -gt 0 ]] || die "No .tar files found in $IMAGES_DIR"

  info "Loading ${#tars[@]} image(s) into Docker..."
  for tar in "${tars[@]}"; do
    local name
    name="$(basename "$tar")"
    echo -n "    $name ... "
    docker load -i "$tar" 2>&1 | sed -n 's/^Loaded image: //p' || echo ""
  done
  ok "All images loaded"
}

# ─── start ────────────────────────────────────────────────────────────────────
cmd_start() {
  prepare
  info "Starting cluster..."
  compose_cmd up -d
  echo ""
  cmd_health || true      # wait for the cluster to settle, then show final health
}

# ─── stop ─────────────────────────────────────────────────────────────────────
cmd_stop() {
  require_compose; require_compose_file
  info "Stopping cluster (containers paused, data preserved)..."
  compose_cmd stop
  ok "Stopped"
}

# ─── restart ──────────────────────────────────────────────────────────────────
cmd_restart() {
  require_compose; require_compose_file; require_env
  ensure_cert   # proxy won't start without a TLS cert (e.g. after a cert swap)
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Restarting $svc..."
    compose_cmd restart "$svc"
  else
    info "Restarting all services..."
    compose_cmd restart
  fi
  ok "Done"
}

# ─── down ─────────────────────────────────────────────────────────────────────
cmd_down() {
  require_compose; require_compose_file
  info "Removing containers (named volumes preserved)..."
  compose_cmd down
  ok "Containers removed. Run: krate start"
}

# ─── status ───────────────────────────────────────────────────────────────────
cmd_status() {
  require_compose; require_compose_file
  compose_cmd ps
}

# ─── logs ─────────────────────────────────────────────────────────────────────
cmd_logs() {
  require_compose; require_compose_file
  local follow=false
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=true; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done

  if $follow; then
    compose_cmd logs -f --tail=50 "${args[@]}"
  else
    compose_cmd logs --tail=100 "${args[@]}"
  fi
}

# ─── health ───────────────────────────────────────────────────────────────────
# Count containers still in Docker's transient "starting" state — i.e. inside
# their healthcheck start_period, not yet settled either way.
health_pending_count() {
  local cid n=0 h
  while IFS= read -r cid; do
    [[ -z "$cid" ]] && continue
    h=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo none)
    [[ "$h" == "starting" ]] && n=$((n + 1))
  done <<< "$1"
  echo "$n"
}

cmd_health() {
  require_compose; require_compose_file

  # A service reports "starting" until its start_period elapses, so a one-shot
  # check straight after `krate start` is a false negative (the proxy is the
  # usual victim — it only starts once the UI, and thus every broker, is up).
  # Wait for the cluster to settle by default; an already-settled cluster
  # returns immediately, so this costs nothing once things are steady.
  local wait=true timeout=120
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-wait) wait=false; shift ;;
      --timeout) timeout="${2:?--timeout needs a value in seconds}"; shift 2 ;;
      *)         die "Unknown option: $1 (usage: krate health [--no-wait] [--timeout N])" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds"

  local container_ids
  container_ids=$(compose_cmd ps -q 2>/dev/null || true)

  if [[ -z "$container_ids" ]]; then
    warn "No containers running. Run: krate start"
    return 1
  fi

  if $wait; then
    local waited=0 interval=3 pending
    pending=$(health_pending_count "$container_ids")
    while (( pending > 0 )) && (( waited < timeout )); do
      if [[ -t 1 ]]; then
        printf "\r  ${DIM}waiting for %d service(s) to settle... %ds/%ds${RESET}" \
          "$pending" "$waited" "$timeout"
      fi
      sleep "$interval"
      waited=$(( waited + interval ))
      container_ids=$(compose_cmd ps -q 2>/dev/null || true)
      pending=$(health_pending_count "$container_ids")
    done
    if [[ -t 1 ]]; then
      printf "\r\033[K"
    fi
  fi

  sep
  echo -e "${BOLD}  Service Health${RESET}"
  sep
  echo ""

  local all_ok=true

  while IFS= read -r cid; do
    [[ -z "$cid" ]] && continue
    local name status health
    name=$(docker inspect --format='{{.Name}}' "$cid" | sed 's|^/||')
    status=$(docker inspect --format='{{.State.Status}}' "$cid")
    health=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid")

    local label
    if [[ "$health" == "healthy" ]]; then
      label="${GREEN}healthy${RESET}"
    elif [[ "$health" == "none" && "$status" == "running" ]]; then
      label="${GREEN}running${RESET}"
    elif [[ "$health" == "starting" ]]; then
      label="${YELLOW}starting${RESET}"
      all_ok=false
    else
      label="${RED}${health:-$status}${RESET}"
      all_ok=false
    fi

    printf "  %-35s %b\n" "$name" "$label"
  done <<< "$container_ids"

  echo ""
  if $all_ok; then
    ok "All services healthy"
  else
    if $wait && (( $(health_pending_count "$container_ids") > 0 )); then
      warn "Still starting after ${timeout}s — the cluster may just need longer."
      warn "Retry with a longer wait: krate health --timeout $(( timeout * 2 ))"
    else
      warn "Some services not ready. Run: krate logs <service>"
    fi
    return 1
  fi
}

# ─── ui ───────────────────────────────────────────────────────────────────────
cmd_ui() {
  local user pass fqdn hp port_suffix=""
  user="$(env_value KAFKA_UI_USER)"
  pass="$(env_value KAFKA_UI_PASSWORD)"
  fqdn="$(get_fqdn)"
  hp="$(env_value KAFKA_UI_HTTPS_PORT)"; hp="${hp:-443}"
  [[ "$hp" != "443" ]] && port_suffix=":${hp}"

  sep
  echo -e "${BOLD}  Kafbat UI${RESET}"
  sep
  echo "  URL       https://${fqdn}${port_suffix}/"
  if [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "runtime.yml" ]]; then
    echo "  Sign-in   Shared app login (Admin) or SSO via Keycloak"
  elif [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "pingfederate.yml" ]]; then
    echo "  Sign-in   PingFederate (company SSO)"
  else
    [[ -n "$user" ]] && echo "  Username  $user"
    [[ -n "$pass" ]] && echo "  Password  $pass"
  fi
  echo -e "  ${DIM}TLS is a self-signed cert — trust certs/server.crt or proceed past the browser warning.${RESET}"
  sep
}

# ─── config ───────────────────────────────────────────────────────────────────
cmd_config() {
  local action="${1:-show}"
  shift || true

  case "$action" in
    show)
      local file
      for file in "$ENV_FILE" "$MONITOR_DIR/.env"; do
        [[ -f "$file" ]] || continue
        sep
        echo -e "${BOLD}  $file${RESET}"
        sep
        cat "$file"
      done
      sep
      [[ -f "$ENV_FILE" ]] || warn ".env does not exist yet; krate setup creates it."
      ;;
    set)
      local kv="${1:-}" file="$ENV_FILE" template="$ENV_TEMPLATE"
      [[ "$kv" == *=* ]] || die "Usage: krate config set KEY=VALUE"
      local key="${kv%%=*}"
      local val="${kv#*=}"
      [[ "$key" =~ ^[A-Z0-9_]+_IMAGE$ ]] && die "Image pins come from .env.template; change $key there, or export it in the shell for one run."
      # Keycloak was initialised with these; once its database exists they
      # change in Keycloak and .env together.
      case "$key" in
        KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET)
          local state=""
          [[ ! -f "$file" ]] || state="$(identity_state 2>/dev/null || true)"
          [[ "${state%% *}" != existing ]] || die "The identity database already uses $key. Change it on both sides with: krate identity rotate $key"
          ;;
      esac
      # Monitoring keys live in monitoring/.env; everything else in .env.
      if ! grep -qE "^${key}=" "$ENV_TEMPLATE" && [[ -f "$MONITOR_DIR/.env.template" ]] \
          && grep -qE "^${key}=" "$MONITOR_DIR/.env.template"; then
        file="$MONITOR_DIR/.env"
        template="$MONITOR_DIR/.env.template"
      fi
      if [[ ! -f "$file" ]]; then
        cp "$template" "$file"
      fi
      chmod 600 "$file"
      set_env_file_value "$file" "$key" "$val"
      ok "Set ${key} in ${file#"$SCRIPT_DIR"/}"
      ;;
    *)
      die "Usage: krate config [show | set KEY=VALUE]"
      ;;
  esac
}

# ─── uninstall ────────────────────────────────────────────────────────────────
cmd_uninstall() {
  require_compose; require_compose_file

  local purge=false
  [[ "${1:-}" == "--purge" ]] && purge=true

  if $purge; then
    echo ""
    warn "WARNING: --purge will delete all Kafka data (broker logs, ZK state, offsets)"
    warn "and the identity database (Keycloak users and settings, volume keycloak_db_data)."
    warn "This is irreversible. Keep a copy first: krate identity backup <file>"
    echo ""
    read -rp "Type 'yes' to confirm purge: " confirm
    [[ "$confirm" == "yes" ]] || die "Aborted."
    info "Removing containers and volumes..."
    identity_compose down -v
  else
    info "Removing containers (volumes preserved)..."
    identity_compose down
  fi
  ok "Done"
}

# ─── monitor (observability stack) ───────────────────────────────────────────
# The stack in monitoring/ is shared by every variant. Rather than hardcode a
# network name and broker list per variant, discover both from the cluster that
# is actually running: the compose project name varies with the directory a
# bundle was extracted into, so a hardcoded external network would break.
# In a bundle the stack sits beside the CLI; in the repo it lives once at the
# root and is shared by every variant.
MONITOR_DIR="$SCRIPT_DIR/monitoring"
[[ -d "$MONITOR_DIR" ]] || MONITOR_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/monitoring"

# The docker network the brokers are attached to.
monitor_network() {
  local cid
  cid="$(compose_cmd ps -q 2>/dev/null | head -1)"
  [[ -n "$cid" ]] || return 1
  docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$cid" 2>/dev/null \
    | tr ' ' '\n' | grep -v '^$' | head -1
}

# One --kafka.server= flag per broker, taken from the internal bootstrap list so
# the exporter uses the same listener the brokers use for each other.
monitor_targets() {
  local out=""
  local IFS=','
  for hp in $BOOTSTRAP; do
    out+="--kafka.server=$hp "
  done
  echo "${out% }"
}

# Count configured broker services independently of their runtime state.
monitor_broker_count() {
  local services
  services="$(compose_cmd config --services)" || return 1
  printf '%s\n' "$services" | awk '/^kafka-[0-9]+$/ { count++ } END { if (count < 1) exit 1; print count }'
}

monitor_compose() {
  [[ -d "$MONITOR_DIR" ]] || die "monitoring/ not found in $SCRIPT_DIR
This bundle was built without the observability stack."
  local net
  net="$(monitor_network)" || net=""
  if [[ "$1" == "up" && -z "$net" ]]; then
    die "The cluster is not running — start it first: krate start"
  fi
  local expected
  expected="$(monitor_broker_count)" || expected=""
  if [[ "$1" == "up" && -z "$expected" ]]; then
    die "Cannot determine the configured broker count from cluster Compose services."
  fi
  # down/ps/logs must still work after the broker containers are removed.
  net="${net:-krate-unused-network}"

  local env_file="$MONITOR_DIR/.env"
  if [[ ! -f "$env_file" ]]; then
    cp "$MONITOR_DIR/.env.template" "$env_file"
    chmod 600 "$env_file"
  fi
  sync_image_pins "$env_file" "$MONITOR_DIR/.env.template"

  # SSO-only services run in native/gateway mode; down/ps/logs always include
  # them so switching back to local mode still stops and shows them.
  local profiles=""
  case "$(env_value_file "$env_file" PERSES_AUTH_MODE local)" in
    native|gateway) profiles="perses-sso" ;;
  esac
  [[ "$1" == "up" ]] || profiles="perses-sso"

  # Recreate the rendered-config consumers whenever their inputs change,
  # including a renewed gateway certificate.
  local revision
  revision="$(find "$env_file" "$MONITOR_DIR/auth/perses" "$MONITOR_DIR/render.py" "$MONITOR_DIR/perses" \
    "$CERT_CRT" "$CERT_KEY" -type f ! -path '*/__pycache__/*' 2>/dev/null | LC_ALL=C sort | xargs cat 2>/dev/null \
    | cksum | cut -d' ' -f1)"

  KRATE_RENDER_REVISION="$revision" \
  COMPOSE_PROFILES="$profiles" \
  PERSES_CERTS_DIR="$CERTS_DIR" \
  KAFKA_EXPECTED_BROKERS="${expected:-1}" \
  KAFKA_NETWORK="$net" \
  KAFKA_EXPORTER_TARGETS="$(monitor_targets)" \
  CLUSTER_LABEL="$KRATE_VARIANT" \
  MONITOR_PROJECT="krate-${KRATE_VARIANT}-monitoring" \
  "${COMPOSE_BIN[@]}" -p "krate-${KRATE_VARIANT}-monitoring" --env-file "$env_file" -f "$MONITOR_DIR/docker-compose.yml" "$@"
}

# Monitoring host ports that something other than the monitoring stack holds.
monitor_port_conflicts() {
  local own entry key port
  own="$(docker ps --filter "label=com.docker.compose.project=krate-${KRATE_VARIANT}-monitoring" --format '{{.Ports}}')"
  for entry in GRAFANA_PORT:3000 PROM_PORT:9090 LOKI_PORT:3100 PERSES_PORT:3443; do
    key="${entry%%:*}"
    port="$(env_value_file "$MONITOR_DIR/.env" "$key" "${entry#*:}")"
    [[ "$own" == *":${port}->"* ]] && continue
    if port_in_use "$port"; then
      echo "$key=$port"
    fi
  done
}

# Grafana and Perses addresses and logins.
monitor_logins() {
  local port; port="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_PORT 3000)"
  echo "Grafana:  http://$(hostname -f 2>/dev/null || hostname):${port}"
  echo "User:     $(env_value_file "$MONITOR_DIR/.env" GRAFANA_USER admin)"
  echo "Password: $(env_value_file "$MONITOR_DIR/.env" GRAFANA_PASSWORD changeme)"
  echo "Perses:   https://$(hostname -f 2>/dev/null || hostname):$(env_value_file "$MONITOR_DIR/.env" PERSES_PORT 3443)"
  if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local)" == local ]]; then
    echo "User:     $(env_value_file "$MONITOR_DIR/.env" PERSES_ADMIN_USER admin)"
    echo "Password: $(env_value_file "$MONITOR_DIR/.env" PERSES_ADMIN_PASSWORD)"
  else
    echo "Sign-in:  company SSO ($(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local) mode)"
  fi
}

cmd_monitor() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)
      require_compose
      info "Starting observability stack..."
      command -v python3 >/dev/null || die "python3 is required to initialize editable Grafana alerts."
      ensure_cert
      monitor_prepare
      local conflicts
      conflicts="$(monitor_port_conflicts | xargs)"
      [[ -z "$conflicts" ]] || die "Host ports already in use: $conflicts. Choose free ones, e.g. krate config set GRAFANA_PORT=13000"
      # Compose leaves a dropped profile's services running. In local mode remove
      # the SSO services first, so the previous mode's guard cannot act on Perses.
      if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local)" == local ]]; then
        monitor_compose rm -s -f oauth2-proxy perses-sync >/dev/null
      fi
      monitor_compose up -d
      python3 "$MONITOR_DIR/seed-alerting.py" "$MONITOR_DIR/.env"
      echo ""
      ok "Grafana:    http://$(hostname -f 2>/dev/null || hostname):$(env_value_file "$MONITOR_DIR/.env" GRAFANA_PORT 3000)"
      ok "Prometheus: http://$(hostname -f 2>/dev/null || hostname):$(env_value_file "$MONITOR_DIR/.env" PROM_PORT 9090)"
      ok "Perses:     https://$(hostname -f 2>/dev/null || hostname):$(env_value_file "$MONITOR_DIR/.env" PERSES_PORT 3443) ($(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local) sign-in)"
      note_smtp
      ;;
    down)    require_compose; monitor_compose down "$@" ;;
    status)  require_compose; monitor_compose ps ;;
    logs)    require_compose; monitor_compose logs --tail 100 "$@" ;;
    reload)
      # Re-read alert rules without restarting Prometheus.
      require_compose
      if monitor_compose exec -T prometheus wget -q -O /dev/null --post-data='' http://127.0.0.1:9090/-/reload; then
        ok "Prometheus reloaded its rules."
      else
        die "Reload failed — is the stack up?"
      fi
      ;;
    ui) monitor_logins ;;
    *)
      echo "Usage: krate monitor {up|down|status|logs|reload|ui}"
      return 1 ;;
  esac
}

# Read a key from an arbitrary env file, with a default.
env_value_file() {
  local file="$1" key="$2" default="${3:-}" v=""
  [[ -f "$file" ]] && v="$(grep -E "^${key}=" "$file" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"'"'"'"')"
  echo "${v:-$default}"
}

# Alerting works without SMTP; only delivery is off. Say so rather than let an
# operator assume email is configured.
# Generate the per-install secrets of the parallel Perses stack, and refuse
# unsafe defaults, before the monitoring-init renderer reads monitoring/.env.
monitor_prepare() {
  local env_file="$MONITOR_DIR/.env"
  prepare_monitor_env
  mkdir -p "$MONITOR_DIR/auth/perses"
  python3 - "$env_file" <<'PY' || die "monitoring/.env is not ready for the Perses stack (see above)."
import re, sys
path = sys.argv[1]
text = open(path).read()

def value(key):
    found = re.findall(r'^%s=(.*)$' % re.escape(key), text, re.M)
    return found[-1].strip().strip('"\'') if found else ''

mode = value('PERSES_AUTH_MODE') or 'local'
if mode == 'local' and len(value('PERSES_ADMIN_PASSWORD')) < 12:
    sys.exit('  PERSES_ADMIN_PASSWORD in monitoring/.env is shorter than 12 characters; set a longer one or empty it to generate one.')
if mode in ('native', 'gateway') and not value('OAUTH2_PROXY_CLIENT_SECRET'):
    sys.exit('  Set OAUTH2_PROXY_CLIENT_SECRET (the Perses OIDC client secret) in monitoring/.env.')
if mode == 'native' and not value('PERSES_SYNC_CLIENT_SECRET'):
    sys.exit('  Set PERSES_SYNC_CLIENT_SECRET (the access guard client secret) in monitoring/.env.')
PY
}

note_smtp() {
  local en; en="$(env_value_file "$MONITOR_DIR/.env" GF_SMTP_ENABLED false)"
  if [[ "$en" != "true" ]]; then
    warn "Email delivery is off (GF_SMTP_ENABLED=false). Alerts still fire and show in Grafana."
    warn "To enable: krate config set GF_SMTP_ENABLED=true (and GF_SMTP_HOST, ALERT_EMAIL_TO, ...), then krate monitor up"
  fi
}

# ─── doctor (preflight) ───────────────────────────────────────────────────────
# Read-only checks run before touching the host. Catches the things that bite
# a shared box: busy host ports, a firewalld/Docker NAT zone conflict, and a
# missing/old Docker or Compose. Returns non-zero if a blocking issue is found.
cmd_doctor() {
  sep
  echo -e "${BOLD}  Preflight Check${RESET}"
  sep
  echo ""

  local problems=0

  # ── Docker engine + daemon ──
  info "Docker engine"
  if command -v docker &>/dev/null; then
    local dv
    dv=$(docker --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if version_gte "$dv" "25.0.3"; then
      ok "Docker $dv"
    else
      warn "Docker $dv — minimum required: 25.0.3"
      problems=$((problems + 1))
    fi
    if docker info &>/dev/null 2>&1; then
      ok "daemon is running"
    else
      err "daemon not running or not accessible — try: sudo systemctl start docker"
      problems=$((problems + 1))
    fi
  else
    err "docker not found — run: krate docker-install"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Compose ──
  info "Docker Compose"
  if [[ ${#COMPOSE_BIN[@]} -gt 0 ]]; then
    local cv
    cv=$(get_compose_version)
    if version_gte "$cv" "1.29.2"; then
      ok "${COMPOSE_BIN[*]} $cv"
    else
      warn "${COMPOSE_BIN[*]} $cv — minimum required: 1.29.2"
      problems=$((problems + 1))
    fi
  else
    err "Docker Compose not found — run: krate docker-install"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Bundle files ──
  info "Bundle files"
  if [[ -f "$COMPOSE_FILE" ]]; then
    ok "docker-compose.yml"
  else
    err "docker-compose.yml missing in $SCRIPT_DIR"
    problems=$((problems + 1))
  fi
  # A package keeps the site's settings and certificate in its installation.
  local site_dir="$SCRIPT_DIR"
  if is_package; then
    site_dir="$KRATE_HOME"
    ok "installs into $KRATE_HOME"
  fi
  if [[ -f "$site_dir/.env" ]]; then
    ok ".env present in $site_dir (kept)"
  else
    ok "no .env yet — install creates it with generated passwords"
  fi
  if [[ -f "$site_dir/certs/server.crt" && -f "$site_dir/certs/server.key" ]]; then
    ok "TLS certificate present in $site_dir/certs (kept)"
  elif command -v openssl &>/dev/null; then
    ok "no TLS cert yet — will be generated with openssl on install"
  else
    err "no TLS cert and openssl not found — install/start will fail to generate one"
    warn "Install openssl (e.g. apt-get install -y openssl) or drop a cert in certs/server.{crt,key}"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Architecture match ──
  # The bundled images are arch-specific; running them on a mismatched host
  # fails at container start with "exec format error". Catch it here instead.
  info "Architecture"
  if [[ -f "$SCRIPT_DIR/.bundle-arch" ]]; then
    local bundle_arch host_arch
    bundle_arch="$(tr -d '[:space:]' < "$SCRIPT_DIR/.bundle-arch")"
    host_arch="$(docker version --format '{{.Server.Arch}}' 2>/dev/null || true)"
    if [[ -z "$host_arch" ]]; then
      warn "bundle is $bundle_arch; could not determine host arch to compare"
    elif [[ "$bundle_arch" == "$host_arch" ]]; then
      ok "bundle $bundle_arch matches host $host_arch"
    else
      err "bundle is $bundle_arch but this host is $host_arch — images will not run (exec format error)."
      err "Use the $host_arch bundle instead (kafka-<mode>-<ver>-$host_arch.tar.gz)."
      problems=$((problems + 1))
    fi
  else
    warn "no .bundle-arch marker — cannot verify architecture (older bundle?)"
  fi
  echo ""

  # ── Host port availability ──
  info "Host port availability"
  local busy=0 ports
  ports="$(get_published_ports)"
  for p in $ports; do
    if port_in_use "$p"; then
      warn "port $p is already in use"
      busy=$((busy + 1))
    else
      ok "port $p free"
    fi
  done
  if (( busy > 0 )); then
    warn "If this cluster is already running, in-use ports are expected (it's us)."
    warn "Otherwise free them or change the external ports in .env before installing."
  fi
  echo ""

  # ── Firewall / Docker NAT compatibility ──
  info "Firewall (Docker NAT compatibility)"
  if command -v firewall-cmd &>/dev/null && firewall-cmd --state &>/dev/null 2>&1; then
    if firewall-cmd --get-zones 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
      local tgt
      tgt="$(firewall-cmd --info-zone=docker 2>/dev/null | awk -F': ' '/target:/{print $2}' | tr -d '[:space:]')"
      if [[ "$tgt" == "ACCEPT" ]]; then
        ok "firewalld active, 'docker' zone present (target ACCEPT)"
      else
        warn "firewalld 'docker' zone target is '${tgt:-unknown}', not ACCEPT — containers may not reach each other."
        warn "Fix: firewall-cmd --permanent --zone=docker --set-target=ACCEPT && firewall-cmd --reload && systemctl restart docker"
        problems=$((problems + 1))
      fi
    else
      warn "firewalld is active but has no 'docker' zone."
      warn "Docker can abort with: Failed to program NAT chain: INVALID_ZONE: docker"
      warn "Fix: firewall-cmd --permanent --new-zone=docker && firewall-cmd --permanent --zone=docker --set-target=ACCEPT && firewall-cmd --reload && systemctl restart docker"
      problems=$((problems + 1))
    fi
  else
    ok "firewalld not active — no NAT-zone conflict expected"
  fi
  echo ""

  # ── iptables backend consistency ──
  # If Docker's FORWARD rules end up in BOTH iptables-legacy and iptables-nft,
  # one stale layer's default-drop silently blocks container-to-container traffic.
  # Listing iptables rules needs root, so report honestly when we can't inspect.
  info "iptables backend"
  if [[ "$(id -u)" != "0" ]]; then
    warn "not root — skipped the legacy/nft split-brain check (re-run as root to verify)"
  else
    local legacy_docker=false nft_docker=false
    if iptables-legacy -S FORWARD 2>/dev/null | grep -q 'DOCKER'; then legacy_docker=true; fi
    if iptables-nft     -S FORWARD 2>/dev/null | grep -q 'DOCKER'; then nft_docker=true; fi
    if $legacy_docker && $nft_docker; then
      err "Docker FORWARD rules exist in BOTH iptables-legacy and iptables-nft (split-brain)."
      err "Container networking can break. Align on one backend, e.g.:"
      err "  update-alternatives --set iptables /usr/sbin/iptables-nft && systemctl restart docker"
      problems=$((problems + 1))
    elif $legacy_docker || $nft_docker; then
      ok "single iptables backend ($($legacy_docker && echo legacy || echo nf_tables))"
    else
      warn "no Docker FORWARD rules found in either backend — is Docker running? (couldn't verify)"
    fi
  fi
  echo ""

  sep
  if (( problems == 0 )); then
    ok "All preflight checks passed."
    return 0
  else
    warn "$problems blocking issue(s) found — resolve them before 'krate install'."
    return 1
  fi
}

# ─── docker-check ─────────────────────────────────────────────────────────────
cmd_docker_check() {
  sep
  echo -e "${BOLD}  Docker Environment Check${RESET}"
  sep
  echo ""

  local all_ok=true

  # ── Docker binary + min version ──
  if command -v docker &>/dev/null; then
    local dv
    dv=$(docker --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    ok "docker found at $(command -v docker)"
    if version_gte "$dv" "25.0.3"; then
      ok "Docker Engine $dv"
    else
      warn "Docker Engine $dv — minimum required: 25.0.3"
      all_ok=false
    fi
  else
    err "docker not found in PATH"
    all_ok=false
  fi

  # ── Docker daemon ──
  if docker info &>/dev/null 2>&1; then
    ok "Docker daemon is running"
  else
    err "Docker daemon is not running or not accessible"
    warn "  sudo systemctl start docker"
    warn "  newgrp docker  (if recently added to docker group)"
    all_ok=false
  fi

  # ── Compose binary + min version ──
  if [[ ${#COMPOSE_BIN[@]} -gt 0 ]]; then
    local cv
    cv=$(get_compose_version)
    if version_gte "$cv" "1.29.2"; then
      ok "${COMPOSE_BIN[*]} ($cv)"
    else
      warn "${COMPOSE_BIN[*]} $cv — minimum required: 1.29.2"
      all_ok=false
    fi
  else
    err "Docker Compose not found"
    warn "  Need: 'docker compose' plugin (v2) OR 'docker-compose' ≥1.29.2"
    all_ok=false
  fi

  echo ""
  if $all_ok; then
    ok "Docker is ready"
  else
    warn "Issues found. Run: krate docker-install"
    return 1
  fi
}

# ─── docker-install ───────────────────────────────────────────────────────────
cmd_docker_install() {
  [[ -d "$DOCKER_OFFLINE_DIR" ]] || die "docker-offline/ not found in $SCRIPT_DIR
This bundle was not packaged with Docker. On an internet-connected build machine, rebuild it with:
  make docker-debs UBUNTU_VERSION=<jammy|noble> ARCH=<amd64|arm64>
  make bundle VERSION=vN ARCH=<amd64|arm64> INCLUDE_DOCKER=1
Then transfer the rebuilt bundle to this offline VM."

  shopt -s nullglob
  local debs=("$DOCKER_OFFLINE_DIR"/*.deb)
  shopt -u nullglob

  [[ ${#debs[@]} -gt 0 ]] || die "No .deb files in $DOCKER_OFFLINE_DIR
On an internet-connected build machine, rebuild the bundle with:
  make docker-debs UBUNTU_VERSION=<jammy|noble> ARCH=<amd64|arm64>
  make bundle VERSION=vN ARCH=<amd64|arm64> INCLUDE_DOCKER=1
Then transfer the rebuilt bundle to this offline VM."

  info "Installing Docker CE from ${#debs[@]} bundled packages..."
  echo ""

  local order=(containerd.io docker-ce-cli docker-ce docker-compose-plugin)
  local -a matches
  for pkg in "${order[@]}"; do
    matches=()
    for f in "${debs[@]}"; do
      if [[ "$(basename "$f")" == "${pkg}_"* ]]; then
        matches+=("$f")
      fi
    done
    if [[ ${#matches[@]} -eq 1 ]]; then
      echo "  Installing $(basename "${matches[0]}")..."
      sudo dpkg -i "${matches[0]}" || true
    elif [[ ${#matches[@]} -eq 0 ]]; then
      warn "Package not found in bundle: $pkg"
    else
      die "Multiple packages found for $pkg; refusing to choose one:
$(printf '  %s\n' "${matches[@]}")"
    fi
  done

  echo ""
  info "Resolving any remaining dependencies..."
  sudo apt-get install -f -y 2>/dev/null || true

  sudo systemctl enable docker
  sudo systemctl start docker

  if ! groups "$USER" 2>/dev/null | grep -q '\bdocker\b'; then
    sudo usermod -aG docker "$USER"
    warn "Added $USER to docker group."
    warn "Run 'newgrp docker' or log out and back in before using Docker without sudo."
  fi

  echo ""
  ok "$(docker --version)"
  ok "$(docker compose version 2>/dev/null || docker-compose version 2>/dev/null)"
  ok "Docker installed successfully."
}

# ─── lag ──────────────────────────────────────────────────────────────────────
cmd_lag() {
  require_compose; require_compose_file

  local group=""
  local topic=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --group|-g) group="$2"; shift 2 ;;
      --topic|-t) topic="$2"; shift 2 ;;
      -*)         die "Unknown option: $1. Usage: krate lag [group] [--topic <topic>]" ;;
      *)          group="$1"; shift ;;
    esac
  done

  local broker
  broker=$(find_broker)

  if [[ -n "$group" ]]; then
    # ── Detailed view: one group, per-partition breakdown ─────────────────────
    sep
    printf "${BOLD}  Consumer Group: %s${RESET}\n" "$group"
    [[ -n "$topic" ]] && printf "  Topic filter:   %s\n" "$topic"
    sep
    echo ""

    local raw
    raw=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server "$BOOTSTRAP" \
      --describe --group "$group" 2>&1) || die "Failed to describe group '$group'"

    if echo "$raw" | grep -qiE "does not exist|group .* not found"; then
      die "Consumer group '$group' does not exist."
    fi

    [[ -n "$topic" ]] && raw=$(echo "$raw" | awk -v t="$topic" 'NR==1 || $2==t')

    printf "  ${BOLD}%-32s %-9s %-15s %-15s %-10s %-22s${RESET}\n" \
      "TOPIC" "PARTITION" "CURRENT-OFFSET" "LOG-END-OFFSET" "LAG" "CONSUMER-ID"
    sep

    local total_lag=0 partition_count=0

    while IFS= read -r line; do
      [[ "$line" =~ ^GROUP ]] && continue
      [[ -z "$(echo "$line" | tr -d '[:space:]')" ]] && continue

      local grp t part cur_off log_end lag consumer_id
      grp=$(         echo "$line" | awk '{print $1}')
      t=$(           echo "$line" | awk '{print $2}')
      part=$(        echo "$line" | awk '{print $3}')
      cur_off=$(     echo "$line" | awk '{print $4}')
      log_end=$(     echo "$line" | awk '{print $5}')
      lag=$(         echo "$line" | awk '{print $6}')
      consumer_id=$( echo "$line" | awk '{print $7}')

      # Truncate consumer-id for readability
      local short_cid="${consumer_id:0:20}"
      [[ "${#consumer_id}" -gt 20 ]] && short_cid="${short_cid}…"

      local lag_col
      if [[ "$lag" =~ ^[0-9]+$ ]]; then
        if   [[ "$lag" -eq 0 ]];    then lag_col="${GREEN}${lag}${RESET}"
        elif [[ "$lag" -lt 1000 ]]; then lag_col="${YELLOW}${lag}${RESET}"
        else                             lag_col="${RED}${lag}${RESET}"
        fi
        total_lag=$((total_lag + lag))
        ((partition_count += 1)) || true
      else
        lag_col="${DIM}${lag:-—}${RESET}"
      fi

      printf "  %-32s %-9s %-15s %-15s %-10b %-22s\n" \
        "$t" "$part" "$cur_off" "$log_end" "$lag_col" "$short_cid"

    done <<< "$raw"

    sep
    printf "  Partitions: %-6s  Total lag: " "$partition_count"
    if   [[ "$total_lag" -eq 0 ]];    then echo -e "${GREEN}${total_lag}${RESET}  (caught up)"
    elif [[ "$total_lag" -lt 1000 ]]; then echo -e "${YELLOW}${total_lag}${RESET}"
    else                                   echo -e "${RED}${total_lag}${RESET}  — consumer is behind"
    fi
    echo ""

  else
    # ── Summary view: all groups ──────────────────────────────────────────────
    sep
    echo -e "${BOLD}  Consumer Group Lag Summary${RESET}"
    [[ -n "$topic" ]] && echo -e "  Topic filter: ${topic}"
    sep
    echo ""

    local groups
    groups=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server "$BOOTSTRAP" \
      --list 2>/dev/null | grep -v "^$" | sort) || die "Failed to list consumer groups"

    if [[ -z "$groups" ]]; then
      warn "No consumer groups found."
      return
    fi

    printf "  ${BOLD}%-42s %-12s %-12s %s${RESET}\n" "GROUP" "PARTITIONS" "TOTAL LAG" "STATUS"
    sep

    local group_count=0 lagging_count=0

    while IFS= read -r grp; do
      [[ -z "$grp" ]] && continue

      local raw_desc
      raw_desc=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
        --bootstrap-server "$BOOTSTRAP" \
        --describe --group "$grp" 2>/dev/null || true)

      [[ -n "$topic" ]] && raw_desc=$(echo "$raw_desc" | awk -v t="$topic" 'NR==1 || $2==t')

      local total_lag=0 part_count=0
      while IFS= read -r line; do
        [[ "$line" =~ ^GROUP ]] && continue
        [[ -z "$(echo "$line" | tr -d '[:space:]')" ]] && continue
        local lag
        lag=$(echo "$line" | awk '{print $6}')
        if [[ "$lag" =~ ^[0-9]+$ ]]; then
          total_lag=$((total_lag + lag))
          ((part_count += 1)) || true
        fi
      done <<< "$raw_desc"

      # Skip groups with no matching partitions when filtering by topic
      [[ "$part_count" -eq 0 && -n "$topic" ]] && continue

      local status_col
      if   [[ "$total_lag" -eq 0 ]];    then status_col="${GREEN}caught up${RESET}"
      elif [[ "$total_lag" -lt 1000 ]]; then status_col="${YELLOW}lagging${RESET}";  ((lagging_count += 1)) || true
      else                                   status_col="${RED}behind${RESET}";    ((lagging_count += 1)) || true
      fi

      printf "  %-42s %-12s %-12s %b\n" "$grp" "$part_count" "$total_lag" "$status_col"
      ((group_count += 1)) || true

    done <<< "$groups"

    echo ""
    sep
    printf "  %s group(s)   %s with lag > 0\n" "$group_count" "$lagging_count"
    echo ""
    echo -e "  ${DIM}Drill down:  krate lag <group-name>"
    echo -e "  Topic only:  krate lag --topic <topic-name>${RESET}"
    echo ""
  fi
}

