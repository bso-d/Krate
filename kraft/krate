#!/usr/bin/env bash
# krate — Krate (Kafka) cluster management CLI
# Usage: krate <command> [options]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
ENV_FILE="$SCRIPT_DIR/.env"
ENV_TEMPLATE="$SCRIPT_DIR/.env.template"
IMAGES_DIR="$SCRIPT_DIR/images"
DOCKER_OFFLINE_DIR="$SCRIPT_DIR/docker-offline"
KRATE_VARIANT="kraft"
CERTS_DIR="$SCRIPT_DIR/certs"
CERT_CRT="$CERTS_DIR/server.crt"
CERT_KEY="$CERTS_DIR/server.key"
# Set when this CLI runs from a source checkout, where it can also build the
# Kafbat UI image and offline packages; empty inside an extracted package.
REPO_DIR=""
# A checkout's CLI lives in the edition directory itself (<repo>/kraft or
# <repo>/epc) and has no images/ beside it; a package extracted under the
# repository root has the same parent files but its own name and images/.
if [[ "${SCRIPT_DIR##*/}" == "$KRATE_VARIANT" && ! -d "$SCRIPT_DIR/images" \
    && -f "$SCRIPT_DIR/../Makefile" && -f "$SCRIPT_DIR/../kafbat-ui/build.py" ]]; then
  REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
# Where a package is installed. Its settings, passwords, certificates and SSO
# files stay here across updates; each package only replaces the release files.
KRATE_HOME="${KRATE_HOME:-/opt/krate/$KRATE_VARIANT}"
# A broker container, whose labels tell where an earlier installation ran from.
BROKER_CONTAINER="krate-broker-92"

# ─── Compose binary detection (v2 plugin or v1 standalone) ───────────────────
if docker compose version &>/dev/null 2>&1; then
  COMPOSE_BIN=(docker compose)
elif command -v docker-compose &>/dev/null 2>&1; then
  COMPOSE_BIN=(docker-compose)
else
  COMPOSE_BIN=()
fi

# ─── Output helpers ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
  BLUE='\033[0;34m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; BLUE=''; BOLD=''; DIM=''; RESET=''
fi

info()  { echo -e "${BLUE}==>${RESET} $*"; }
ok()    { echo -e "${GREEN}  ✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}  !${RESET} $*"; }
err()   { echo -e "${RED}  ✗${RESET} $*" >&2; }
die()   { err "$*"; exit 1; }
step()  { echo -e "${BOLD}--- $* ---${RESET}"; }
sep()   { echo -e "${DIM}────────────────────────────────────────${RESET}"; }

# ─── Version helpers ──────────────────────────────────────────────────────────
# Returns 0 (true) if semver $1 >= $2
version_gte() {
  local a b
  IFS='.' read -ra a <<< "${1//[^0-9.]/}"
  IFS='.' read -ra b <<< "${2//[^0-9.]/}"
  for i in 0 1 2; do
    local x="${a[$i]:-0}" y="${b[$i]:-0}"
    (( 10#$x > 10#$y )) && return 0
    (( 10#$x < 10#$y )) && return 1
  done
  return 0
}

get_compose_version() {
  "${COMPOSE_BIN[@]}" version --short 2>/dev/null | tr -d 'v'
}

# ─── Prerequisites ────────────────────────────────────────────────────────────
require_docker() {
  if ! command -v docker &>/dev/null; then
    die "Docker not found. Run: krate docker-install"
  fi
  if ! docker info &>/dev/null 2>&1; then
    die "Docker daemon is not running or not accessible.
    Try: sudo systemctl start docker
    Or:  newgrp docker  (if you were just added to the docker group)"
  fi
}

require_compose() {
  require_docker
  if [[ ${#COMPOSE_BIN[@]} -eq 0 ]]; then
    die "Docker Compose not found. Need 'docker compose' plugin or 'docker-compose' ≥1.29.2.
Run: krate docker-install"
  fi
}

require_compose_file() {
  [[ -f "$COMPOSE_FILE" ]] || die "docker-compose.yml not found in $SCRIPT_DIR"
}

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    if [[ -f "$ENV_TEMPLATE" ]]; then
      cp "$ENV_TEMPLATE" "$ENV_FILE"
      chmod 600 "$ENV_FILE"
      ok "Created .env from template. Change settings with: krate config set KEY=VALUE"
    else
      die ".env not found and no .env.template available. Create $ENV_FILE with KAFKA_UI_USER and KAFKA_UI_PASSWORD."
    fi
  fi
}

# Put a finished temporary file in place of an env file by renaming it, so a
# reader never sees a partial file and a crash leaves the old one intact. Run
# as root (sudo), the new file keeps the owner of the one it replaces.
replace_env_file() {
  local file="$1" tmp="$2" owner
  if [[ "$(id -u)" -eq 0 && -e "$file" ]]; then
    owner="$(stat -c '%u:%g' "$file" 2>/dev/null || stat -f '%u:%g' "$file")" || { rm -f "$tmp"; die "Cannot read the owner of $file"; }
    chown "$owner" "$tmp" || { rm -f "$tmp"; die "Cannot set the owner of $tmp"; }
  fi
  mv -f "$tmp" "$file" || { rm -f "$tmp"; die "Cannot replace $file"; }
}

# Image pins belong to the release, not the site: keep every *_IMAGE in an .env
# equal to its template, so an .env copied from an older package or before a
# `make kafbat-ui` rebuild never sends Compose after an image that is not here.
# Other settings are left alone. To change a pin, edit the template, or export
# the variable in the shell for one run (Compose prefers it over the .env).
sync_image_pins() {
  local env_file="$1" template="$2" keys tmp
  [[ -f "$env_file" && -f "$template" ]] || return 0
  keys="$(awk -F= '
    NR == FNR { if ($1 ~ /^[A-Z0-9_]+_IMAGE$/) pin[$1] = substr($0, length($1) + 2); next }
    $1 in pin { cur[$1] = substr($0, length($1) + 2); seen[$1] = 1 }
    END { for (k in pin) if (!(k in seen) || cur[k] != pin[k]) print k }
  ' "$template" "$env_file" | LC_ALL=C sort | xargs)"
  [[ -n "$keys" ]] || return 0
  tmp="$(mktemp "$(dirname "$env_file")/${env_file##*/}.XXXXXX")" || die "Cannot create a temporary file beside $env_file"
  chmod 600 "$tmp"
  awk -F= '
    NR == FNR { if ($1 ~ /^[A-Z0-9_]+_IMAGE$/) pin[$1] = substr($0, length($1) + 2); next }
    $1 in pin { seen[$1] = 1; $0 = $1 "=" pin[$1] }
    { print }
    END { for (k in pin) if (!(k in seen)) print k "=" pin[k] }
  ' "$template" "$env_file" > "$tmp" || { rm -f "$tmp"; die "Cannot update image pins in $env_file"; }
  replace_env_file "$env_file" "$tmp"
  warn "Updated $keys in $env_file to match ${template##*/}" >&2
}

# A random secret of letters and digits (24 characters unless given), which
# neither .env quoting nor Compose interpolation alters.
random_secret() {
  local length="${1:-24}" secret=""
  while (( ${#secret} < length )); do
    secret+="$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9')"
  done
  echo "${secret:0:length}"
}

# Set KEY=VALUE in an env file, replacing its line or appending one. The new
# content is written to a temporary file beside the target (mode 600) and
# renamed over it, so a reader never sees a partial file and a crash leaves
# the old one intact.
set_env_file_value() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$(mktemp "$(dirname "$file")/${file##*/}.XXXXXX")" || die "Cannot create a temporary file beside $file"
  chmod 600 "$tmp"
  # Passed through the environment: awk -v would expand backslashes in values.
  KRATE_KEY="$key" KRATE_VALUE="$value" awk -F= '
    BEGIN { key = ENVIRON["KRATE_KEY"]; value = ENVIRON["KRATE_VALUE"] }
    $1 == key { if (!done) print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }
  ' "$file" > "$tmp" || { rm -f "$tmp"; die "Cannot update $key in $file"; }
  replace_env_file "$file" "$tmp"
}

# Whether a named volume of a Compose project exists.
compose_volume_exists() {
  [[ -n "$(docker volume ls -q --filter "label=com.docker.compose.project=$1" \
    --filter "label=com.docker.compose.volume=$2" 2>/dev/null)" ]]
}

# Fill each KEY whose value in an env file is still a placeholder (empty,
# REPLACE_ME, or the old template default changeme) with a random secret of
# the given length, and print the keys filled. Values a site set are never
# changed. Callers refuse a changeme that is already live (a started Kafbat
# UI, an existing Grafana volume) before this runs, so it never replaces a
# value in use and never lets the insecure default through either.
fill_secrets() {
  local file="$1" length="$2" key
  shift 2
  for key in "$@"; do
    case "$(env_value_file "$file" "$key")" in
      ""|REPLACE_ME|changeme) ;;
      *) continue ;;
    esac
    set_env_file_value "$file" "$key" "$(random_secret "$length")"
    echo "$key"
  done
}

# The Compose project, which names the cluster's network and data volumes. It
# is fixed (krate-<edition>) so the data never depends on the directory a
# package was unpacked to. Installations made before that were named after their
# directory; prepare records that name as KRATE_PROJECT so their data stays in use.
cluster_project() {
  local project="${KRATE_PROJECT:-}"
  [[ -n "$project" ]] || project="$(env_value KRATE_PROJECT)"
  echo "${project:-krate-${KRATE_VARIANT}}"
}

# Compose projects holding a volume of the given name.
volume_projects() {
  docker volume ls --filter "label=com.docker.compose.volume=$1" \
    --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | LC_ALL=C sort -u
}

# Compose projects other than the fixed one that hold this edition's data
# volumes: installations from before the project name was fixed. KRaft keeps
# Kafka data in volumes (the frozen ZooKeeper edition also has zookeeper-data);
# EPC keeps it on the host and has only the Keycloak database volume.
legacy_projects() {
  local marker=kafka-92-data other=zookeeper-data
  if [[ "$KRATE_VARIANT" == epc ]]; then
    marker=keycloak_db_data other=kafka-92-data
  fi
  LC_ALL=C comm -23 <(volume_projects "$marker") <(volume_projects "$other") | grep -vx "krate-${KRATE_VARIANT}" || true
}

# Keep using the data volumes of an installation from before the fixed project
# name, so an update never starts on empty storage.
adopt_legacy_project() {
  local legacy running
  [[ -z "${KRATE_PROJECT:-}" && -z "$(env_value KRATE_PROJECT)" ]] || return 0
  legacy="$(legacy_projects | xargs)"
  # When this edition's containers exist, their project is the one being updated.
  running="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$BROKER_CONTAINER" 2>/dev/null || true)"
  # A broker already running in the fixed project is the installation in use:
  # a stale legacy volume must not switch Compose to another project.
  [[ "$running" != "krate-${KRATE_VARIANT}" ]] || return 0
  if [[ -n "$running" && " $legacy " == *" $running "* ]]; then
    legacy="$running"
  fi
  case "$legacy" in
    "") return 0 ;;
    *" "*) die "Several earlier installations hold data volumes: $legacy
Choose the one this installation uses: krate config set KRATE_PROJECT=<name>" ;;
  esac
  set_env_file_value "$ENV_FILE" KRATE_PROJECT "$legacy"
  ok "Using the existing data volumes of Compose project $legacy (KRATE_PROJECT in .env)"
}

# A package is being run from the directory it was extracted to, rather than
# from the installation directory or a source checkout.
is_package() {
  [[ -z "$REPO_DIR" && -d "$IMAGES_DIR" && "$SCRIPT_DIR" != "$(cd "$KRATE_HOME" 2>/dev/null && pwd)" ]]
}

# Create the installation directory, owned by the user running krate.
ensure_home_dir() {
  # Never chmod a symlink target through the privileged default install path.
  if [[ "$KRATE_HOME" == "/opt/krate/${KRATE_VARIANT:-}" ]] \
      && { [[ -L /opt/krate ]] || [[ -L "$KRATE_HOME" ]]; }; then
    die "Cannot use a symlink as the default installation directory: $KRATE_HOME"
  fi
  local -a sudo_cmd=()
  if [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    sudo_cmd=(sudo)
  fi
  if ! { mkdir -p "$KRATE_HOME" 2>/dev/null && [[ -w "$KRATE_HOME" ]]; }; then
    info "Creating the installation directory $KRATE_HOME"
    if ! { "${sudo_cmd[@]}" mkdir -p "$KRATE_HOME" && "${sudo_cmd[@]}" chown "$(id -u):$(id -g)" "$KRATE_HOME"; }; then
      die "Could not create $KRATE_HOME. Create it, or install elsewhere: KRATE_HOME=/path ./krate install"
    fi
  fi
  # The default location is bind-mounted into unprivileged containers. A first
  # install under umask 077 needs traversal, but directory listings and site
  # files stay private. Do not change operator-selected KRATE_HOME paths.
  if [[ "$KRATE_HOME" == "/opt/krate/${KRATE_VARIANT:-}" ]] \
      && ! "${sudo_cmd[@]}" chmod go+x /opt/krate "$KRATE_HOME"; then
    die "Could not make $KRATE_HOME traversable by the containers"
  fi
}

# Copy the site files of an earlier installation, or ones made by hand in the
# package directory, into the installation when it does not have them yet:
# .env, monitoring/.env, certs/, SSO files under auth/ and monitoring/auth/,
# and sso/site*.json. Existing files are never replaced.
import_site_files() {
  local src="$1" f
  [[ -d "$src" && "$(cd "$src" && pwd)" != "$(cd "$KRATE_HOME" && pwd)" ]] || return 0
  ( cd "$src" && { for f in .env monitoring/.env; do [[ -f "$f" ]] && echo "$f"; done
      find certs auth monitoring/auth -type f 2>/dev/null
      find sso -maxdepth 1 -type f -name 'site*.json' 2>/dev/null; } ) | while IFS= read -r f; do
    [[ -e "$KRATE_HOME/$f" ]] && continue
    mkdir -p "$KRATE_HOME/$(dirname "$f")"
    cp -p "$src/$f" "$KRATE_HOME/$f"
    echo "$f"
  done
}

# Install this package's release files into KRATE_HOME, replacing the previous
# release's. Site files are not part of a package and are never overwritten.
# Images were loaded from the package and are not copied. On a first install,
# site files come from --from DIR, the package directory or the directory the
# running (or stopped) cluster was started from.
deploy_release() {
  local from="$1" taken previous work
  ensure_home_dir
  work="$(mktemp -d)" || die "Cannot create a temporary directory"
  # The release archive is written once, listed, then extracted: the listing is exactly
  # what was copied. Site files, every .env.* beside .env (the temporary copies an
  # interrupted krate run leaves, mode 600 with the full .env contents, and operator
  # backups such as .env.bak) and sealed identity backups are not release files; the
  # template is copied on its own below. Any other file an operator drops into the
  # package directory is treated as a release file (copied, world-readable).
  if ! ( cd "$SCRIPT_DIR" && tar -cf - --exclude=./images --exclude=./docker-offline --exclude=./.env \
      --exclude=./certs --exclude=./auth --exclude=./monitoring/.env --exclude=./monitoring/auth \
      --exclude='./sso/site*.json' --exclude='./.env.*' --exclude='./monitoring/.env.*' \
      --exclude='.identity-backup.*' --exclude='.krate-ui-*' --exclude='__pycache__' --exclude='*.pyc' . ) > "$work/release.tar" \
    || ! tar -tf "$work/release.tar" > "$work/release.list" \
    || ! ( cd "$KRATE_HOME" && tar -xf "$work/release.tar" ); then
    rm -rf "$work"
    die "Could not copy the release files to $KRATE_HOME"
  fi
  # The container users (kafkaui, nginx, grafana) read these files through bind mounts:
  # an operator umask of 077 or 027 at extraction would leave them unreadable. Only the
  # paths the release archive contained are widened (an allow-list): site files, secrets
  # and anything else in KRATE_HOME (an identity backup, a leftover temporary) keep their modes.
  if ! ( cd "$KRATE_HOME" && tr '\n' '\0' < "$work/release.list" | xargs -0 chmod go+rX ); then
    rm -rf "$work"
    die "Could not set read permissions on the release files in $KRATE_HOME"
  fi
  rm -rf "$work"
  # The templates are release files that the .env.* exclusion above also matched.
  if ! { cp "$SCRIPT_DIR/.env.template" "$KRATE_HOME/.env.template" && chmod 644 "$KRATE_HOME/.env.template" \
      && mkdir -p "$KRATE_HOME/monitoring" && cp "$SCRIPT_DIR/monitoring/.env.template" "$KRATE_HOME/monitoring/.env.template" \
      && chmod 644 "$KRATE_HOME/monitoring/.env.template"; }; then
    die "Could not copy the .env templates to $KRATE_HOME"
  fi
  mkdir -p "$KRATE_HOME/auth/ui" "$KRATE_HOME/auth/keycloak/truststores"
  chmod go+rx "$KRATE_HOME/auth" "$KRATE_HOME/auth/ui" "$KRATE_HOME/auth/keycloak" "$KRATE_HOME/auth/keycloak/truststores"
  cp "$SCRIPT_DIR/auth/ui/local.yml" "$KRATE_HOME/auth/ui/local.yml"
  chmod 644 "$KRATE_HOME/auth/ui/local.yml"
  if [[ -f "$SCRIPT_DIR/monitoring/auth/local.ini" ]]; then
    mkdir -p "$KRATE_HOME/monitoring/auth"
    chmod go+rx "$KRATE_HOME/monitoring" "$KRATE_HOME/monitoring/auth"
    cp "$SCRIPT_DIR/monitoring/auth/local.ini" "$KRATE_HOME/monitoring/auth/local.ini"
    chmod 644 "$KRATE_HOME/monitoring/auth/local.ini"
  fi
  ok "Installed $(basename "$SCRIPT_DIR") into $KRATE_HOME"

  if [[ -n "$from" ]]; then
    [[ -f "$from/.env" ]] || die "--from $from has no .env"
  elif [[ -f "$SCRIPT_DIR/.env" ]]; then
    from="$SCRIPT_DIR"
  elif [[ ! -f "$KRATE_HOME/.env" ]]; then
    previous="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' "$BROKER_CONTAINER" 2>/dev/null || true)"
    [[ -n "$previous" && -f "$previous/.env" ]] && from="$previous"
  fi
  [[ -n "$from" ]] || return 0
  taken="$(import_site_files "$from" | xargs)"
  if [[ -n "$taken" ]]; then
    ok "Took over from $from: $taken"
  fi
}

# The old template default `changeme` is a placeholder only while nothing uses
# it: Kafbat reads KAFKA_UI_PASSWORD at every container start, so once a UI
# container exists the value is live and must be changed deliberately. Before
# that, it is cleared so a password gets generated like any other placeholder.
refuse_live_changeme() {
  [[ "$(env_value KAFKA_UI_PASSWORD)" == changeme ]] || return 0
  local existing
  existing="$(docker ps -aq --filter "label=com.docker.compose.project=$(cluster_project)" \
    --filter "label=com.docker.compose.service=kafka-ui")" || die "Cannot ask Docker whether the Kafbat UI exists; is the Docker daemon running?"
  if [[ -n "$existing" ]]; then
    die "KAFKA_UI_PASSWORD is changeme (insecure) and the Kafbat UI was started with it.
Set a new password: krate config set KAFKA_UI_PASSWORD=<value>
or empty it so krate generates one: krate config set KAFKA_UI_PASSWORD=
then: krate start"
  fi
  set_env_file_value "$ENV_FILE" KAFKA_UI_PASSWORD ""
  warn "KAFKA_UI_PASSWORD was the template default changeme; generating a password instead"
}

# Passwords and secrets of the cluster .env. Keycloak keeps its admin, database
# and client secrets from its first start, so those are generated only while
# its database is known to be pristine; when that cannot be told, the cluster
# still starts and `krate identity up` reports the reason. The secret
# PingFederate issued (PING_KEYCLOAK_CLIENT_SECRET) is asked for by
# `krate auth apply`.
generate_secrets() {
  local keys=(KAFKA_UI_PASSWORD) generated state
  refuse_live_changeme
  state="$(identity_state)" || exit 1
  case "${state%% *}" in
    pristine) keys+=("${IDENTITY_KEYS[@]}") ;;
    existing) ;;
    *) warn "Identity secrets not generated: ${state#unknown }" ;;
  esac
  generated="$(fill_secrets "$ENV_FILE" 24 "${keys[@]}" | xargs)"
  if [[ -n "$generated" ]]; then
    ok "Generated $generated in .env"
  fi
}

# monitoring/.env: created from its template, image pins kept current, and its
# passwords and keys generated. Grafana keeps the admin password from its first
# start, so that one is generated only before Grafana's volume exists.
prepare_monitor_env() {
  local env_file="$MONITOR_DIR/.env" keys=(PERSES_ADMIN_PASSWORD) generated
  if [[ ! -f "$env_file" ]]; then
    cp "$MONITOR_DIR/.env.template" "$env_file"
    ok "Created monitoring/.env from its template"
  fi
  chmod 600 "$env_file"
  sync_image_pins "$env_file" "$MONITOR_DIR/.env.template"
  if ! compose_volume_exists "krate-${KRATE_VARIANT}-monitoring" grafana_data; then
    # No Grafana data yet: the old template default is not in use anywhere, so
    # it is a placeholder and a password gets generated.
    if [[ "$(env_value_file "$env_file" GRAFANA_PASSWORD)" == changeme ]]; then
      set_env_file_value "$env_file" GRAFANA_PASSWORD ""
      warn "GRAFANA_PASSWORD was the template default changeme; generating a password instead"
    fi
    keys+=(GRAFANA_PASSWORD)
  else
    # Grafana keeps the password its volume was created with; .env cannot
    # change it, so say what is in use rather than generate a value in vain.
    case "$(env_value_file "$env_file" GRAFANA_PASSWORD)" in
      "") warn "GRAFANA_PASSWORD is empty but Grafana's volume exists: its stored password stays in use. Record it with: krate config set GRAFANA_PASSWORD=..." ;;
      changeme) warn "GRAFANA_PASSWORD is changeme (insecure) and Grafana's volume exists: change it in Grafana, then record it with: krate config set GRAFANA_PASSWORD=..." ;;
    esac
  fi
  if [[ "$(env_value_file "$env_file" PERSES_IDP)" == krate ]]; then
    keys+=(OAUTH2_PROXY_CLIENT_SECRET PERSES_SYNC_CLIENT_SECRET)
  fi
  generated="$({ fill_secrets "$env_file" 24 "${keys[@]}"
    fill_secrets "$env_file" 32 PERSES_ENCRYPTION_KEY OAUTH2_PROXY_COOKIE_SECRET; } | xargs)"
  if [[ -n "$generated" ]]; then
    ok "Generated $generated in monitoring/.env"
  fi
}

# GNU Make 4+ runs the build (macOS's make is 3.81; Homebrew installs gmake).
make_cmd() {
  local bin major
  for bin in gmake make; do
    command -v "$bin" >/dev/null 2>&1 || continue
    major="$("$bin" --version 2>/dev/null | sed -n '1s/^GNU Make \([0-9][0-9]*\)\..*/\1/p')"
    if [[ -n "$major" ]] && (( major >= 4 )); then
      echo "$bin"
      return 0
    fi
  done
  die "Building needs GNU Make 4.0 or newer (on macOS: brew install make)."
}

host_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) die "Unsupported processor: $(uname -m)" ;;
  esac
}

# ─── setup: the one preparation step ─────────────────────────────────────────
# Every command that creates containers (start, install, auth apply, monitor
# up) runs this first, so nothing is copied or edited by hand: both settings
# files, image pins, every generated password and secret, the TLS certificate
# and, in a source checkout, the Kafbat UI image. It only fills what is
# missing, and never changes a value the site set.
prepare() {
  require_compose; require_compose_file
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_TEMPLATE" ]] || die ".env.template not found in $SCRIPT_DIR"
    cp "$ENV_TEMPLATE" "$ENV_FILE"
    ok "Created .env from .env.template"
  fi
  chmod 600 "$ENV_FILE"
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  adopt_legacy_project
  # Any `up` creates the identity network; refuse a subnet clash here, not with Docker's raw error.
  identity_network_clash "${KRATE_COMMAND:-start}"
  generate_secrets
  if [[ -d "$MONITOR_DIR" ]]; then
    prepare_monitor_env
  fi
  ensure_cert
  sync_proxy_env "$(env_value KAFKA_UI_AUTH_CONFIG)"
  ensure_ui_image
}

cmd_setup() {
  step "Krate setup"
  prepare
  ok "Ready. Start with: krate start   Logins: krate credentials"
}

# A source checkout runs the Kafbat UI image it builds itself; build it when
# the pinned one is not on this host. Packages ship the image instead.
ensure_ui_image() {
  local image
  image="$(env_value KAFKA_UI_IMAGE)"
  [[ "$image" == krate/kafka-ui:*@sha256:* ]] || return 0
  docker image inspect "${image##*@}" >/dev/null 2>&1 && return 0
  [[ -n "$REPO_DIR" ]] || die "Kafbat UI image $image is not on this host; install from a package that includes it."
  warn "Kafbat UI image $image is not on this host; building it."
  cmd_build
}

# Build the Kafbat UI image for this host from a source checkout.
cmd_build() {
  [[ -n "$REPO_DIR" ]] || die "krate build runs in a source checkout; a package already contains the image."
  require_docker
  local make
  make="$(make_cmd)"
  info "Building the Kafbat UI image (several minutes; needs Git, Node.js, npm and internet access)..."
  "$make" -C "$REPO_DIR" kafbat-ui ARCH="$(host_arch)"
  # The build pins the new image ID in .env.template; carry it into .env.
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  ok "Kafbat UI image built"
}

# Build this edition's offline install package from a source checkout: the
# Kafbat UI image, Docker OS packages for the target and every pinned image.
cmd_package() {
  [[ -n "$REPO_DIR" ]] || die "krate package runs in a source checkout."
  local version="${1:-}" arch="${2:-}" target_os="${3:-auto}" make
  [[ "$version" =~ ^v[0-9]+$ ]] || die "Usage: krate package <vN> [amd64|arm64] [auto|none|noble|jammy|rhel9]"
  [[ -n "$arch" ]] || arch="$(host_arch)"
  require_docker
  make="$(make_cmd)"
  MAKE="$make" "$REPO_DIR/scripts/package-release.sh" "$KRATE_VARIANT" "$version" "$arch" "$target_os"
  ok "Package written to $REPO_DIR/dist/release/package-${KRATE_VARIANT}-${version}/"
}

# Every login of this installation, in one place.
cmd_credentials() {
  cmd_ui
  if [[ -f "$MONITOR_DIR/.env" ]]; then
    echo -e "${BOLD}  Monitoring${RESET}"
    sep
    monitor_logins | sed 's/^/  /'
    sep
  fi
  if identity_profile_enabled; then
    echo -e "${BOLD}  Keycloak admin${RESET}"
    sep
    echo "  Console   not published: the proxy answers 404 for $(env_value KEYCLOAK_PUBLIC_URL)/admin/ (use krate identity ... or kcadm from the host)"
    echo "  Username  $(env_value KEYCLOAK_ADMIN_USER)"
    echo "  Password  $(env_value KEYCLOAK_ADMIN_PASSWORD)"
    sep
  fi
  echo -e "  ${DIM}Stored in .env and monitoring/.env (mode 600). Change one with: krate config set KEY=VALUE${RESET}"
}

# A source checkout pins the locally built Kafbat UI image (make kafbat-ui) as
# krate/kafka-ui:...@<image ID>. That image has no registry digest, and Docker's
# classic image store resolves name@digest only against registry digests, so
# pass Compose the bare image ID. Packages use krate-offline tags instead.
resolve_local_ui_image() {
  local action="${1:-}" arg targeted=true
  local -a services=()
  # `up` of named services that leave out kafka-ui does not need its image.
  for arg in "${@:2}"; do
    [[ "$arg" == -* ]] || services+=("$arg")
  done
  if [[ "$action" == up && ${#services[@]} -gt 0 ]]; then
    targeted=false
    for arg in "${services[@]}"; do
      if [[ "$arg" == kafka-ui ]]; then targeted=true; fi
    done
  fi
  # A set KAFKA_UI_IMAGE, even an empty one, overrides .env for Compose.
  local image
  if [[ -n "${KAFKA_UI_IMAGE+set}" ]]; then
    image="$KAFKA_UI_IMAGE"
  else
    image="$(env_value KAFKA_UI_IMAGE)"
  fi
  [[ "$image" == krate/kafka-ui:*@sha256:* ]] || return 0
  docker image inspect "$image" >/dev/null 2>&1 && return 0
  if docker image inspect "${image##*@}" >/dev/null 2>&1; then
    export KAFKA_UI_IMAGE="${image##*@}"
  elif [[ "$action" == up ]] && $targeted; then
    # Compose would try Docker Hub, where this locally built image never exists.
    die "Kafbat UI image $image is not built on this host. Build it from the repository root: make kafbat-ui"
  fi
}

# Wrapper so all compose calls use the right files and detected binary. The
# sso profile (Keycloak and its database) joins the cluster once identity is
# enabled or Kafbat is in runtime.yml mode.
compose_cmd() {
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  resolve_local_ui_image "$@"
  if [[ -f "$ENV_FILE" ]] && identity_profile_enabled; then
    require_sso_compose
    local with_sso=true
    if [[ "${1:-}" == up ]]; then
      # Until `krate identity up` has made the site files (Compose bind-mounts
      # them; were they missing, Docker would create root-owned directories in
      # their place) and the database, the brokers start without identity.
      local f
      for f in auth/keycloak/krate-realm.json auth/keycloak/db-tls/ca.crt; do
        [[ -f "$SCRIPT_DIR/$f" ]] || with_sso=false
      done
      if $with_sso && [[ "$(identity_state)" == pristine ]]; then with_sso=false; fi
      if ! $with_sso; then
        if [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "runtime.yml" ]]; then
          die "Kafbat UI is in runtime.yml mode and needs Keycloak. Run: krate identity up"
        fi
        warn "Identity services skipped (run: krate identity up)"
      fi
      if [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "runtime.yml" ]]; then
        "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" --profile sso config --format json | python3 "$(sso_dir)/preflight.py" --directory "$SCRIPT_DIR" --mode runtime.yml
        shift
        set -- up --pull never --no-build "$@"
      fi
    fi
    if $with_sso; then
      set -- --profile sso "$@"
      if [[ "$(env_value IDP_WATCH_ENABLED)" == true && -f "$SCRIPT_DIR/$IDENTITY_IDP_PLAN" ]]; then
        set -- --profile idp-watch "$@"
      fi
    fi
  fi
  KRATE_SSO_DIR="$(sso_dir)" "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

# The shape of the client secret PingFederate issues: taken as issued, except
# for whitespace and the characters .env quoting, Compose interpolation ($) and
# the shell would alter. Every path that stores the secret goes through it.
ping_secret_valid() {
  [[ ${#1} -ge 16 ]] || return 1
  ! printf '%s' "$1" | LC_ALL=C grep -q -E '[^!-~]|[\\$"'"'"'`]'
}
PING_SECRET_RULE="must be at least 16 printable ASCII characters without spaces, quotes, backslash, backtick or \$ (as issued by PingFederate)"

# The one secret that cannot be generated: PingFederate issues it for Keycloak.
# Ask for it when SSO is applied interactively; otherwise say how to set it.
ensure_ping_secret() {
  local secret
  case "$(env_value PING_KEYCLOAK_CLIENT_SECRET)" in
    ""|REPLACE_ME) ;;
    *) return 0 ;;
  esac
  [[ -t 0 ]] || die "Set the client secret PingFederate issued for Keycloak without a terminal: krate identity rotate PING_KEYCLOAK_CLIENT_SECRET --value (reads it from stdin)"
  read -rsp "  Client secret PingFederate issued for Keycloak: " secret
  echo ""
  ping_secret_valid "$secret" || die "PING_KEYCLOAK_CLIENT_SECRET $PING_SECRET_RULE"
  set_env_file_value "$ENV_FILE" PING_KEYCLOAK_CLIENT_SECRET "$secret"
  ok "Saved PING_KEYCLOAK_CLIENT_SECRET in .env"
}

# Kafbat's cluster names for the RBAC roles: from kafbat.yml when the edition
# has one beside the CLI (EPC; Spring placeholders resolved from .env), else
# from the Compose file's KAFKA_CLUSTERS_<n>_NAME entries. One name per line.
ui_clusters() {
  python3 - "$SCRIPT_DIR/kafbat.yml" "$COMPOSE_FILE" "$ENV_FILE" <<'PY'
import os, re, sys
kafbat, compose, env_file = sys.argv[1:4]
env = {}
for line in open(env_file):
    key, sep, value = line.strip().partition('=')
    if sep and not key.startswith('#'):
        env[key.strip()] = value.strip().strip('"\'')
if os.path.isfile(kafbat):
    # Only the items of kafka.clusters count: track indentation so a `- name:` inside a
    # cluster's own lists (schema registry, connect, ksqldb) is not taken for a cluster.
    names, in_clusters, item_indent = [], False, None
    for line in open(kafbat):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        indent = len(line) - len(line.lstrip())
        if re.match(r'^\s*clusters:\s*$', line):
            in_clusters, clusters_indent, item_indent = True, indent, None
            continue
        if in_clusters:
            if indent <= clusters_indent:
                in_clusters = False
                continue
            m = re.match(r'^\s*-\s*name:\s*"?([^"\n]+?)"?\s*$', line)
            if m and (item_indent is None or indent == item_indent):
                item_indent = indent
                names.append(re.sub(r'\$\{([A-Za-z_][A-Za-z0-9_]*)(?::([^}]*))?\}', lambda x: env.get(x.group(1)) or x.group(2) or '', m.group(1)))
else:
    names = re.findall(r'^\s*KAFKA_CLUSTERS_\d+_NAME:\s*"?([^"\n]+?)"?\s*$', open(compose).read(), re.M)
print('\n'.join(names))
PY
}

# Derived .env values and the certificate check shared by both configure paths.
auth_configure_host() {
  local public_url="$1" host fqdn
  if [[ -z "$(env_value KAFKA_UI_FQDN)" ]]; then
    host="${public_url#*://}"
    host="${host%%[:/]*}"
    set_env_file_value "$ENV_FILE" KAFKA_UI_FQDN "$host"
    ok "Set KAFKA_UI_FQDN=$host in .env"
  fi
  fqdn="$(get_fqdn)"
  if [[ -f "$CERT_CRT" ]] && ! openssl x509 -in "$CERT_CRT" -noout -checkhost "$fqdn" 2>/dev/null | grep -q 'does match'; then
    warn "certs/server.crt does not cover $fqdn. Install the CA-issued certificate and key in certs/, or run: krate gen-cert"
  fi
  echo ""
  info "Next: krate config set KAFKA_UI_AUTH_CONFIG=runtime.yml, then krate auth apply (Keycloak must be running: krate identity up)"
}

# Plan Kafbat's Keycloak login, auth/ui/runtime.yml. Without a settings file
# the realm is the only issuer (local Keycloak users): the plan is a pure
# function of .env and this edition's cluster list, written by sso/identity.py.
# With a PingFederate settings file the same plan is written together with the
# identity-provider plan (applied to the realm in the SSO phase).
auth_configure() {
  local sso_dir="$1" settings="" force=false viewer_messages="" arg public_url
  shift
  for arg in "$@"; do
    case "$arg" in
      --force) force=true ;;
      --viewer-messages) viewer_messages=true ;;
      --no-viewer-messages) viewer_messages=false ;;
      --local) ;;
      -*) die "Usage: krate auth configure [settings.json] [--force] [--viewer-messages|--no-viewer-messages]" ;;
      *) [[ -z "$settings" ]] || die "Usage: krate auth configure [settings.json] [--force] [--viewer-messages|--no-viewer-messages]"
         settings="$arg" ;;
    esac
  done
  require_env
  ensure_identity_dirs
  if [[ "$viewer_messages" == true && "$(env_value KAFKA_UI_VIEWER_MESSAGES)" != true ]]; then
    set_env_file_value "$ENV_FILE" KAFKA_UI_VIEWER_MESSAGES true
    ok "Set KAFKA_UI_VIEWER_MESSAGES=true in .env (viewers may read message payloads)"
  elif [[ "$viewer_messages" == false && "$(env_value KAFKA_UI_VIEWER_MESSAGES)" == true ]]; then
    set_env_file_value "$ENV_FILE" KAFKA_UI_VIEWER_MESSAGES false
    ok "Set KAFKA_UI_VIEWER_MESSAGES=false in .env (viewers no longer read message payloads)"
  fi
  if [[ -n "$settings" ]]; then
    [[ -f "$settings" ]] || die "Settings file not found: $settings"
    if $force; then
      die "--force replaces the local plan only; remove auth/ui/runtime.yml and auth/keycloak/pingfederate-idp.json before rerunning with a settings file"
    fi
    python3 "$sso_dir/configure-dual.py" --settings "$settings" --env-file "$ENV_FILE" --output-dir "$SCRIPT_DIR/auth"
    # Derive the .env values that follow from public_url instead of asking for them.
    public_url="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["public_url"].rstrip("/"))' "$settings")"
    set_env_file_value "$ENV_FILE" KEYCLOAK_PUBLIC_URL "$public_url/identity"
    ok "Set KEYCLOAK_PUBLIC_URL=$public_url/identity in .env"
  else
    local -a clusters=() args=()
    mapfile -t clusters < <(ui_clusters)
    [[ ${#clusters[@]} -gt 0 ]] || die "No Kafbat cluster name found in $SCRIPT_DIR/kafbat.yml or ${COMPOSE_FILE##*/}"
    args=(runtime --env-file "$ENV_FILE" --clusters "${clusters[@]}" --output "$SCRIPT_DIR/auth/ui/runtime.yml")
    if $force; then args+=(--force); fi
    python3 "$sso_dir/identity.py" "${args[@]}"
    public_url="$(env_value KEYCLOAK_PUBLIC_URL)"
    public_url="${public_url%/}"
    public_url="${public_url%/identity}"
  fi
  auth_configure_host "$public_url"
}

cmd_auth() {
  local action="${1:-}" sso_dir
  sso_dir="$(sso_dir)"
  shift || true
  case "$action" in
    configure) auth_configure "$sso_dir" "$@" ;;
    apply)
      [[ -f "$sso_dir/activate.sh" ]] || die "Missing packaged SSO activation helper"
      prepare
      # PingFederate's secret is needed only once its identity-provider plan exists.
      if [[ -f "$SCRIPT_DIR/auth/keycloak/pingfederate-idp.json" ]]; then ensure_ping_secret; fi
      # shellcheck disable=SC1091
      source "$sso_dir/activate.sh"
      apply_auth "$sso_dir"
      ;;
    *) die "Usage: krate auth {configure [settings.json] [--force] [--viewer-messages|--no-viewer-messages]|apply}" ;;
  esac
}

# ─── identity (Keycloak and its database) ─────────────────────────────────────
# Keycloak holds the site's users and runs under the sso Compose profile beside
# the brokers, but is managed on its own: these commands need no broker. The
# database volume keycloak_db_data is the authoritative store; .env carries the
# credentials Keycloak and its database were initialised with, so the identity
# secrets are generated only before that database exists and changed later
# through `krate identity rotate`, which updates both sides.
IDENTITY_KEYS=(KEYCLOAK_ADMIN_PASSWORD KEYCLOAK_DB_PASSWORD KEYCLOAK_KAFBAT_CLIENT_SECRET KEYCLOAK_CLI_CLIENT_SECRET KEYCLOAK_IDP_WATCH_CLIENT_SECRET)
IDENTITY_REALM=krate
# Required actions a local user gets from `identity users add` and `reset-password`
# (identity.USER_REQUIRED_ACTIONS): the authenticator is enrolled and the temporary
# password replaced at the first login. Not realm defaults: those would also apply
# to users PingFederate brokers in.
IDENTITY_USER_ACTIONS='["CONFIGURE_TOTP","UPDATE_PASSWORD"]'
IDENTITY_IDP_PLAN=auth/keycloak/pingfederate-idp.json
IDENTITY_IDP_ALIAS=pingfederate
IDENTITY_IDP_CHANGES=()
IDENTITY_TIMEOUT=180
IDENTITY_LOCK=""
IDENTITY_TMPDIR=""
IDENTITY_CHANGED=false
KCADM_SERVER=http://localhost:8080/identity
KCADM_CID=""
KCADM_CONFIG=""

# The SSO helpers sit beside the CLI in a package and at the root of a checkout.
sso_dir() {
  local dir="$SCRIPT_DIR/sso"
  [[ -d "$dir" ]] || dir="$SCRIPT_DIR/../sso"
  echo "$dir"
}

ui_dir() {
  local dir="$SCRIPT_DIR/ui"
  [[ -d "$dir" ]] || dir="$SCRIPT_DIR/../ui"
  [[ -d "$dir" ]] || die "ui directory not found in $SCRIPT_DIR/ui or $SCRIPT_DIR/../ui"
  echo "$dir"
}

require_sso_compose() {
  local version
  version="$(get_compose_version)"
  version_gte "$version" "2.20.2" || die "SSO requires Docker Compose 2.20.2 or newer; found $version. Install the packaged Compose plugin."
}

# The sso profile is part of the cluster once identity is enabled, or while
# Kafbat is in runtime.yml mode (its SSO login needs Keycloak).
identity_profile_enabled() {
  [[ "$(env_value KEYCLOAK_ENABLED)" == true || "$(env_value KAFKA_UI_AUTH_CONFIG)" == runtime.yml ]]
}

# Lifecycle commands reach the identity containers once the profile is on, so
# they hold the identity lock: none of them can stop or recreate Keycloak or
# its database while backup, restore, rotate or recover-admin is running.
identity_lock_if_enabled() {
  [[ -f "$ENV_FILE" ]] || return 0
  # KEYCLOAK_ENABLED turns true only at the end of the first `identity up`, so the
  # profile flag alone would let `stop`/`uninstall` run while a bootstrap is in
  # progress: also take the lock while an identity command holds it or the
  # database volume exists (identity_lock refuses while another process is live).
  if identity_profile_enabled || [[ -d "$SCRIPT_DIR/auth/.identity.lock" ]] || identity_volume_present; then identity_lock; fi
}

identity_volume_present() {
  docker volume inspect "$(cluster_project)_keycloak_db_data" >/dev/null 2>&1
}

# Compose with the sso profile always on, so the identity services can be
# addressed before KEYCLOAK_ENABLED is set (identity up sets it last).
identity_compose() {
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
  resolve_local_ui_image
  local -a prof=(--profile sso)
  if [[ "$(env_value IDP_WATCH_ENABLED)" == true && -f "$SCRIPT_DIR/$IDENTITY_IDP_PLAN" ]]; then
    prof+=(--profile idp-watch)
  fi
  KRATE_SSO_DIR="$(sso_dir)" "${COMPOSE_BIN[@]}" -p "$(cluster_project)" --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "${prof[@]}" "$@"
}

# Container ID of an identity service (running or not); empty when none.
identity_container() {
  identity_compose ps -a -q "$1" 2>/dev/null | head -1 || true
}

# Docker state of a container ID: running, exited, ... or absent.
container_status() {
  [[ -n "$1" ]] || { echo absent; return 0; }
  docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null || echo absent
}

# Health of a container ID (its state when it has no healthcheck), or absent.
container_health() {
  [[ -n "$1" ]] || { echo absent; return 0; }
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$1" 2>/dev/null || echo absent
}

# Die unless the packaged image of every given service is loaded.
require_service_images() {
  local listing service image
  listing="$(identity_compose config --format json | python3 -c '
import json, sys
services = json.load(sys.stdin)["services"]
for name in sys.argv[1:]:
    print(name, services[name]["image"])' "$@")" || die "Cannot read the images of: $*"
  while read -r service image; do
    [[ -n "$service" ]] || continue
    docker image inspect "$image" >/dev/null 2>&1 \
      || die "Packaged image for $service is missing; run krate load-images first (in a checkout: docker pull $image)"
  done <<< "$listing"
}

# Whether Keycloak's database exists. Prints one line: pristine (no volume and
# no keycloak-db container; the first start imports the realm and creates the
# bootstrap admin), existing, or "unknown <reason>" when Docker could not be
# asked or a keycloak_db_data volume of another Compose project might be the
# one in use. A missing volume name alone is never taken as "empty". The
# other edition's fixed project and monitoring stacks keep volumes of their
# own and are not counted. No side effects: a legacy project is adopted by
# the caller (adopt_legacy_project) before this is asked.
identity_state() {
  local project projects other container ignore=krate-epc
  [[ "$KRATE_VARIANT" == kraft ]] || ignore=krate-kraft
  project="$(cluster_project)"
  if ! projects="$(docker volume ls --filter label=com.docker.compose.volume=keycloak_db_data \
      --format '{{.Label "com.docker.compose.project"}}' | LC_ALL=C sort -u)"; then
    echo "unknown docker volume ls failed; is the Docker daemon running?"
    return 0
  fi
  other="$(printf '%s\n' "$projects" | grep -v '^$' | grep -vx "$project" | grep -vx "$ignore" \
    | grep -v -- '-monitoring$' | xargs || true)"
  if [[ -n "$other" ]]; then
    echo "unknown a keycloak_db_data volume also exists in Compose project(s) $other while this installation is $project; use it with krate config set KRATE_PROJECT=<name>, or remove it"
    return 0
  fi
  container="$(docker ps -aq --filter "label=com.docker.compose.project=$project" \
    --filter "label=com.docker.compose.service=keycloak-db" 2>/dev/null | head -1 || true)"
  if printf '%s\n' "$projects" | grep -qx "$project" || [[ -n "$container" ]]; then
    echo existing
  else
    echo pristine
  fi
}

# Refuse to create the identity network on an address range another Docker
# network already covers: Docker would reject the second network, and the
# proxy's fixed address (KC_PROXY_TRUSTED_ADDRESSES) would belong to someone
# else. Networks of this Compose project are the ones Compose manages here and
# are skipped; every other network counts (another project, Docker's own
# bridge, networks made by hand). Dies naming the network and both .env keys.
identity_network_clash() {
  local subnet project listing clash
  local -a ids=()
  subnet="$(env_value KRATE_IDENTITY_SUBNET)"
  subnet="${subnet:-172.29.250.0/24}"
  project="$(cluster_project)"
  listing="$(docker network ls -q)" || die "Cannot list Docker networks; is the Docker daemon running?"
  [[ -n "$listing" ]] || return 0
  mapfile -t ids <<< "$listing"
  # One line per network: name, Compose project (or -), its IPAM subnets.
  clash="$(docker network inspect -f '{{.Name}} {{or (index .Labels "com.docker.compose.project") "-"}} {{range .IPAM.Config}}{{.Subnet}} {{end}}' "${ids[@]}" 2>/dev/null \
    | python3 -c '
import ipaddress, sys
wanted = ipaddress.ip_network(sys.argv[1], strict=False)
for line in sys.stdin:
    name, owner, *subnets = line.split()
    if owner == sys.argv[2]:
        continue
    for subnet in subnets:
        try:
            if wanted.overlaps(ipaddress.ip_network(subnet, strict=False)):
                print(name, subnet, "(no Compose project)" if owner == "-" else "(Compose project " + owner + ")")
                sys.exit(0)
        except (ValueError, TypeError):
            continue
' "$subnet" "$project")" || die "Cannot inspect the Docker networks for a clash with the identity subnet $subnet"
  [[ -n "$clash" ]] || return 0
  identity_journal "${1:-up}" refused "identity subnet $subnet overlaps Docker network ${clash%% *}"
  die "Docker network $clash overlaps the identity subnet $subnet (KRATE_IDENTITY_SUBNET).
Choose a free range and set both keys together, then run the command again:
  krate config set KRATE_IDENTITY_SUBNET=<cidr>
  krate config set KRATE_IDENTITY_PROXY_IP=<an address inside it>"
}

# One identity command at a time: a directory lock (a rename is atomic on
# every platform; macOS has no flock). The pid file is written into a private
# directory first, which is then renamed to the lock, so the lock never exists
# without its pid. A lock whose process is gone is stale.
identity_lock() {
  local dir="$SCRIPT_DIR/auth/.identity.lock" tmp pid mtime
  mkdir -p "$SCRIPT_DIR/auth"
  tmp="$dir.$$.tmp"
  rm -rf "$tmp"
  { mkdir "$tmp" && echo "$$" > "$tmp/pid"; } || { rm -rf "$tmp"; die "Cannot create the lock $dir"; }
  # The lock's age is read before the attempt: a refused rename touches it.
  mtime="$(stat -c %Y "$dir" 2>/dev/null || stat -f %m "$dir" 2>/dev/null || echo 0)"
  if ! identity_lock_rename "$tmp" "$dir"; then
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    if identity_lock_live "$pid" "$mtime"; then
      die "Another krate identity command is running (pid ${pid:-?}). Wait for it to finish."
    fi
    warn "Removing the stale identity lock left by process ${pid:-?}"
    rm -rf "$dir"
    { mkdir "$tmp" && echo "$$" > "$tmp/pid"; } || { rm -rf "$tmp"; die "Cannot create the lock $dir"; }
    identity_lock_rename "$tmp" "$dir" || die "Cannot create the lock $dir"
  fi
  IDENTITY_LOCK="$dir"
  trap identity_cleanup EXIT
}

# Rename the prepared directory to the lock. When the lock already exists, mv
# either fails or moves the directory inside it; both count as "held", and the
# prepared directory is removed.
identity_lock_rename() {
  local tmp="$1" dir="$2" inside="$2/${1##*/}"
  if mv "$tmp" "$dir" 2>/dev/null && [[ ! -d "$inside" ]]; then
    return 0
  fi
  rm -rf "$tmp" "$inside"
  return 1
}

# Whether a lock is held by a live process: its pid $1 exists (ps, which needs
# no permission to signal). A lock whose pid is not readable yet counts as
# live while its directory (modified at $2, epoch seconds) is younger than 60 s.
identity_lock_live() {
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    ps -p "$1" >/dev/null 2>&1
    return
  fi
  (( $(date +%s) - ${2:-0} < 60 ))
}

# A private working directory under auth/ (mode 700) for files that hold
# secrets while a command runs, in IDENTITY_TMPDIR; removed by the exit trap
# (so it is set here, never in a command substitution).
identity_tmpdir() {
  mkdir -p "$SCRIPT_DIR/auth"
  # Only one identity command runs at a time (the lock), so any work directory
  # found here was left by an interrupted run: it may hold secrets, remove it.
  rm -rf "$SCRIPT_DIR"/auth/.identity-work.??????
  IDENTITY_TMPDIR="$(mktemp -d "$SCRIPT_DIR/auth/.identity-work.XXXXXX")" || die "Cannot create a working directory under $SCRIPT_DIR/auth"
  chmod 700 "$IDENTITY_TMPDIR"
  trap identity_cleanup EXIT
}

identity_cleanup() {
  kcadm_logout
  if [[ -n "$IDENTITY_TMPDIR" ]]; then
    rm -rf "$IDENTITY_TMPDIR"
    IDENTITY_TMPDIR=""
  fi
  if [[ -n "$IDENTITY_LOCK" ]]; then
    rm -rf "$IDENTITY_LOCK"
    IDENTITY_LOCK=""
  fi
}

# Append-only record of identity operations: `<time> <command> <outcome>
# <detail>`. Details name keys, users and files, never a secret value.
identity_journal() {
  local file="$SCRIPT_DIR/auth/identity-journal.log"
  mkdir -p "$SCRIPT_DIR/auth"
  printf '%s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "${3:-}" >> "$file"
}

# kcadm runs inside the Keycloak container against its own HTTP listener. The
# session file gets a random name under the container's /tmp and is removed by
# kcadm_logout (also from the exit trap). Passwords and secrets reach kcadm as
# environment variables of the exec (KC_CLI_PASSWORD, KC_CLI_CLIENT_SECRET),
# named on the docker command line but never given as arguments.
#
# kcadm [VAR=VALUE ...] -- <kcadm command> [arguments]
kcadm() {
  local -a names=() exec_opts=()
  local rc=0
  while [[ $# -gt 0 && "$1" != -- ]]; do
    # shellcheck disable=SC2163  # the NAME=VALUE pair is the argument itself
    export "$1"
    names+=("${1%%=*}")
    exec_opts+=(-e "${1%%=*}")
    shift
  done
  if [[ "${1:-}" == -- ]]; then shift; fi
  if [[ "${KCADM_STDIN:-}" == 1 ]]; then
    docker exec -i "${exec_opts[@]}" "$KCADM_CID" /opt/keycloak/bin/kcadm.sh "$@" --config "$KCADM_CONFIG" || rc=$?
  else
    docker exec "${exec_opts[@]}" "$KCADM_CID" /opt/keycloak/bin/kcadm.sh "$@" --config "$KCADM_CONFIG" </dev/null || rc=$?
  fi
  if [[ ${#names[@]} -gt 0 ]]; then unset "${names[@]}"; fi
  return "$rc"
}

# kcadm_login <realm> user <username> <password>
# kcadm_login <realm> client <client-id> <secret>      (client credentials)
# Returns kcadm's status; the caller decides whether a refusal is fatal.
kcadm_login() {
  local realm="$1" kind="$2" name="$3" secret="$4" cid
  kcadm_logout
  cid="$(identity_container keycloak)"
  [[ -n "$cid" && "$(container_status "$cid")" == running ]] || die "Keycloak is not running. Run: krate identity up"
  KCADM_CID="$cid"
  KCADM_CONFIG="/tmp/kcadm-$(random_secret 16).config"
  trap identity_cleanup EXIT
  # kcadm announces each login ("Logging into ...") on stdout and stderr; only real
  # errors reach the operator, so command output (users groups, list) stays clean.
  local err rc=0
  err="$(mktemp)" || die "Cannot create a temporary file"
  case "$kind" in
    user)   kcadm "KC_CLI_PASSWORD=$secret" -- config credentials --server "$KCADM_SERVER" --realm "$realm" --user "$name" >/dev/null 2>"$err" || rc=$? ;;
    client) kcadm "KC_CLI_CLIENT_SECRET=$secret" -- config credentials --server "$KCADM_SERVER" --realm "$realm" --client "$name" >/dev/null 2>"$err" || rc=$? ;;
    *) rm -f "$err"; die "kcadm_login: unknown kind $kind" ;;
  esac
  grep -v '^Logging into' "$err" >&2 || true
  rm -f "$err"
  return "$rc"
}

kcadm_logout() {
  [[ -n "$KCADM_CONFIG" ]] || return 0
  docker exec "$KCADM_CID" rm -f "$KCADM_CONFIG" >/dev/null 2>&1 || true
  KCADM_CONFIG=""
  KCADM_CID=""
}

# IDs by exact name; empty when not found. A kcadm failure makes the function
# fail (pipefail), so callers assign with `|| die "Keycloak query failed"`.
kcadm_user_id() {
  kcadm -- get users -r "$1" -q "username=$2" -q exact=true --fields id --format csv --noquotes | awk 'NF { print; exit }'
}

kcadm_group_id() {
  kcadm -- get groups -r "$1" -q "search=$2" -q exact=true --fields id,name --format csv --noquotes \
    | awk -F, -v g="$2" '$2 == g { print $1; exit } $1 == g { print $2; exit }'
}

kcadm_client_id() {
  kcadm -- get clients -r "$1" -q "clientId=$2" --fields id,clientId --format csv --noquotes \
    | awk -F, -v c="$2" '$2 == c { print $1; exit } $1 == c { print $2; exit }'
}

# Log in as the permanent master admin from .env; a refusal is fatal with the
# recovery options ($1 names the command for the journal).
identity_verify_admin() {
  local admin
  admin="$(env_value KEYCLOAK_ADMIN_USER)"
  if ! kcadm_login master user "$admin" "$(env_value KEYCLOAK_ADMIN_PASSWORD)"; then
    identity_journal "$1" failed "admin login as $admin refused"
    die "Keycloak refused the admin login for $admin with KEYCLOAK_ADMIN_PASSWORD from .env.
Restore a backup (krate identity restore <file>) or recreate the admin: krate identity down, then krate identity recover-admin"
  fi
  kcadm_logout
  ok "Admin login as $admin verified"
}

# Log in as the krate-cli service account in the krate realm (what user
# management uses); a refusal is fatal.
identity_verify_cli() {
  if ! kcadm_login "$IDENTITY_REALM" client krate-cli "$(env_value KEYCLOAK_CLI_CLIENT_SECRET)"; then
    identity_journal "$1" failed "client login krate-cli refused"
    die "Keycloak refused the krate-cli client login with KEYCLOAK_CLI_CLIENT_SECRET from .env.
If the secret was changed in Keycloak, put it back in step: krate identity rotate KEYCLOAK_CLI_CLIENT_SECRET
Otherwise restore a backup: krate identity restore <file>"
  fi
  kcadm_logout
  ok "krate-cli client login verified (realm $IDENTITY_REALM)"
}

# Turn the one-time bootstrap admin $1 (password $2) into the permanent one:
# create KEYCLOAK_ADMIN_USER in the master realm when absent, set its password
# from .env, grant the realm role admin, verify its login, then delete the
# bootstrap admin and any leftover temp-admin.
identity_bootstrap_admin() {
  local temp="$1" temp_pw="$2" admin admin_pw tries=0 uid name
  admin="$(env_value KEYCLOAK_ADMIN_USER)"
  admin_pw="$(env_value KEYCLOAK_ADMIN_PASSWORD)"
  info "Creating the permanent Keycloak admin $admin from the temporary bootstrap admin $temp..."
  until kcadm_login master user "$temp" "$temp_pw" 2>/dev/null; do
    tries=$((tries + 1))
    (( tries < 10 )) || die "Could not log in as the bootstrap admin $temp after $tries attempts. Check: krate logs keycloak"
    sleep 3
  done
  uid="$(kcadm_user_id master "$admin")" || die "Keycloak query failed"
  if [[ -z "$uid" ]]; then
    kcadm -- create users -r master -s "username=$admin" -s enabled=true >/dev/null
  fi
  kcadm "KC_CLI_PASSWORD=$admin_pw" -- set-password -r master --username "$admin"
  kcadm -- add-roles -r master --uusername "$admin" --rolename admin
  kcadm_login master user "$admin" "$admin_pw" || die "The permanent admin $admin cannot log in; the bootstrap admin $temp was kept. Check: krate logs keycloak"
  # Remove this run's bootstrap admin and every temporary admin an earlier,
  # interrupted run may have left behind (temp-admin, temp-admin-<random>).
  local removed="" listing
  listing="$(kcadm -- get users -r master -q search=temp-admin --fields id,username --format csv --noquotes)" \
    || die "Keycloak query failed; the bootstrap admin $temp may remain. Check: krate logs keycloak, then: krate identity recover-admin"
  while IFS=, read -r uid name; do
    [[ -n "$uid" && "$name" != "$admin" ]] || continue
    [[ "$name" == "$temp" || "$name" =~ ^temp-admin(-[a-z0-9]{8})?$ ]] || continue
    kcadm -- delete "users/$uid" -r master
    removed+=" $name"
  done <<< "$listing"
  kcadm_logout
  ok "Permanent admin $admin ready; temporary admin(s) removed:${removed:- none found}"
}

# Site files Keycloak needs: identity secrets in .env (generated only for a
# pristine database), the database TLS material (made once and kept) and the
# realm plan (a pure function of .env, regenerated on every run). $1 = identity
# state.
prepare_identity() {
  local state="$1" command="${2:-up}" generated key missing=""
  if [[ "$state" == pristine ]]; then
    generated="$(fill_secrets "$ENV_FILE" 24 "${IDENTITY_KEYS[@]}" | xargs)"
    if [[ -n "$generated" ]]; then
      ok "Generated $generated in .env"
      IDENTITY_CHANGED=true
    fi
  else
    if [[ -z "$(env_value KEYCLOAK_IDP_WATCH_CLIENT_SECRET)" || "$(env_value KEYCLOAK_IDP_WATCH_CLIENT_SECRET)" == REPLACE_ME ]]; then
      local gen_watch
      gen_watch="$(fill_secrets "$ENV_FILE" 24 KEYCLOAK_IDP_WATCH_CLIENT_SECRET | xargs)"
      if [[ -n "$gen_watch" ]]; then
        ok "Generated $gen_watch in .env for IdP watcher"
        IDENTITY_CHANGED=true
      fi
    fi
    for key in "${IDENTITY_KEYS[@]}"; do
      case "$(env_value "$key")" in ""|REPLACE_ME) missing+=" $key" ;; esac
    done
    [[ -z "$missing" ]] || die "The identity database exists but .env lacks${missing}.
This .env or Keycloak database predates \`krate identity\`. See
'Upgrading from the previous Keycloak setup' in docs/identity-foundation.md (sso/guides/ in a checkout).
Otherwise restore the .env of this installation, or a backup: krate identity restore <file>"
  fi
  prepare_identity_files "$command"
}

# Directories the containers traverse through bind mounts are created with explicit
# modes, whatever the operator's umask: under umask 077 they would be 700, and Keycloak
# then cannot list KC_TRUSTSTORE_PATHS (it dies with "Cannot read the array length
# because array is null"); Kafbat (user kafkaui) mounts auth/ui the same way. The files
# inside keep their own modes (db-tls keys 600).
ensure_identity_dirs() {
  # db-tls is a compose mount source (keycloak-db and the keycloak CA trust): a
  # source absent at container create is made by the docker daemon root-owned
  # (fixture epc 2026-10-23), and then no later install -d or rm by this user
  # can touch it — every subsequent identity command would fail there.
  local auth_dirs=("$SCRIPT_DIR/auth" "$SCRIPT_DIR/auth/ui" "$SCRIPT_DIR/auth/keycloak"
                   "$SCRIPT_DIR/auth/keycloak/truststores" "$SCRIPT_DIR/auth/keycloak/db-tls")
  if ! install -d -m 755 "${auth_dirs[@]}"; then
    # Take the krate-owned tree back with the same sudo path the install flow
    # itself uses; without sudo, name the exact recovery command.
    local sudo_cmd=()
    if [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then sudo_cmd=(sudo); fi
    if ! "${sudo_cmd[@]}" chown -R "$(id -u):$(id -g)" "$SCRIPT_DIR/auth"; then
      die "Could not create the auth directories under $SCRIPT_DIR. $SCRIPT_DIR/auth holds containers' root-owned leftovers; as root run: chown -R $(id -u):$(id -g) '$SCRIPT_DIR/auth'"
    fi
    install -d -m 755 "${auth_dirs[@]}" || die "Could not create the auth directories under $SCRIPT_DIR"
  fi
}

# The database TLS material (generated when absent, never over an incomplete
# set) and the realm plan (rewritten only when its content differs from .env).
prepare_identity_files() {
  local sso plan command="${1:-up}"
  sso="$(sso_dir)"
  ensure_identity_dirs
  # A start that ran without identity up made the docker daemon create absent FILE
  # mount sources as root-owned DIRECTORIES (fixture epc 2026-10-23: a directory
  # named ca.crt in db-tls that identity.py's own write-then-rename then refused
  # with 'Errno 21 Is a directory'). A directory was never db-tls material: clear
  # it only while nothing real beside it can be lost; with real material present,
  # name it and refuse.
  local artifact f
  artifact=""
  for f in ca.key ca.crt server.key server.crt pg_hba.conf; do
    if [[ -d "$SCRIPT_DIR/auth/keycloak/db-tls/$f" ]]; then artifact="$artifact $f"; fi
  done
  if [[ -n "$artifact" ]]; then
    for f in ca.key ca.crt server.key server.crt pg_hba.conf; do
      if [[ -f "$SCRIPT_DIR/auth/keycloak/db-tls/$f" ]]; then
        die "auth/keycloak/db-tls holds directory leftovers (${artifact# }) beside real material ($f); remove the directories by hand (root may own them), keep the material, and run again"
      fi
    done
    for f in $artifact; do rm -rf "$SCRIPT_DIR/auth/keycloak/db-tls/$f"; done
    info "Removed directory leftovers from auth/keycloak/db-tls:$artifact (left by a start that ran without 'identity up')"
  fi
  if [[ ! -f "$SCRIPT_DIR/auth/keycloak/db-tls/ca.crt" ]]; then IDENTITY_CHANGED=true; fi
  python3 "$sso/identity.py" db-tls --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" \
    || { identity_journal "$command" refused "database TLS material incomplete or unwritable"; exit 1; }
  plan="$(python3 "$sso/identity.py" plan --env-file "$ENV_FILE" --output "$SCRIPT_DIR/auth/keycloak/krate-realm.json")" \
    || { identity_journal "$command" refused "realm plan not generated"; exit 1; }
  if [[ "$plan" != *"No changes"* ]]; then
    [[ -z "$plan" ]] || printf '%s\n' "$plan"
    IDENTITY_CHANGED=true
  fi
}

# .env ready for the identity services, without the rest of prepare (no
# certificate or UI image is needed to run Keycloak).
prepare_identity_env() {
  require_compose; require_compose_file; require_sso_compose
  command -v python3 >/dev/null || die "python3 is required for krate identity"
  if [[ ! -f "$ENV_FILE" ]]; then
    [[ -f "$ENV_TEMPLATE" ]] || die ".env.template not found in $SCRIPT_DIR"
    cp "$ENV_TEMPLATE" "$ENV_FILE"
    ok "Created .env from .env.template"
  fi
  chmod 600 "$ENV_FILE"
  sync_image_pins "$ENV_FILE" "$ENV_TEMPLATE"
}

identity_up_service() {
  identity_compose up -d --pull never --no-build --no-deps --wait --wait-timeout "$IDENTITY_TIMEOUT" "$@" \
    || { identity_journal start failed "$* not healthy within ${IDENTITY_TIMEOUT}s"
         die "Service $* did not become healthy within the ${IDENTITY_TIMEOUT}s timeout (IDENTITY_TIMEOUT). Check: krate logs $*"; }
}

# A query over the database's local socket (pg_hba: trust); prints the value.
identity_db_query() {
  docker exec "$1" psql -U keycloak -d keycloak -tAc "$2" </dev/null
}

# What the identity database holds, for a healthy keycloak-db container $1:
# unbootstrapped (no master realm yet: Keycloak's first start is still to
# come, even though the volume exists), no-admin (a master realm without the
# permanent admin KEYCLOAK_ADMIN_USER) or bootstrapped. Any other query
# failure is fatal.
identity_db_state() {
  local cid="$1" admin q="'" out
  admin="$(env_value KEYCLOAK_ADMIN_USER)"
  if ! out="$(identity_db_query "$cid" "select count(*) from realm where name='master'" 2>&1)"; then
    if [[ "$out" == *'relation "realm" does not exist'* ]]; then
      echo unbootstrapped
      return 0
    fi
    die "Cannot query the identity database: $out"
  fi
  if [[ "$out" == 0 ]]; then
    echo unbootstrapped
    return 0
  fi
  out="$(identity_db_query "$cid" "select count(*) from user_entity u join realm r on u.realm_id=r.id where r.name='master' and u.username='${admin//$q/$q$q}'" 2>&1)" \
    || die "Cannot query the identity database: $out"
  if [[ "$out" == 0 ]]; then
    echo no-admin
  else
    echo bootstrapped
  fi
}

# Create the master realm and a temporary bootstrap admin $1 (password $2)
# with Keycloak's own command in a one-off container, before Keycloak starts
# (its guide: all nodes stopped). The password travels in an exported
# variable, never in an argument. $3 names the command for the journal.
identity_bootstrap_master() {
  local temp="$1" temp_pw="$2" command="$3" kc bootstrap_log
  kc="$(identity_container keycloak)"
  if [[ "$(container_status "$kc")" == running ]]; then
    info "Stopping Keycloak before creating the bootstrap admin..."
    identity_compose stop keycloak
  fi
  info "Creating the master realm and its temporary bootstrap admin $temp..."
  if ! bootstrap_log="$(KRATE_BOOTSTRAP_PASSWORD="$temp_pw" identity_compose run --rm --no-deps -T -e KRATE_BOOTSTRAP_PASSWORD keycloak \
      bootstrap-admin user --username "$temp" --password:env KRATE_BOOTSTRAP_PASSWORD --no-prompt 2>&1)"; then
    printf '%s\n' "$bootstrap_log" >&2
    identity_journal "$command" failed "bootstrap-admin user failed"
    die "Keycloak could not create its master realm and bootstrap admin (output above). Check: krate logs keycloak-db"
  fi
  printf '%s\n' "$bootstrap_log" | grep -E 'KC-SERVICES0077|temporary admin' | sed 's/^/  /' || true
}

# The krate-ui client follows .env: when the realm plan and Keycloak differ in
# redirectUris, webOrigins, frontchannelLogout (off: back-channel logout only)
# or the client attributes (PKCE, the post-logout URIs, OIDC back-channel
# logout to Kafbat), Keycloak is updated from the plan. Nothing else of the
# client is reconciled; the realm policy has identity_reconcile_realm_policy.
identity_reconcile_ui_urls() {
  local plan="$SCRIPT_DIR/auth/keycloak/krate-realm.json" id wanted keys current
  wanted="$(python3 -c '
import json, sys
client = next(c for c in json.load(open(sys.argv[1]))["clients"] if c["clientId"] == "krate-ui")
print(json.dumps({"redirectUris": sorted(client["redirectUris"]), "webOrigins": sorted(client["webOrigins"]),
                  "frontchannelLogout": client["frontchannelLogout"], "attributes": client["attributes"]}, sort_keys=True))' "$plan")" \
    || die "Cannot read the krate-ui client from $plan"
  keys="$(python3 -c 'import json, sys; print(",".join(sorted(json.loads(sys.argv[1])["attributes"])))' "$wanted")"
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  id="$(kcadm_client_id "$IDENTITY_REALM" krate-ui)" || die "Keycloak query failed"
  [[ -n "$id" ]] || die "Client krate-ui not found in realm $IDENTITY_REALM"
  current="$(kcadm -- get "clients/$id" -r "$IDENTITY_REALM" --fields redirectUris,webOrigins,frontchannelLogout,"attributes($keys)" \
    | python3 -c '
import json, sys
client = json.load(sys.stdin)
attributes = client.get("attributes") or {}
print(json.dumps({"redirectUris": sorted(client.get("redirectUris", [])), "webOrigins": sorted(client.get("webOrigins", [])),
                  "frontchannelLogout": client.get("frontchannelLogout"),
                  "attributes": {key: attributes.get(key, "") for key in sys.argv[1].split(",")}}, sort_keys=True))' "$keys")" \
    || die "Keycloak query failed"
  if [[ "$current" != "$wanted" ]]; then
    printf '%s\n' "$wanted" | KCADM_STDIN=1 kcadm -- update "clients/$id" -r "$IDENTITY_REALM" -f - -m \
      || die "Keycloak refused the krate-ui client update"
    identity_journal "${1:-up}" reconciled "krate-ui urls and attributes"
    IDENTITY_CHANGED=true
    ok "krate-ui client URLs and logout settings updated from the realm plan"
  fi
  kcadm_logout
}

# Realm policy the plan states and Keycloak's import never revisits (an import
# only creates a realm; a backup restores the old realm): otpPolicyLookAheadWindow
# and the required actions' enabled/defaultAction. A realm created before the plan
# stated them keeps the class default window 0, which refuses a TOTP code typed
# across the 30-second boundary, and CONFIGURE_TOTP as a default action, which
# a user PingFederate brokers in would be asked for too. A required action is
# updated from its full GET representation (never a partial `-n` update: that
# replaces the representation and wipes alias and name). $1 names the command
# for the journal.
identity_reconcile_realm_policy() {
  local plan="$SCRIPT_DIR/auth/keycloak/krate-realm.json" wanted current line alias actions
  wanted="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["otpPolicyLookAheadWindow"])' "$plan")" \
    || die "Cannot read otpPolicyLookAheadWindow from $plan"
  [[ "$wanted" =~ ^[0-9]+$ ]] || die "$plan: otpPolicyLookAheadWindow must be a whole number"
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  current="$(kcadm -- get "realms/$IDENTITY_REALM" --fields otpPolicyLookAheadWindow --format csv --noquotes)" \
    || die "Keycloak query failed"
  if [[ "$current" != "$wanted" ]]; then
    kcadm -- update "realms/$IDENTITY_REALM" -s "otpPolicyLookAheadWindow=$wanted" \
      || die "Keycloak refused the realm policy update"
    identity_journal "${1:-up}" reconciled "realm policy"
    IDENTITY_CHANGED=true
    ok "Realm $IDENTITY_REALM: OTP look-ahead window set to $wanted step(s) from the realm plan"
  fi
  # Each planned required action: `alias enabled defaultAction` as the plan states it.
  actions="$(python3 -c '
import json, sys
for action in json.load(open(sys.argv[1]))["requiredActions"]:
    print(action["alias"], str(action["enabled"]).lower(), str(action["defaultAction"]).lower())' "$plan")" || die "Cannot read required actions from the realm plan"
  while IFS=' ' read -r alias line; do
    [[ -n "$alias" ]] || continue
    current="$(kcadm -- get "authentication/required-actions/$alias" -r "$IDENTITY_REALM")" || die "Keycloak query failed (required action $alias)"
    if [[ "$(printf '%s' "$current" | python3 -c 'import json, sys; a = json.load(sys.stdin); print(str(a.get("enabled")).lower(), str(a.get("defaultAction")).lower())')" != "$line" ]]; then
      printf '%s' "$current" | python3 -c '
import json, sys
action = json.load(sys.stdin)
action["enabled"], action["defaultAction"] = (value == "true" for value in sys.argv[1].split())
json.dump(action, sys.stdout)' "$line" | KCADM_STDIN=1 kcadm -- update "authentication/required-actions/$alias" -r "$IDENTITY_REALM" -f - \
        >/dev/null || die "Keycloak refused the required action update for $alias"
      identity_journal "${1:-up}" reconciled "required action $alias"
      IDENTITY_CHANGED=true
      ok "Realm $IDENTITY_REALM: required action $alias set to enabled/default ${line// //} from the realm plan"
    fi
  done <<< "$actions"
  kcadm_logout
}

identity_reconcile_idp_watch_client() {
  local plan="$SCRIPT_DIR/auth/keycloak/krate-realm.json" id
  [[ -f "$plan" ]] || return 0
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  id="$(kcadm_client_id "$IDENTITY_REALM" krate-idp-watch 2>/dev/null || echo "")"
  if [[ -z "$id" ]]; then
    info "Creating krate-idp-watch client in realm $IDENTITY_REALM..."
    local client_rep
    client_rep="$(python3 -c '
import json, sys
c = next(c for c in json.load(open(sys.argv[1]))["clients"] if c["clientId"] == "krate-idp-watch")
c["secret"] = sys.argv[2]
print(json.dumps(c))' "$plan" "$(env_value KEYCLOAK_IDP_WATCH_CLIENT_SECRET)")" || die "Cannot render krate-idp-watch client"
    printf '%s\n' "$client_rep" | KCADM_STDIN=1 kcadm -- create clients -r "$IDENTITY_REALM" -f - >/dev/null \
      || die "Keycloak refused to create krate-idp-watch client"
    id="$(kcadm_client_id "$IDENTITY_REALM" krate-idp-watch)" || die "Keycloak query failed for krate-idp-watch"
    IDENTITY_CHANGED=true
  fi

  # Service account user and realm-management client lookups (required, fail closed)
  local sa_user_id mgmt_id current_roles r_view r_manage needs_view needs_manage
  sa_user_id="$(kcadm -- get "clients/$id/service-account-user" -r "$IDENTITY_REALM" --fields id --format csv --noquotes)" \
    || die "Keycloak query failed for service-account-user of krate-idp-watch"
  [[ -n "$sa_user_id" ]] || die "service-account-user not found for krate-idp-watch"
  mgmt_id="$(kcadm_client_id "$IDENTITY_REALM" realm-management)" \
    || die "Keycloak query failed for client realm-management"
  [[ -n "$mgmt_id" ]] || die "Client realm-management not found in realm $IDENTITY_REALM"

  # Structural role inspection (whitespace-independent JSON parsing)
  current_roles="$(kcadm -- get "users/$sa_user_id/role-mappings/clients/$mgmt_id" -r "$IDENTITY_REALM")" \
    || die "Keycloak query failed for role mappings of krate-idp-watch"
  needs_view="$(python3 -c 'import json, sys; roles={r.get("name") for r in json.load(sys.stdin)}; print("false" if "view-identity-providers" in roles else "true")' <<< "$current_roles")"
  needs_manage="$(python3 -c 'import json, sys; roles={r.get("name") for r in json.load(sys.stdin)}; print("false" if "manage-identity-providers" in roles else "true")' <<< "$current_roles")"

  if [[ "$needs_view" == true ]]; then
    r_view="$(kcadm -- get "clients/$mgmt_id/roles/view-identity-providers" -r "$IDENTITY_REALM")" \
      || die "Keycloak query failed for role view-identity-providers"
    info "Assigning view-identity-providers role to krate-idp-watch service account..."
    printf '[%s]\n' "$r_view" | KCADM_STDIN=1 kcadm -- create "users/$sa_user_id/role-mappings/clients/$mgmt_id" -r "$IDENTITY_REALM" -f - >/dev/null \
      || die "Keycloak refused to assign view-identity-providers role"
    IDENTITY_CHANGED=true
  fi
  if [[ "$needs_manage" == true ]]; then
    r_manage="$(kcadm -- get "clients/$mgmt_id/roles/manage-identity-providers" -r "$IDENTITY_REALM")" \
      || die "Keycloak query failed for role manage-identity-providers"
    info "Assigning manage-identity-providers role to krate-idp-watch service account..."
    printf '[%s]\n' "$r_manage" | KCADM_STDIN=1 kcadm -- create "users/$sa_user_id/role-mappings/clients/$mgmt_id" -r "$IDENTITY_REALM" -f - >/dev/null \
      || die "Keycloak refused to assign manage-identity-providers role"
    IDENTITY_CHANGED=true
  fi

  # Final verification readback
  local verified_roles
  verified_roles="$(kcadm -- get "users/$sa_user_id/role-mappings/clients/$mgmt_id" -r "$IDENTITY_REALM")" \
    || die "Keycloak query failed for verified role mappings"
  python3 -c '
import json, sys
roles = {r.get("name") for r in json.load(sys.stdin)}
required = {"view-identity-providers", "manage-identity-providers"}
missing = required - roles
if missing:
    sys.exit(f"Role verification failed; missing: {sorted(missing)}")
' <<< "$verified_roles" || die "krate-idp-watch service account role verification failed"
  local wanted_theme current_theme
  wanted_theme="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("loginTheme", ""))' "$plan" 2>/dev/null || echo "")"
  if [[ -n "$wanted_theme" ]]; then
    current_theme="$(kcadm -- get "realms/$IDENTITY_REALM" --fields loginTheme --format csv --noquotes 2>/dev/null || echo "")"
    if [[ "$current_theme" != "$wanted_theme" ]]; then
      kcadm -- update "realms/$IDENTITY_REALM" -s "loginTheme=$wanted_theme" || die "Keycloak refused to update loginTheme"
      identity_journal "${1:-up}" reconciled "realm loginTheme ($wanted_theme)"
      IDENTITY_CHANGED=true
      ok "Realm $IDENTITY_REALM: loginTheme set to $wanted_theme from the realm plan"
    fi
  fi
  kcadm_logout
}

# ─── PingFederate broker (Phase 3): the plan applied to the realm ────────────
# auth/keycloak/pingfederate-idp.json (written by `auth configure <site.json>`,
# schema in sso/configure-dual.py) is applied to realm krate by `auth apply`
# and re-applied by `identity up`: the flows and their executions, the
# identity provider, its mappers and the realm's browser-flow binding, each
# created when absent and updated when it differs, so a second run changes
# nothing. The client secret reaches kcadm from .env through the environment
# of `identity.py broker provider --with-secret`, whose output is piped into
# kcadm's stdin; it is never an argument. Without the plan file, a provider
# that still exists is removed with its mappers and flows and the browser
# flow is rebound to Keycloak's `browser`. $1 names the command for the journal.

# Percent-encode a flow alias for a kcadm path (`krate browser` -> `krate%20browser`).
url_path_encode() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$1"
}

# A top-level field of the JSON object on stdin; booleans print as true/false, absent as empty.
json_field() {
  python3 -c '
import json, sys
value = json.load(sys.stdin).get(sys.argv[1], "")
print(str(value).lower() if isinstance(value, bool) else value)' "$1"
}

identity_apply_idp() {
  local command="$1" plan="$SCRIPT_DIR/$IDENTITY_IDP_PLAN" sso provider changes idp_err
  sso="$(sso_dir)"
  IDENTITY_IDP_CHANGES=()
  if [[ -f "$plan" ]]; then
    case "$(env_value PING_KEYCLOAK_CLIENT_SECRET)" in
      ""|REPLACE_ME)
        warn "PING_KEYCLOAK_CLIENT_SECRET is not set; the PingFederate plan is applied when it is (krate auth apply asks for it, or: krate identity rotate PING_KEYCLOAK_CLIENT_SECRET --value)"
        return 0 ;;
    esac
  fi
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  # The provider's representation (its secret masked by Keycloak) or an absence; any other
  # failure is fatal. The variable is compared and never printed. Streams stay
  # split: the JVM prints warnings (e.g. OpenJDK vector-length notes) on stderr
  # that would otherwise corrupt the parsed JSON.
  idp_err="$(mktemp)" || die "Cannot create a temporary file"
  if provider="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" 2>"$idp_err")"; then
    :
  elif grep -q "not found" "$idp_err" || [[ "$provider" == *"not found"* ]]; then
    provider=""
  else
    rm -f "$idp_err"
    die "Keycloak query failed for identity provider $IDENTITY_IDP_ALIAS"
  fi
  rm -f "$idp_err"
  if [[ -f "$plan" ]]; then
    identity_apply_idp_plan "$plan" "$sso" "$provider"
    if [[ ${#IDENTITY_IDP_CHANGES[@]} -gt 0 ]]; then
      changes="$(printf '%s; ' "${IDENTITY_IDP_CHANGES[@]}")"; changes="${changes%; }"
      identity_journal "$command" reconciled "identity provider $IDENTITY_IDP_ALIAS: $changes"
      IDENTITY_CHANGED=true
      ok "Identity provider $IDENTITY_IDP_ALIAS applied to realm $IDENTITY_REALM (${#IDENTITY_IDP_CHANGES[@]} change(s): $changes)"
    else
      ok "Identity provider $IDENTITY_IDP_ALIAS: No changes"
    fi
  elif [[ -n "$provider" ]]; then
    identity_remove_idp "$provider"
    if [[ -n "$IDENTITY_BROWSER_KEPT" ]]; then
      identity_journal "$command" removed "identity provider $IDENTITY_IDP_ALIAS, its mappers and flows; browser flow bound to '$IDENTITY_BROWSER_KEPT' left as it is"
      ok "Identity provider $IDENTITY_IDP_ALIAS removed from realm $IDENTITY_REALM (no plan file); the browser flow stays bound to '$IDENTITY_BROWSER_KEPT'"
    else
      identity_journal "$command" removed "identity provider $IDENTITY_IDP_ALIAS, its mappers and flows; browser flow rebound to browser"
      ok "Identity provider $IDENTITY_IDP_ALIAS removed from realm $IDENTITY_REALM (no plan file); the browser flow is Keycloak's browser again"
    fi
    IDENTITY_CHANGED=true
  elif identity_owned_flows_present; then
    # An earlier apply that stopped before creating the provider, or a provider deleted out
    # of band, leaves the Krate flows (and perhaps the browser binding) behind.
    identity_remove_idp ""
    if [[ -n "$IDENTITY_BROWSER_KEPT" ]]; then
      identity_journal "$command" removed "identity flows only (provider $IDENTITY_IDP_ALIAS already absent); browser flow bound to '$IDENTITY_BROWSER_KEPT' left as it is"
      ok "Identity flows removed from realm $IDENTITY_REALM (no plan file; provider $IDENTITY_IDP_ALIAS was already absent); the browser flow stays bound to '$IDENTITY_BROWSER_KEPT'"
    else
      identity_journal "$command" removed "identity flows only (provider $IDENTITY_IDP_ALIAS already absent); browser flow rebound to browser"
      ok "Identity flows removed from realm $IDENTITY_REALM (no plan file; provider $IDENTITY_IDP_ALIAS was already absent); the browser flow is Keycloak's browser again"
    fi
    IDENTITY_CHANGED=true
  fi
  kcadm_logout
}

# Apply the plan $1 (helpers in $2) to the realm; $3 is the provider's current
# representation ("" when absent). Order: flows first (the provider names its
# first-broker-login flow), then the provider, its mappers, the realm binding.
identity_apply_idp_plan() {
  local plan="$1" sso="$2" provider="$3" line alias existing current id name wanted verdict flow_lines mapper_lines stale_mappers
  existing="$(kcadm -- get authentication/flows -r "$IDENTITY_REALM" --fields alias --format csv --noquotes)" || die "Keycloak query failed (flows)"
  flow_lines="$(python3 "$sso/identity.py" broker --plan "$plan" flows)" || die "Cannot render flows from $IDENTITY_IDP_PLAN"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    alias="$(printf '%s' "$line" | json_field alias)"
    [[ "$(printf '%s' "$line" | json_field topLevel)" == true ]] || continue  # sub-flows are made from their parent
    if ! grep -qxF -- "$alias" <<< "$existing"; then
      printf '%s\n' "$line" | KCADM_STDIN=1 kcadm -- create authentication/flows -r "$IDENTITY_REALM" -f - >/dev/null \
        || die "Keycloak refused to create flow '$alias'"
      IDENTITY_IDP_CHANGES+=("flow '$alias' created")
    fi
    identity_apply_flow "$plan" "$sso" "$alias"
  done <<< "$flow_lines"
  if [[ -z "$provider" ]]; then
    identity_put_idp_provider "$plan" "$sso" create
    IDENTITY_IDP_CHANGES+=("provider created")
  else
    local -a diff_opts=()
    if [[ "$(env_value IDP_WATCH_ENABLED)" == true ]]; then
      diff_opts+=(--ignore-enabled)
    fi
    # A helper failure must never read as "same" (that would print No changes over a stale provider).
    verdict="$(printf '%s' "$provider" | python3 "$sso/identity.py" broker --plan "$plan" provider-differs "${diff_opts[@]}")" \
      || die "Cannot compare identity provider $IDENTITY_IDP_ALIAS with $IDENTITY_IDP_PLAN"
    case "$verdict" in
      differs) identity_put_idp_provider "$plan" "$sso" update; IDENTITY_IDP_CHANGES+=("provider updated") ;;
      same) ;;
      *) die "Unexpected comparison result for identity provider $IDENTITY_IDP_ALIAS" ;;
    esac
  fi
  current="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers" -r "$IDENTITY_REALM")" || die "Keycloak query failed (mappers)"
  local -a planned=()
  mapper_lines="$(python3 "$sso/identity.py" broker --plan "$plan" mappers)" || die "Cannot render mappers from $IDENTITY_IDP_PLAN"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    name="$(printf '%s' "$line" | json_field name)"
    planned+=("$name")
    id="$(printf '%s' "$current" | python3 -c 'import json, sys; print(next((m["id"] for m in json.load(sys.stdin) if m.get("name") == sys.argv[1]), ""))' "$name")"
    if [[ -z "$id" ]]; then
      printf '%s\n' "$line" | KCADM_STDIN=1 kcadm -- create "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers" -r "$IDENTITY_REALM" -f - >/dev/null \
        || die "Keycloak refused to create mapper '$name'"
      IDENTITY_IDP_CHANGES+=("mapper '$name' created")
    else
      verdict="$(printf '%s' "$current" | python3 -c 'import json, sys; json.dump(next(m for m in json.load(sys.stdin) if m.get("name") == sys.argv[1]), sys.stdout)' "$name" \
        | python3 "$sso/identity.py" broker --plan "$plan" mapper-differs "$name")" || die "Cannot compare mapper '$name' with $IDENTITY_IDP_PLAN"
      case "$verdict" in
        differs)
          printf '%s\n' "$line" | python3 -c 'import json, sys; m = json.load(sys.stdin); m["id"] = sys.argv[1]; json.dump(m, sys.stdout)' "$id" \
            | KCADM_STDIN=1 kcadm -- update "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers/$id" -r "$IDENTITY_REALM" -f - >/dev/null \
            || die "Keycloak refused to update mapper '$name'"
          IDENTITY_IDP_CHANGES+=("mapper '$name' updated") ;;
        same) ;;
        *) die "Unexpected comparison result for mapper '$name'" ;;
      esac
    fi
  done <<< "$mapper_lines"
  # Mappers of this provider the plan does not name widen or change the group mapping: removed.
  stale_mappers="$(printf '%s' "$current" | python3 -c '
import json, sys
for mapper in json.load(sys.stdin):
    if mapper.get("name") not in sys.argv[1:]:
        print(mapper["id"] + "," + mapper.get("name", ""))' "${planned[@]}")" || die "Cannot compare mappers with $IDENTITY_IDP_PLAN"
  while IFS=, read -r id name; do
    [[ -n "$id" ]] || continue
    kcadm -- delete "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers/$id" -r "$IDENTITY_REALM" || die "Keycloak refused to delete mapper '$name'"
    IDENTITY_IDP_CHANGES+=("mapper '$name' removed")
  done <<< "$stale_mappers"
  wanted="$(python3 "$sso/identity.py" broker --plan "$plan" browser-flow)"
  current="$(kcadm -- get "realms/$IDENTITY_REALM" --fields browserFlow --format csv --noquotes)" || die "Keycloak query failed (realm)"
  if [[ "$current" != "$wanted" ]]; then
    kcadm -- update "realms/$IDENTITY_REALM" -s "browserFlow=$wanted" >/dev/null || die "Keycloak refused to bind the browser flow '$wanted'"
    IDENTITY_IDP_CHANGES+=("browser flow bound to '$wanted'")
  fi
}

# The executions of flow $3 as the plan $1 states them (helpers in $2): a missing
# authenticator or sub-flow is added, requirement and priority set (the executions
# path with `-n` and the execution id, as Keycloak's own CLI guide does), the
# redirector's configuration created or updated, and a level-0 execution the plan
# does not name removed. Planned sub-flows are reconciled the same way, recursively.
identity_apply_flow() {
  local plan="$1" sso="$2" flow="$3" executions line current kind name req prio cfg id cur_req cur_prio cfg_id verdict description execution_lines stale_executions
  local -a planned=()
  executions="authentication/flows/$(url_path_encode "$flow")/executions"
  current="$(kcadm -- get "$executions" -r "$IDENTITY_REALM")" || die "Keycloak query failed (flow '$flow')"
  execution_lines="$(python3 "$sso/identity.py" broker --plan "$plan" executions "$flow")" || die "Cannot render executions of flow '$flow' from $IDENTITY_IDP_PLAN"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ "$(printf '%s' "$line" | json_field authenticatorFlow)" == true ]]; then
      kind=flow; name="$(printf '%s' "$line" | json_field flowAlias)"
    else
      kind=authenticator; name="$(printf '%s' "$line" | json_field authenticator)"
    fi
    req="$(printf '%s' "$line" | json_field requirement)"
    prio="$(printf '%s' "$line" | json_field priority)"
    cfg="$(printf '%s' "$line" | json_field authenticatorConfig)"
    planned+=("$kind:$name")
    read -r id cur_req cur_prio cfg_id <<< "$(printf '%s' "$current" | identity_find_execution "$kind" "$name")"
    if [[ -z "$id" ]]; then
      if [[ "$kind" == flow ]]; then
        description="$(python3 "$sso/identity.py" broker --plan "$plan" flows \
          | python3 -c 'import json, sys; print(next(f["description"] for f in map(json.loads, sys.stdin) if f["alias"] == sys.argv[1]))' "$name")" \
          || die "Sub-flow '$name' of flow '$flow' is not in $IDENTITY_IDP_PLAN"
        kcadm -- create "${executions}/flow" -r "$IDENTITY_REALM" -s "alias=$name" -s type=basic-flow -s provider=basic-flow -s "description=$description" >/dev/null \
          || die "Keycloak refused to add sub-flow '$name' to flow '$flow'"
      else
        kcadm -- create "${executions}/execution" -r "$IDENTITY_REALM" -s "provider=$name" >/dev/null \
          || die "Keycloak refused to add $name to flow '$flow'"
      fi
      IDENTITY_IDP_CHANGES+=("'$flow': $name added")
      current="$(kcadm -- get "$executions" -r "$IDENTITY_REALM")" || die "Keycloak query failed (flow '$flow')"
      read -r id cur_req cur_prio cfg_id <<< "$(printf '%s' "$current" | identity_find_execution "$kind" "$name")"
      [[ -n "$id" ]] || die "$name did not appear in flow '$flow' after it was added"
    fi
    if [[ "$cur_req" != "$req" || "$cur_prio" != "$prio" ]]; then
      kcadm -- update "$executions" -r "$IDENTITY_REALM" -n -s "id=$id" -s "requirement=$req" -s "priority=$prio" >/dev/null \
        || die "Keycloak refused to set $name in flow '$flow' to $req/$prio"
      IDENTITY_IDP_CHANGES+=("'$flow': $name $req $prio")
    fi
    if [[ -n "$cfg" ]]; then
      if [[ -z "$cfg_id" ]]; then
        python3 "$sso/identity.py" broker --plan "$plan" config "$cfg" \
          | KCADM_STDIN=1 kcadm -- create "authentication/executions/$id/config" -r "$IDENTITY_REALM" -f - >/dev/null \
          || die "Keycloak refused the configuration '$cfg' of $name"
        IDENTITY_IDP_CHANGES+=("'$flow': $name configured ($cfg)")
      else
        verdict="$(kcadm -- get "authentication/config/$cfg_id" -r "$IDENTITY_REALM" | python3 "$sso/identity.py" broker --plan "$plan" config-differs "$cfg")" \
          || die "Keycloak query failed (configuration '$cfg' of $name in flow '$flow')"
        case "$verdict" in
          differs)
            python3 "$sso/identity.py" broker --plan "$plan" config "$cfg" \
              | python3 -c 'import json, sys; c = json.load(sys.stdin); c["id"] = sys.argv[1]; json.dump(c, sys.stdout)' "$cfg_id" \
              | KCADM_STDIN=1 kcadm -- update "authentication/config/$cfg_id" -r "$IDENTITY_REALM" -f - >/dev/null \
              || die "Keycloak refused to update the configuration '$cfg' of $name"
            IDENTITY_IDP_CHANGES+=("'$flow': $name reconfigured ($cfg)") ;;
          same) ;;
          *) die "Unexpected comparison result for the configuration '$cfg' of $name" ;;
        esac
      fi
    fi
    if [[ "$kind" == flow ]]; then identity_apply_flow "$plan" "$sso" "$name"; fi
  done <<< "$execution_lines"
  stale_executions="$(printf '%s' "$current" | python3 -c '
import json, sys
planned = set(sys.argv[1:])
kept = set()
for e in json.load(sys.stdin):
    if e.get("level") != 0:
        continue
    key = ("flow:" + e.get("displayName", "")) if e.get("authenticationFlow") else ("authenticator:" + e.get("providerId", ""))
    if key in planned and key not in kept:
        kept.add(key)
        continue
    print(e["id"] + "," + key.split(":", 1)[1])' "${planned[@]}")" || die "Cannot compare executions in flow '$flow' with $IDENTITY_IDP_PLAN"
  while IFS=, read -r id name; do
    [[ -n "$id" ]] || continue
    kcadm -- delete "authentication/executions/$id" -r "$IDENTITY_REALM" || die "Keycloak refused to remove $name from flow '$flow'"
    IDENTITY_IDP_CHANGES+=("'$flow': $name removed")
  done <<< "$stale_executions"
}

# Create ($3 create) or replace ($3 update) the provider from the plan $1 (helpers in $2)
# with the client secret from .env: the secret enters `identity.py broker provider
# --with-secret` through that process's environment and kcadm through its stdin.
identity_put_idp_provider() {
  local plan="$1" sso="$2" action="$3"
  local enabled_arg=""
  if [[ "$action" == create ]]; then
    enabled_arg="--enabled true"
  else
    local live_enabled
    if [[ "$(env_value IDP_WATCH_ENABLED)" == true ]]; then
      live_enabled="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" --fields enabled --format csv --noquotes)" || die "Keycloak query failed for provider $IDENTITY_IDP_ALIAS enabled state"
      [[ "$live_enabled" == "true" || "$live_enabled" == "false" ]] || die "Invalid enabled state for provider $IDENTITY_IDP_ALIAS: '$live_enabled'"
      enabled_arg="--enabled $live_enabled"
    else
      enabled_arg="--enabled true"
    fi
  fi
  if [[ "$action" == create ]]; then
    # shellcheck disable=SC2086
    PING_KEYCLOAK_CLIENT_SECRET="$(env_value PING_KEYCLOAK_CLIENT_SECRET)" python3 "$sso/identity.py" broker --plan "$plan" $enabled_arg provider --with-secret \
      | KCADM_STDIN=1 kcadm -- create identity-provider/instances -r "$IDENTITY_REALM" -f - >/dev/null \
      || die "Keycloak refused to create identity provider $IDENTITY_IDP_ALIAS"
  else
    # shellcheck disable=SC2086
    PING_KEYCLOAK_CLIENT_SECRET="$(env_value PING_KEYCLOAK_CLIENT_SECRET)" python3 "$sso/identity.py" broker --plan "$plan" $enabled_arg provider --with-secret \
      | KCADM_STDIN=1 kcadm -- update "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" -f - >/dev/null \
      || die "Keycloak refused to update identity provider $IDENTITY_IDP_ALIAS"
  fi
}

# `identity rotate PING_KEYCLOAK_CLIENT_SECRET`: .env already carries the new value; when
# the provider exists it is replaced from the plan with that value (Keycloak masks the
# stored secret, so apply cannot detect a rotation by comparison). The provider is never
# removed: the users' federated-identity links survive. Without a provider, .env alone
# changes and `auth apply` creates the provider with the new value.
identity_rotate_ping_secret() {
  local plan="$SCRIPT_DIR/$IDENTITY_IDP_PLAN" sso provider idp_err
  sso="$(sso_dir)"
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  idp_err="$(mktemp)" || die "Cannot create a temporary file"
  if provider="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" 2>"$idp_err")"; then
    rm -f "$idp_err"
    [[ -f "$plan" ]] || die "Identity provider $IDENTITY_IDP_ALIAS exists but $IDENTITY_IDP_PLAN is missing; restore the plan (krate auth configure <site.json>) before rotating"
    identity_put_idp_provider "$plan" "$sso" update
    if [[ "$(env_value IDP_WATCH_ENABLED)" == true ]]; then
      identity_up_service idp-watch
    fi
    identity_journal rotate PING_KEYCLOAK_CLIENT_SECRET "applied to identity provider $IDENTITY_IDP_ALIAS"
    ok "Identity provider $IDENTITY_IDP_ALIAS: secret updated"
  elif grep -q "not found" "$idp_err" || [[ "$provider" == *"not found"* ]]; then
    rm -f "$idp_err"
    ok "Identity provider $IDENTITY_IDP_ALIAS: not applied yet (krate auth apply)"
  else
    rm -f "$idp_err"
    die "Keycloak query failed for identity provider $IDENTITY_IDP_ALIAS"
  fi
  kcadm_logout
}

# From a flow's execution listing on stdin: `id requirement priority configId` of the
# level-0 entry that is the sub-flow ($1 flow, $2 alias) or authenticator ($1
# authenticator, $2 provider id); nothing when absent.
identity_find_execution() {
  python3 -c '
import json, sys
kind, name = sys.argv[1:3]
for e in json.load(sys.stdin):
    if e.get("level") != 0:
        continue
    found = (e.get("authenticationFlow") and e.get("displayName") == name) if kind == "flow" \
        else (not e.get("authenticationFlow") and e.get("providerId") == name)
    if found:
        print(e["id"], e.get("requirement", ""), e.get("priority", 0), e.get("authenticationConfig", ""))
        break' "$1" "$2"
}

# Set by identity_remove_idp: the browser flow the realm stays bound to because it is not
# a Krate flow (empty when the binding was Keycloak's or Krate's and is now `browser`).
IDENTITY_BROWSER_KEPT=""

# Succeeds when $1 is the alias of a flow the plan owns (the four it creates).
identity_owned_alias() {
  case "$1" in
    "krate browser"|"krate first broker login"|"krate forms"|"krate otp") return 0 ;;
  esac
  return 1
}

# Succeeds when the realm still carries a Krate flow: browserFlow bound to one of the
# plan's flows, or one of them present. The flows listing returns top-level flows only,
# so "krate forms" and "krate otp" (sub-flows) never match there; matching them is
# harmless. A failing query is fatal, never read as absence.
identity_owned_flows_present() {
  local current flows id alias
  current="$(kcadm -- get "realms/$IDENTITY_REALM" --fields browserFlow --format csv --noquotes)" || die "Keycloak query failed (realm)"
  ! identity_owned_alias "$current" || return 0
  flows="$(kcadm -- get authentication/flows -r "$IDENTITY_REALM" --fields id,alias --format csv --noquotes)" || die "Keycloak query failed (flows)"
  while IFS=, read -r id alias; do
    ! identity_owned_alias "$alias" || return 0
  done <<< "$flows"
  return 1
}

# The plan file is gone: release the browser binding when it is a Krate flow (Keycloak
# refuses to delete a bound flow; an operator's own binding is left and named in
# IDENTITY_BROWSER_KEPT), remove the provider with its mappers
# (when $1, the provider's representation, is not empty; an absent provider has none),
# then the top-level flows the plan owns (their sub-flows go with them).
identity_remove_idp() {
  local present="${1:-}" current mappers flows id alias
  IDENTITY_BROWSER_KEPT=""
  current="$(kcadm -- get "realms/$IDENTITY_REALM" --fields browserFlow --format csv --noquotes)" || die "Keycloak query failed (realm)"
  if [[ -n "$present" ]]; then
    mappers="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers" -r "$IDENTITY_REALM" --fields id --format csv --noquotes)" || die "Keycloak query failed (mappers)"
  else
    mappers=""
  fi
  flows="$(kcadm -- get authentication/flows -r "$IDENTITY_REALM" --fields id,alias --format csv --noquotes)" || die "Keycloak query failed (flows)"
  if identity_owned_alias "$current"; then
    kcadm -- update "realms/$IDENTITY_REALM" -s browserFlow=browser >/dev/null || die "Keycloak refused to rebind the browser flow"
  elif [[ "$current" != browser ]]; then
    IDENTITY_BROWSER_KEPT="$current"
    warn "Browser flow '$current' is not a Krate flow; it stays bound"
  fi
  if [[ -n "$present" ]]; then
    while IFS= read -r id; do
      [[ -n "$id" ]] || continue
      kcadm -- delete "identity-provider/instances/$IDENTITY_IDP_ALIAS/mappers/$id" -r "$IDENTITY_REALM" || die "Keycloak refused to delete a mapper of $IDENTITY_IDP_ALIAS"
    done <<< "$mappers"
    kcadm -- delete "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" || die "Keycloak refused to delete identity provider $IDENTITY_IDP_ALIAS"
  fi
  while IFS=, read -r id alias; do
    if identity_owned_alias "$alias"; then
      kcadm -- delete "authentication/flows/$id" -r "$IDENTITY_REALM" || die "Keycloak refused to delete flow '$alias'"
    fi
  done <<< "$flows"
}

# Keycloak's Compose environment carries KRATE_TRUSTSTORE_SHA, a digest of the PEM
# set in auth/keycloak/truststores (names and content; `none` when empty): Keycloak
# reads KC_TRUSTSTORE_PATHS at start only, so `up` recreates it exactly when a
# certificate was added, replaced or removed. Returns 0 when the digest changed
# (the caller reports the recreation), 1 when it is current.
sync_truststore_env() {
  local sha
  sha="$(python3 "$(sso_dir)/identity.py" truststore-digest --directory "$SCRIPT_DIR/auth/keycloak/truststores")" \
    || die "Cannot digest $SCRIPT_DIR/auth/keycloak/truststores"
  [[ "$(env_value KRATE_TRUSTSTORE_SHA)" != "$sha" ]] || return 1
  set_env_file_value "$ENV_FILE" KRATE_TRUSTSTORE_SHA "$sha"
}

cmd_identity_up() {
  prepare_identity_env
  adopt_legacy_project
  identity_lock
  local state reason bootstrap=false bootstrap_pw="" db kc db_state
  state="$(identity_state)" || exit 1
  reason="${state#unknown }"
  state="${state%% *}"
  if [[ "$state" == unknown ]]; then
    identity_journal up refused "$reason"
    die "Cannot tell whether an identity database exists: $reason"
  fi
  if [[ "$state" == pristine && "$(env_value KEYCLOAK_ADMIN_USER)" == temp-admin ]]; then
    die "KEYCLOAK_ADMIN_USER must not be temp-admin (the temporary bootstrap admin). Set another name: krate config set KEYCLOAK_ADMIN_USER=admin"
  fi
  prepare_identity "$state" up
  # Keycloak reads auth/keycloak/truststores at start: a changed PEM set recreates it below.
  if sync_truststore_env; then
    IDENTITY_CHANGED=true
    info "Trust material in auth/keycloak/truststores changed; Keycloak will be recreated"
  fi
  # Render into the validator's stdin: credentials never reach terminal output.
  identity_compose config --format json | python3 "$(sso_dir)/preflight.py" --directory "$SCRIPT_DIR" --mode identity \
    || { identity_journal up refused "preflight failed"; die "Identity preflight failed (see above)."; }
  require_service_images keycloak-db keycloak
  identity_network_clash up

  db="$(identity_container keycloak-db)"
  kc="$(identity_container keycloak)"
  if [[ "$(container_health "$db")" != healthy || "$(container_health "$kc")" != healthy ]]; then
    IDENTITY_CHANGED=true
  fi
  info "Starting the identity database..."
  identity_up_service keycloak-db
  db="$(identity_container keycloak-db)"
  if [[ "$state" == pristine ]]; then
    bootstrap=true
  else
    db_state="$(identity_db_state "$db")" || exit 1
    case "$db_state" in
      unbootstrapped)
        warn "The identity database volume exists but holds no master realm yet; bootstrapping it"
        bootstrap=true ;;
      no-admin)
        identity_journal up refused "master realm without admin $(env_value KEYCLOAK_ADMIN_USER)"
        die "The master realm has no admin named $(env_value KEYCLOAK_ADMIN_USER) (KEYCLOAK_ADMIN_USER). Recreate it from .env: krate identity recover-admin" ;;
    esac
  fi
  if $bootstrap; then
    bootstrap_pw="$(random_secret 24)"
    identity_bootstrap_master temp-admin "$bootstrap_pw" up
  fi
  info "Starting Keycloak..."
  identity_up_service keycloak

  if $bootstrap; then
    identity_bootstrap_admin temp-admin "$bootstrap_pw"
    identity_journal up bootstrapped "database initialised; permanent admin $(env_value KEYCLOAK_ADMIN_USER) created; temp-admin removed"
  else
    identity_verify_admin up
    identity_reconcile_ui_urls
    identity_reconcile_realm_policy up
    identity_reconcile_idp_watch_client up
  fi
  identity_verify_cli up
  # The PingFederate plan, when it exists, is applied to the realm here as well
  # (auth apply does it first); without the plan a leftover provider is removed.
  identity_apply_idp up
  # Reconcile idp-watch after broker plan is applied
  if [[ "$(env_value IDP_WATCH_ENABLED)" == true && -f "$SCRIPT_DIR/$IDENTITY_IDP_PLAN" ]]; then
    local watch_sha sso
    sso="$(sso_dir)"
    watch_sha="$(python3 -c 'import hashlib, sys, os; h=hashlib.sha256(); [h.update(open(p, "rb").read()) for p in sys.argv[1:] if os.path.isfile(p)]; print(h.hexdigest()[:32])' "$sso/idp_watch.py" "$SCRIPT_DIR/$IDENTITY_IDP_PLAN")$(env_value KRATE_TRUSTSTORE_SHA)"
    if [[ "$(env_value KRATE_IDP_WATCH_SHA)" != "$watch_sha" ]]; then
      set_env_file_value "$ENV_FILE" KRATE_IDP_WATCH_SHA "$watch_sha"
      IDENTITY_CHANGED=true
    fi
    identity_compose --profile idp-watch up -d --pull never --no-build --no-deps --wait --wait-timeout "$IDENTITY_TIMEOUT" idp-watch
  else
    local watch_cid
    watch_cid="$(identity_container idp-watch 2>/dev/null || echo "")"
    if [[ -n "$watch_cid" ]]; then
      identity_compose --profile idp-watch stop idp-watch >/dev/null 2>&1 || true
    fi
  fi
  if [[ "$(env_value KEYCLOAK_ENABLED)" != true ]]; then
    set_env_file_value "$ENV_FILE" KEYCLOAK_ENABLED true
    ok "Set KEYCLOAK_ENABLED=true in .env (Keycloak now starts and stops with the cluster)"
    IDENTITY_CHANGED=true
  fi
  if $IDENTITY_CHANGED; then
    identity_journal up ok "state=$state"
  else
    identity_journal up no-change ""
    ok "No changes"
  fi
  echo ""
  cmd_identity_status
}

# Recreate the permanent master admin from .env: with Keycloak stopped, a
# temporary bootstrap admin is made with Keycloak's own command, Keycloak is
# started, the permanent admin is created or re-keyed through it, and the
# temporary account is deleted. An explicit operator action, never automatic.
cmd_identity_recover_admin() {
  prepare_identity_env; require_env
  identity_lock
  local state kc db db_state temp temp_pw
  state="$(identity_state)" || exit 1
  case "${state%% *}" in
    existing) ;;
    pristine) die "No identity database exists yet. Run: krate identity up" ;;
    *) identity_journal recover-admin refused "${state#unknown }"
       die "Cannot tell whether an identity database exists: ${state#unknown }" ;;
  esac
  kc="$(identity_container keycloak)"
  [[ "$(container_status "$kc")" != running ]] || die "Keycloak is running; stop it first: krate identity down"
  # Same name rule as the identity preflight (lower-case, not temp-admin*).
  python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import identity; identity.admin_user(identity.read_env(sys.argv[2]))' \
    "$(sso_dir)" "$ENV_FILE" || die "KEYCLOAK_ADMIN_USER is not a valid admin name: krate config set KEYCLOAK_ADMIN_USER=admin"
  case "$(env_value KEYCLOAK_ADMIN_PASSWORD)" in
    ""|REPLACE_ME|changeme) die "KEYCLOAK_ADMIN_PASSWORD is not set in .env; the recovered admin takes its password from there" ;;
  esac
  prepare_identity_files recover-admin
  require_service_images keycloak-db keycloak
  info "Starting the identity database..."
  identity_up_service keycloak-db
  db="$(identity_container keycloak-db)"
  db_state="$(identity_db_state "$db")" || exit 1
  [[ "$db_state" != unbootstrapped ]] || die "The identity database has no master realm yet; the first start creates it: krate identity up"
  temp="temp-admin-$(random_secret 8)"
  temp="${temp,,}"
  temp_pw="$(random_secret 24)"
  identity_bootstrap_master "$temp" "$temp_pw" recover-admin
  info "Starting Keycloak..."
  identity_up_service keycloak
  identity_bootstrap_admin "$temp" "$temp_pw"
  identity_verify_cli recover-admin
  identity_journal recover-admin ok "permanent admin $(env_value KEYCLOAK_ADMIN_USER) recreated; $temp removed"
  ok "Admin $(env_value KEYCLOAK_ADMIN_USER) recovered. Next: krate identity up"
}

# Probe Keycloak from inside its container (it has bash, no curl): the
# management port 9000 is never published, and 8080 only through the proxy.
keycloak_http_probe() {
  docker exec "$1" bash -ec "{ printf 'GET $3 HTTP/1.0\r\nHost: localhost\r\n\r\n' >&0; grep -q 'HTTP/1.0 200'; } 0<>/dev/tcp/127.0.0.1/$2" >/dev/null 2>&1
}

# One line per probe; exit 1 unless the database is healthy, Keycloak is
# ready and live, and the realm answers.
cmd_identity_status() {
  require_compose; require_compose_file; require_env
  local db kc ready=true health started=no live=no kc_ready=no realm=absent probe
  db="$(identity_container keycloak-db)"
  kc="$(identity_container keycloak)"
  health="$(container_health "$db")"
  [[ "$health" == healthy ]] || ready=false
  printf "  %-22s %s\n" "keycloak-db" "$health"
  if [[ "$(container_status "$kc")" == running ]]; then
    for probe in started ready live; do
      if keycloak_http_probe "$kc" 9000 "/health/$probe"; then
        case "$probe" in started) started=yes ;; ready) kc_ready=yes ;; live) live=yes ;; esac
      fi
    done
    if keycloak_http_probe "$kc" 8080 "/identity/realms/$IDENTITY_REALM"; then realm=present; fi
    printf "  %-22s started %s, ready %s, live %s\n" "keycloak" "$started" "$kc_ready" "$live"
  else
    printf "  %-22s %s\n" "keycloak" "$(container_status "$kc")"
  fi
  [[ "$kc_ready" == yes && "$live" == yes ]] || ready=false
  printf "  %-22s %s\n" "realm $IDENTITY_REALM" "$realm"
  [[ "$realm" == present ]] || ready=false
  printf "  %-22s %s\n" "KEYCLOAK_ENABLED" "$(env_value KEYCLOAK_ENABLED)"
  if [[ "$(env_value IDP_WATCH_ENABLED)" == true ]]; then
    local watch_cid watch_status watch_health
    watch_cid="$(identity_container idp-watch)"
    watch_status="$(container_status "$watch_cid")"
    watch_health="$(container_health "$watch_cid")"
    printf "  %-22s %s (%s)\n" "idp-watch" "$watch_status" "$watch_health"
    if [[ "$watch_status" == running ]]; then
      local watch_state hb_age
      watch_state="$(docker exec "$watch_cid" python3 -c 'import json, os; s=json.load(open("/var/run/idp_watch/state.json")) if os.path.isfile("/var/run/idp_watch/state.json") else {}; print(s.get("state", "UNKNOWN") + " (enabled=" + str(s.get("enabled", "unknown")) + ")")' 2>/dev/null || echo "unknown")"
      printf "  %-22s %s\n" "idp fallback state" "$watch_state"
      hb_age="$(docker exec "$watch_cid" python3 -c 'import os, time; p="/var/run/idp_watch/heartbeat"; print(int(time.time() - os.path.getmtime(p)) if os.path.isfile(p) else -1)' 2>/dev/null || echo -1)"
      if [[ "$hb_age" -ge 0 && "$hb_age" -gt 30 ]]; then
        warn "idp-watch heartbeat is stale (${hb_age}s old)"
      fi
    else
      warn "idp-watch is not running (IdP fallback watcher offline)"
    fi
  fi
  if [[ -f "$SCRIPT_DIR/auth/identity-journal.log" ]]; then
    echo "  journal (last 5):"
    tail -n 5 "$SCRIPT_DIR/auth/identity-journal.log" | sed 's/^/    /'
  fi
  if $ready; then
    ok "Identity is ready"
  else
    warn "Identity is not ready. Run: krate identity up   Logs: krate logs keycloak"
    return 1
  fi
}

# True when Keycloak serves the realm (the status probes, quietly).
identity_ready() {
  cmd_identity_status >/dev/null 2>&1
}

cmd_identity_down() {
  require_compose; require_compose_file; require_env
  identity_lock
  info "Stopping Keycloak and its database (data kept)..."
  identity_compose stop keycloak keycloak-db
  identity_journal down ok "keycloak and keycloak-db stopped; volume kept"
  ok "Stopped. Start again with: krate identity up"
}

# Usernames are stored lower-case by Keycloak; keep the set simple.
identity_username() {
  local u="${1,,}"
  [[ "$u" =~ ^[a-z0-9][a-z0-9._@-]{0,62}$ ]] || die "Invalid username '$1' (letters, digits, . _ @ -)"
  echo "$u"
}

identity_users_usage() {
  die "Usage: krate identity users list
       krate identity users add <username> [--admin|--viewer] [--email <address>]
       krate identity users {enable|disable|reset-password|groups|logout} <username>
       krate identity users set-email <username> <address>"
}

# The e-mail address the CLI accepts: one @ and no whitespace (Keycloak checks the
# rest). Shared by `users add --email` and `users set-email`.
identity_email_address() {
  local address="${1:-}"
  [[ "$address" == *@* && "$address" != *[[:space:]]* ]] || return 1
  printf '%s' "$address"
}

# True while a monitoring UI signs people in through the Krate realm: Grafana with
# GRAFANA_AUTH_CONFIG=realm.ini, Perses with PERSES_IDP=krate. Such a UI needs the
# user's address — Grafana reads it from userinfo and refuses a sign-in without it,
# Perses' oauth2-proxy answers 500 "email in id_token (…) isn't verified" — so
# `users add` requires --email and marks the address verified.
identity_realm_ui() {
  local env_file="$MONITOR_DIR/.env"
  [[ "$(env_value_file "$env_file" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]] && return 0
  [[ "$(env_value_file "$env_file" PERSES_IDP)" == krate ]] && return 0
  return 1
}

# A user's temporary password: generated, shown once, must be changed at the
# first login (UPDATE_PASSWORD) which also enrols the authenticator (CONFIGURE_TOTP).
identity_set_temp_password() {
  local user="$1" uid="$2" temp
  temp="$(random_secret 16)"
  kcadm "KC_CLI_PASSWORD=$temp" -- set-password -r "$IDENTITY_REALM" --username "$user" --temporary
  kcadm -- update "users/$uid" -r "$IDENTITY_REALM" -s "requiredActions=$IDENTITY_USER_ACTIONS"
  echo ""
  echo "  Temporary password for $user (shown once; a new one is required at first login):"
  echo "  $temp"
  echo ""
}

cmd_identity_users() {
  local action="${1:-}" user="" group="" email="" uid gid
  shift || true
  case "$action" in
    list) ;;
    add)
      user="$(identity_username "${1:-}")"; shift || identity_users_usage
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --admin)  group="$(env_value KEYCLOAK_ADMIN_GROUP)"; group="${group:-KRATE_ADMINS}"; shift ;;
          --viewer) group="$(env_value KEYCLOAK_VIEWER_GROUP)"; group="${group:-KRATE_VIEWERS}"; shift ;;
          --email)
            email="$(identity_email_address "${2:-}")" || die "--email needs an address"
            shift 2 ;;
          *) identity_users_usage ;;
        esac
      done
      ;;
    enable|disable|reset-password|groups|logout)
      [[ $# -eq 1 ]] || identity_users_usage
      user="$(identity_username "$1")"
      ;;
    set-email)
      [[ $# -eq 2 ]] || identity_users_usage
      user="$(identity_username "$1")"
      email="$(identity_email_address "$2")" || die "set-email needs an address"
      ;;
    *) identity_users_usage ;;
  esac
  # A monitoring UI on the realm needs the user's address, so it is not optional then.
  if [[ "$action" == add ]] && identity_realm_ui && [[ -z "$email" ]]; then
    die "--email is required while a monitoring UI signs in through the Krate realm (GRAFANA_AUTH_CONFIG=realm.ini or PERSES_IDP=krate): Grafana reads the address from userinfo and Perses refuses a user without one"
  fi
  require_compose; require_compose_file; require_env
  [[ "$action" == list || "$action" == groups ]] || identity_lock
  kcadm_login "$IDENTITY_REALM" client krate-cli "$(env_value KEYCLOAK_CLI_CLIENT_SECRET)" \
    || die "Keycloak refused the krate-cli client login. Check: krate identity status"
  if [[ -n "$user" && "$action" != add ]]; then
    uid="$(kcadm_user_id "$IDENTITY_REALM" "$user")" || die "Keycloak query failed"
    [[ -n "$uid" ]] || die "No user $user in realm $IDENTITY_REALM"
  fi
  case "$action" in
    list)
      printf "  %-32s %-8s %s\n" USERNAME ENABLED EMAIL
      kcadm -- get users -r "$IDENTITY_REALM" --offset 0 --limit 1000 --fields username,enabled,email --format csv --noquotes \
        | awk -F, '{ printf "  %-32s %-8s %s\n", $1, $2, $3 }'
      ;;
    add)
      uid="$(kcadm_user_id "$IDENTITY_REALM" "$user")" || die "Keycloak query failed"
      [[ -z "$uid" ]] || die "User $user already exists"
      # The group is resolved first: a failure after the user exists would leave a
      # half-made account that a retry reports as "already exists".
      if [[ -n "$group" ]]; then
        gid="$(kcadm_group_id "$IDENTITY_REALM" "$group")" || die "Keycloak query failed"
        [[ -n "$gid" ]] || die "Group $group does not exist in realm $IDENTITY_REALM (KEYCLOAK_VIEWER_GROUP/KEYCLOAK_ADMIN_GROUP changed after the realm was created? See the guide: rename it in Keycloak, or set .env back)"
      fi
      if [[ -n "$email" ]]; then
        # Verified because the operator typed the address: a realm UI refuses an
        # unverified one (oauth2-proxy: 500 "email in id_token (…) isn't verified").
        kcadm -- create users -r "$IDENTITY_REALM" -s "username=$user" -s enabled=true -s "email=$email" -s emailVerified=true >/dev/null
      else
        kcadm -- create users -r "$IDENTITY_REALM" -s "username=$user" -s enabled=true >/dev/null
      fi
      uid="$(kcadm_user_id "$IDENTITY_REALM" "$user")" || die "Keycloak query failed"
      [[ -n "$uid" ]] || die "User $user was not created"
      if [[ -n "$group" ]]; then
        kcadm -- update "users/$uid/groups/$gid" -r "$IDENTITY_REALM" -s "realm=$IDENTITY_REALM" -s "userId=$uid" -s "groupId=$gid" -n
      fi
      identity_set_temp_password "$user" "$uid"
      identity_journal "users add" ok "$user${group:+ group=$group}"
      ok "User $user created${group:+ in group $group}"
      ;;
    enable|disable)
      local enabled=true
      [[ "$action" == enable ]] || enabled=false
      kcadm -- update "users/$uid" -r "$IDENTITY_REALM" -s "enabled=$enabled"
      identity_journal "users $action" ok "$user"
      ok "User $user ${action}d"
      ;;
    reset-password)
      identity_set_temp_password "$user" "$uid"
      identity_journal "users reset-password" ok "$user"
      ok "Temporary password set for $user"
      ;;
    groups)
      kcadm -- get "users/$uid/groups" -r "$IDENTITY_REALM" --fields name --format csv --noquotes | sed 's/^/  /'
      ;;
    logout)
      # Ends every session of this user in the realm; Keycloak then posts a back-channel
      # logout token to each client of those sessions that has a reachable URL, so Kafbat
      # ends at once (harness/phase4/lab1 K-a: 204, tokens within ~25 ms). The realm's
      # "Sign out all active sessions" sends no logout token, so a live Kafbat session
      # survives it until its idle limit or the session maximum, whichever comes first.
      # kcadm rejects the no-merge flag on this resource (rc 2); krate-cli's
      # manage-users scope is enough
      # (harness/phase4/lab6 L5-8).
      kcadm -- create "users/$uid/logout" -r "$IDENTITY_REALM"
      identity_journal "users logout" ok "$user"
      ok "Sessions of $user ended; the next access needs a new sign-in"
      ;;
    set-email)
      # Verified because the operator typed the address. This is also the way to verify
      # the address of a user brokered in before the provider trusted it.
      kcadm -- update "users/$uid" -r "$IDENTITY_REALM" -s "email=$email" -s emailVerified=true
      identity_journal "users set-email" ok "$user"
      ok "E-mail address of $user set and marked verified"
      ;;
  esac
  kcadm_logout
}

# Change a Keycloak credential in its authoritative store first, then in .env,
# then recreate the consumer and verify. A value is generated unless --value
# reads one from stdin (never from an argument).
# `identity rotate` of a secret the plan carries ends in a read of the PingFederate plan: the
# provider update (PING_KEYCLOAK_CLIENT_SECRET) or the preflight of the kafka-ui recreate
# (KEYCLOAK_KAFBAT_CLIENT_SECRET in runtime.yml mode). Both come after the first write, and both
# refuse a plan that states no MFA stance, so the plan is read through the same validator
# (identity.py broker_plan) before preparation syncs image pins in .env: a refusal leaves .env, Keycloak and the
# containers as they were.
identity_rotate_plan_check() {
  local plan="$SCRIPT_DIR/$IDENTITY_IDP_PLAN"
  case "$1" in
    PING_KEYCLOAK_CLIENT_SECRET) ;;
    KEYCLOAK_KAFBAT_CLIENT_SECRET) [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == runtime.yml ]] || return 0 ;;
    *) return 0 ;;
  esac
  [[ -f "$plan" ]] || return 0
  command -v python3 >/dev/null || die "python3 is required for krate identity"
  python3 "$(sso_dir)/identity.py" broker --plan "$plan" provider >/dev/null \
    || die "Nothing was rotated: $IDENTITY_IDP_PLAN is refused (see above). Fix the site file, run krate auth configure <site.json>, then rotate again."
}

cmd_identity_rotate() {
  local key="${1:-}" value state client cid id json q
  case "$key" in
    KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET|KEYCLOAK_IDP_WATCH_CLIENT_SECRET) ;;
    PING_KEYCLOAK_CLIENT_SECRET)
      # Issued by PingFederate, never generated here: the value comes from stdin (or a terminal prompt).
      [[ "${2:-}" == --value ]] || die "PING_KEYCLOAK_CLIENT_SECRET is issued by PingFederate: krate identity rotate PING_KEYCLOAK_CLIENT_SECRET --value (reads it from stdin, or asks on a terminal)" ;;
    *) die "Usage: krate identity rotate {KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET|KEYCLOAK_IDP_WATCH_CLIENT_SECRET} [--value] | PING_KEYCLOAK_CLIENT_SECRET --value" ;;
  esac
  [[ $# -eq 1 || "${2:-}" == --value ]] || die "Usage: krate identity rotate <KEY> [--value]   (--value reads the new value from stdin)"
  identity_rotate_plan_check "$key"
  prepare_identity_env; require_env
  identity_lock
  state="$(identity_state)" || exit 1
  [[ "${state%% *}" == existing ]] || die "Nothing to rotate: no identity database (state: $state). Run: krate identity up"
  if [[ "${2:-}" == --value ]]; then
    if [[ -t 0 ]]; then
      read -rsp "  New value for $key: " value; echo ""
    else
      IFS= read -r value || true
    fi
    # The set .env quoting, Compose interpolation and SQL/JSON bodies all
    # pass unchanged (generated values are letters and digits). A secret issued
    # by PingFederate is taken as issued, except for whitespace and the
    # characters .env quoting, Compose interpolation ($) and the shell alter.
    if [[ "$key" == PING_KEYCLOAK_CLIENT_SECRET ]]; then
      ping_secret_valid "$value" || die "$key $PING_SECRET_RULE"
    else
      [[ "$value" =~ ^[A-Za-z0-9._-]{16,}$ ]] || die "$key must be at least 16 characters of letters, digits, . _ or -"
    fi
    # The identity preflight requires distinct credentials; refuse reuse before any store changes.
    local other
    for other in KEYCLOAK_DB_PASSWORD KEYCLOAK_ADMIN_PASSWORD KEYCLOAK_CLI_CLIENT_SECRET KEYCLOAK_KAFBAT_CLIENT_SECRET KEYCLOAK_IDP_WATCH_CLIENT_SECRET KAFKA_UI_PASSWORD PING_KEYCLOAK_CLIENT_SECRET; do
      [[ "$other" == "$key" || "$(env_value "$other")" != "$value" ]] || die "$key must not reuse the value of $other (every identity and UI credential must be distinct)"
    done
  else
    value="$(random_secret 24)"
  fi
  case "$key" in
    KEYCLOAK_DB_PASSWORD)
      cid="$(identity_container keycloak-db)"
      [[ "$(container_health "$cid")" == healthy ]] || die "keycloak-db is not healthy. Run: krate identity up"
      # Over the container's local socket (pg_hba: trust); the statement goes
      # through stdin. A quote in the value is doubled for SQL.
      q="'"
      printf "ALTER ROLE keycloak WITH PASSWORD '%s';\n" "${value//$q/$q$q}" \
        | docker exec -i "$cid" psql -q -v ON_ERROR_STOP=1 -U keycloak -d keycloak >/dev/null \
        || { identity_journal rotate failed "$key: ALTER ROLE refused"; die "PostgreSQL refused the new password."; }
      set_env_file_value "$ENV_FILE" "$key" "$value"
      info "Recreating Keycloak with the new database password..."
      identity_compose up -d --pull never --no-build --no-deps --force-recreate --wait --wait-timeout "$IDENTITY_TIMEOUT" keycloak
      identity_verify_admin rotate
      ;;
    KEYCLOAK_ADMIN_PASSWORD)
      identity_verify_admin rotate >/dev/null
      kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
      kcadm "KC_CLI_PASSWORD=$value" -- set-password -r master --username "$(env_value KEYCLOAK_ADMIN_USER)"
      kcadm_logout
      set_env_file_value "$ENV_FILE" "$key" "$value"
      identity_verify_admin rotate
      ;;
    KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET|KEYCLOAK_IDP_WATCH_CLIENT_SECRET)
      client=krate-cli
      if [[ "$key" == KEYCLOAK_KAFBAT_CLIENT_SECRET ]]; then
        client=krate-ui
      elif [[ "$key" == KEYCLOAK_IDP_WATCH_CLIENT_SECRET ]]; then
        client=krate-idp-watch
      fi
      identity_verify_admin rotate >/dev/null
      kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
      id="$(kcadm_client_id "$IDENTITY_REALM" "$client")" || die "Keycloak query failed"
      [[ -n "$id" ]] || die "Client $client not found in realm $IDENTITY_REALM"
      # The body goes through stdin (-f -), merged into the client.
      json="${value//\\/\\\\}"; json="${json//\"/\\\"}"
      printf '{"secret":"%s"}\n' "$json" | KCADM_STDIN=1 kcadm -- update "clients/$id" -r "$IDENTITY_REALM" -f - -m
      kcadm_logout
      set_env_file_value "$ENV_FILE" "$key" "$value"
      if [[ "$client" == krate-cli ]]; then
        identity_verify_cli rotate
      elif [[ "$client" == krate-idp-watch ]]; then
        if [[ "$(env_value IDP_WATCH_ENABLED)" == true && -f "$SCRIPT_DIR/$IDENTITY_IDP_PLAN" ]]; then
          info "Recreating idp-watch with the new client secret..."
          identity_compose --profile idp-watch up -d --pull never --no-build --no-deps --force-recreate --wait --wait-timeout "$IDENTITY_TIMEOUT" idp-watch \
            || die "Failed to recreate idp-watch with new secret"
          local watch_cid
          watch_cid="$(identity_container idp-watch)"
          [[ -n "$watch_cid" ]] || die "idp-watch container not found after recreation"
          docker exec "$watch_cid" python3 /opt/krate/idp_watch.py --test-token >/dev/null \
            || die "Failed to verify token acquisition inside idp-watch with new secret"
        fi
      elif [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == runtime.yml ]]; then
        info "Recreating Kafbat UI with the new client secret..."
        compose_cmd up -d --pull never --no-build --no-deps --force-recreate --wait --wait-timeout "$IDENTITY_TIMEOUT" kafka-ui
      fi
      ;;
    PING_KEYCLOAK_CLIENT_SECRET)
      set_env_file_value "$ENV_FILE" "$key" "$value"
      identity_rotate_ping_secret
      # The key is part of keycloak's Compose environment (the realm import substitutes it), so
      # `up` recreates the container now rather than at the next start or apply.
      info "Reconciling Keycloak's environment with the new secret..."
      identity_up_service keycloak
      ;;
  esac
  identity_journal rotate ok "$key"
  ok "$key rotated in Keycloak and .env"
}

# The backup passphrase: KRATE_BACKUP_PASSPHRASE, or asked on a terminal
# (twice when $1 is confirm). Exported for openssl's -pass env:.
identity_passphrase() {
  local p1 p2
  if [[ -n "${KRATE_BACKUP_PASSPHRASE:-}" ]]; then
    [[ ${#KRATE_BACKUP_PASSPHRASE} -ge 8 ]] || die "KRATE_BACKUP_PASSPHRASE must be at least 8 characters."
    export KRATE_BACKUP_PASSPHRASE
    return 0
  fi
  [[ -t 0 ]] || die "Set KRATE_BACKUP_PASSPHRASE in the environment, or run on a terminal to be asked for it."
  read -rsp "  Backup passphrase: " p1; echo ""
  if [[ "${1:-}" == confirm ]]; then
    read -rsp "  Repeat the passphrase: " p2; echo ""
    [[ "$p1" == "$p2" ]] || die "The passphrases differ."
  fi
  [[ ${#p1} -ge 8 ]] || die "The passphrase must be at least 8 characters."
  export KRATE_BACKUP_PASSPHRASE="$p1"
}

# The .env keys a backup carries beside the database dump: what Keycloak was
# initialised with and the dump expects. The database password is a role of
# the database, not part of the dump, so it stays with the volume.
IDENTITY_BACKUP_KEYS=(KEYCLOAK_ADMIN_USER KEYCLOAK_ADMIN_PASSWORD KEYCLOAK_CLI_CLIENT_SECRET KEYCLOAK_KAFBAT_CLIENT_SECRET KEYCLOAK_IDP_WATCH_CLIENT_SECRET)
IDENTITY_ENC=(-aes-256-cbc -pbkdf2 -iter 600000 -salt -pass env:KRATE_BACKUP_PASSPHRASE)

# An encrypted tar of db.dump (pg_dump -Fc) and identity.env (the keys above).
cmd_identity_backup() {
  local file="${1:-}" cid tmp work key
  [[ -n "$file" ]] || die "Usage: krate identity backup <file>"
  [[ ! -e "$file" ]] || die "$file exists; choose another name."
  require_compose; require_compose_file; require_env
  identity_lock
  cid="$(identity_container keycloak-db)"
  [[ "$(container_health "$cid")" == healthy ]] || die "keycloak-db is not running. Run: krate identity up"
  identity_passphrase confirm
  identity_tmpdir; work="$IDENTITY_TMPDIR"
  tmp="$(mktemp "$(dirname "$file")/.identity-backup.XXXXXX")" || die "Cannot write beside $file"
  chmod 600 "$tmp"
  info "Dumping and encrypting the identity database..."
  if ! docker exec "$cid" pg_dump -Fc -U keycloak keycloak > "$work/db.dump"; then
    rm -f "$tmp"
    identity_journal backup failed "$file: pg_dump"
    die "Backup failed: pg_dump reported errors above."
  fi
  for key in "${IDENTITY_BACKUP_KEYS[@]}"; do
    printf '%s=%s\n' "$key" "$(env_value "$key")"
  done > "$work/identity.env"
  # Encrypt, then seal the ciphertext with an HMAC-SHA256 under a separately
  # derived key: restore verifies the tag before it decrypts anything.
  if ! tar -C "$work" -cf - db.dump identity.env | openssl enc "${IDENTITY_ENC[@]}" -out "$work/payload.enc" \
      || ! python3 "$(sso_dir)/identity.py" backup-seal --input "$work/payload.enc" --output "$tmp"; then
    rm -f "$tmp"
    identity_journal backup failed "$file: encryption"
    die "Backup failed: the archive could not be encrypted and sealed."
  fi
  mv -f "$tmp" "$file"
  identity_journal backup ok "$file $(wc -c < "$file" | xargs) bytes"
  ok "Encrypted backup written to $file (mode 600). Keep the passphrase: krate identity restore $file needs it."
}

# Restore a backup into the identity database (keycloak-db is started, a lost
# volume is recreated), take over the .env keys the backup carries, then
# start Keycloak and verify the admin and krate-cli logins.
cmd_identity_restore() {
  local file="${1:-}" cid kc state reason work key value changed=""
  [[ -f "$file" ]] || die "Usage: krate identity restore <file>"
  prepare_identity_env; require_env
  identity_lock
  state="$(identity_state)" || exit 1
  reason="${state#unknown }"
  state="${state%% *}"
  case "$state" in
    existing) ;;
    pristine) warn "No identity database volume exists (lost or never created); restoring into a new one" ;;
    *) identity_journal restore refused "$reason"
       die "Cannot tell whether an identity database exists: $reason" ;;
  esac
  kc="$(identity_container keycloak)"
  [[ "$(container_status "$kc")" != running ]] || die "Keycloak is running; stop it first: krate identity down"
  identity_passphrase
  identity_tmpdir; work="$IDENTITY_TMPDIR"
  info "Verifying and decrypting $file..."
  # The HMAC tag is checked first; a modified archive never reaches openssl, tar or pg_restore.
  if ! python3 "$(sso_dir)/identity.py" backup-open --input "$file" --output "$work/payload.enc"; then
    identity_journal restore refused "$file: integrity check failed"
    die "Refusing $file: the integrity check failed (modified file or wrong passphrase), or it is not a krate identity backup."
  fi
  if ! openssl enc -d "${IDENTITY_ENC[@]}" -in "$work/payload.enc" | tar -C "$work" -xf -; then
    identity_journal restore failed "$file: cannot decrypt or unpack"
    die "Cannot read $file: wrong passphrase, or not a krate identity backup."
  fi
  [[ -f "$work/db.dump" && -f "$work/identity.env" ]] || die "$file is not a krate identity backup (db.dump and identity.env expected)."
  # Keys .env lacks (a lost .env, or a new host) come from the backup before
  # the site files are prepared; the rest is reconciled after the restore.
  for key in "${IDENTITY_BACKUP_KEYS[@]}"; do
    value="$(env_value_file "$work/identity.env" "$key")"
    case "$(env_value "$key")" in ""|REPLACE_ME) ;; *) continue ;; esac
    [[ -n "$value" ]] || continue
    set_env_file_value "$ENV_FILE" "$key" "$value"
    changed+=" $key"
  done
  case "$(env_value KEYCLOAK_DB_PASSWORD)" in
    ""|REPLACE_ME) [[ "$state" == pristine ]] || die "The identity database exists but .env lacks KEYCLOAK_DB_PASSWORD (a database role, not part of a backup). Restore the .env of this installation first." ;;
  esac
  prepare_identity "$state" restore
  cid="$(identity_container keycloak-db)"
  if [[ "$(container_health "$cid")" != healthy ]]; then
    require_service_images keycloak-db
    identity_up_service keycloak-db
    cid="$(identity_container keycloak-db)"
  fi
  info "Restoring the identity database from $file..."
  if ! docker exec -i "$cid" pg_restore --clean --if-exists --single-transaction --no-owner -U keycloak -d keycloak < "$work/db.dump"; then
    identity_journal restore failed "$file: pg_restore"
    die "pg_restore reported errors above; the database may be partially restored.
Run again: krate identity restore $file
If that keeps failing, follow the volume-lost procedure in docs/identity-foundation.md (sso/guides/ in a checkout)"
  fi
  for key in "${IDENTITY_BACKUP_KEYS[@]}"; do
    value="$(env_value_file "$work/identity.env" "$key")"
    [[ -n "$value" && "$value" != "$(env_value "$key")" ]] || continue
    set_env_file_value "$ENV_FILE" "$key" "$value"
    changed+=" $key"
  done
  if [[ -n "$changed" ]]; then
    identity_journal restore reconciled ".env:$changed"
    ok "Set$changed in .env from the backup"
  fi
  require_service_images keycloak
  info "Starting Keycloak..."
  identity_up_service keycloak
  identity_verify_admin restore
  identity_verify_cli restore
  # The dump carries the backup host's krate-ui URLs; on a recovery host they must
  # follow this installation's plan before the restore is reported complete.
  prepare_identity_files restore
  identity_reconcile_ui_urls restore
  identity_reconcile_realm_policy restore
  identity_reconcile_idp_watch_client restore
  identity_journal restore ok "$file"
  ok "Identity database restored from $file"
}

# Wait until the identity service $1 reports healthy (IDENTITY_TIMEOUT); $2
# names the command for the journal.
# Returns 1 when the service is not healthy within IDENTITY_TIMEOUT (no exit).
identity_health_wait() {
  local cid waited=0
  cid="$(identity_container "$1")"
  until [[ "$(container_health "$cid")" == healthy ]]; do
    (( waited < IDENTITY_TIMEOUT )) || return 1
    sleep 3
    waited=$((waited + 3))
  done
}

identity_wait_healthy() {
  local service="$1" command="$2"
  identity_health_wait "$service" && return 0
  identity_journal "$command" failed "$service not healthy within ${IDENTITY_TIMEOUT}s after restart"
  die "Service $service did not become healthy within the ${IDENTITY_TIMEOUT}s timeout (IDENTITY_TIMEOUT). Check: krate logs $service"
}

# Put the database TLS files of the last renewal back (.prev) and restart the
# given services on them, in order, then stop: $1 is the reason for the journal.
identity_tls_rollback() {
  local reason="$1" service
  shift
  warn "$reason; restoring the previous certificate files"
  python3 "$(sso_dir)/identity.py" db-tls --rollback --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" \
    || die "Rollback failed: restore auth/keycloak/db-tls from a backup. Check: krate logs keycloak-db"
  for service in "$@"; do
    if ! identity_compose restart --no-deps "$service" || ! identity_health_wait "$service"; then
      warn "$service is not healthy after the rollback. Check: krate logs $service"
    fi
  done
  identity_journal renew-db-tls "rolled back" "$reason; previous files restored"
  die "Database TLS renewal rolled back; the previous certificate is in place. Check: krate logs $*"
}

# Reissue keycloak-db's server key and certificate under the existing CA (398
# days; the CA, Keycloak's trust store, is unchanged), then restart the
# database alone so PostgreSQL loads them (the entrypoint wrapper copies the
# files at container start). Keycloak's connections drop with that restart;
# it is restarted only when it does not report ready again on its own. When
# the CA had to be renewed too, Keycloak is restarted, and the previous files
# are discarded only once it is healthy and accepts the admin login; a failure
# at either restart rolls both files and services back.
cmd_identity_renew_db_tls() {
  prepare_identity_env; require_env
  identity_lock
  local state db kc renewed tries=0 keycloak_running=true
  state="$(identity_state)" || exit 1
  [[ "${state%% *}" == existing ]] || die "No identity database whose certificate could be renewed (state: $state). Run: krate identity up"
  db="$(identity_container keycloak-db)"
  [[ "$(container_status "$db")" == running ]] || die "keycloak-db is not running. Run: krate identity up"
  kc="$(identity_container keycloak)"
  [[ "$(container_status "$kc")" == running ]] || keycloak_running=false
  renewed="$(python3 "$(sso_dir)/identity.py" db-tls --renew-server --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls")" \
    || { identity_journal renew-db-tls failed "server certificate not reissued"; exit 1; }
  ok "$renewed"
  local ca_renewed=false
  [[ "$renewed" != "renewed CA and"* ]] || ca_renewed=true
  info "Restarting the identity database with the new certificate..."
  # The previous files stay beside the new ones (.prev) until the services that
  # depend on them have proven they work with the new ones.
  if ! identity_compose restart --no-deps keycloak-db || ! identity_health_wait keycloak-db; then
    identity_tls_rollback "keycloak-db unhealthy with the renewed certificate" keycloak-db
  fi
  if $keycloak_running && $ca_renewed; then
    # The database's healthcheck never exercises Keycloak's trust in the new CA: Keycloak
    # must come back healthy and accept the admin login (both read the database over the
    # new chain) before the previous CA is discarded. Otherwise both roll back.
    info "The CA changed; restarting Keycloak so it trusts the new one..."
    if ! identity_compose restart --no-deps keycloak || ! identity_health_wait keycloak \
        || ! kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)"; then
      kcadm_logout
      identity_tls_rollback "keycloak did not accept the renewed CA" keycloak-db keycloak
    fi
    kcadm_logout
    python3 "$(sso_dir)/identity.py" db-tls --discard-previous --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" >/dev/null
    ok "Admin login as $(env_value KEYCLOAK_ADMIN_USER) verified"
  elif $keycloak_running; then
    # Same CA: Keycloak's trust is unchanged, the database's health settles it.
    python3 "$(sso_dir)/identity.py" db-tls --discard-previous --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" >/dev/null
    until identity_ready; do
      tries=$((tries + 1))
      if (( tries >= 10 )); then
        info "Keycloak did not reconnect on its own; restarting it..."
        identity_compose restart --no-deps keycloak
        identity_wait_healthy keycloak renew-db-tls
        break
      fi
      sleep 3
    done
    identity_verify_admin renew-db-tls
  else
    python3 "$(sso_dir)/identity.py" db-tls --discard-previous --output-dir "$SCRIPT_DIR/auth/keycloak/db-tls" >/dev/null
    warn "Keycloak is not running; it uses the renewed certificate on its next start (krate identity up)"
  fi
  identity_journal renew-db-tls ok "$renewed"
  ok "Database TLS certificate renewed ($renewed)"
}

# The logrotate drop-in for the identity journal, rendered from
# sso/logrotate/krate-identity.conf with this installation's journal path.
# Replacements are literal (no sed/awk metacharacters in the path matter).
identity_logrotate_render() {
  local template
  template="$(sso_dir)/logrotate/krate-identity.conf"
  [[ -f "$template" ]] || die "logrotate template not found: $template"
  KRATE_JOURNAL="$SCRIPT_DIR/auth/identity-journal.log" KRATE_NAME="krate-identity-$KRATE_VARIANT" awk '
    function repl(s, from, to,    out, i) {
      out = ""
      while ((i = index(s, from)) > 0) { out = out substr(s, 1, i - 1) to; s = substr(s, i + length(from)) }
      return out s
    }
    { print repl(repl($0, "__JOURNAL__", ENVIRON["KRATE_JOURNAL"]), "__NAME__", ENVIRON["KRATE_NAME"]) }' "$template"
}

# Print the drop-in, or install it as /etc/logrotate.d/krate-identity-<edition>
# (mode 644; sudo when not root, as ensure_home_dir does). logrotate then
# rotates the journal monthly with copytruncate, so krate's append-only writer
# needs no reopen; 12 rotations are kept, none older than 400 days.
cmd_identity_logrotate() {
  local target="/etc/logrotate.d/krate-identity-$KRATE_VARIANT" rendered
  local -a sudo_cmd=()
  case "${1:-}" in
    "")
      identity_logrotate_render
      echo "" >&2
      echo "Install it as $target with: krate identity logrotate --install" >&2
      ;;
    --install)
      [[ "$SCRIPT_DIR" != *[[:space:]\"\'\\]* ]] || die "The installation path contains whitespace, quotes or a backslash, which the logrotate file cannot carry: $SCRIPT_DIR"
      [[ -d /etc/logrotate.d ]] || die "/etc/logrotate.d not found; install logrotate first (apt-get install logrotate / dnf install logrotate)"
      rendered="$(identity_logrotate_render)" || exit 1
      identity_lock
      if [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
        sudo_cmd=(sudo)
      fi
      info "Installing $target"
      printf '%s\n' "$rendered" | "${sudo_cmd[@]}" tee "$target" >/dev/null || die "Could not write $target (run as root, or with sudo available)"
      "${sudo_cmd[@]}" chmod 644 "$target" || die "Could not set the mode of $target"
      identity_journal logrotate installed "$target"
      ok "Installed $target (monthly, 12 rotations kept, copytruncate). Dry run: sudo logrotate -d $target"
      ;;
    *) die "Usage: krate identity logrotate [--install]" ;;
  esac
}

cmd_identity_idp_watch_status() {
  require_compose; require_compose_file; require_env
  local cid status health state_json hb_age live_enabled
  cid="$(identity_container idp-watch)"
  status="$(container_status "$cid")"
  health="$(container_health "$cid")"
  echo "IdP Reachability Watcher (idp-watch):"
  printf "  %-24s %s (%s)\n" "container" "$status" "$health"
  if [[ "$status" == running ]]; then
    state_json="$(docker exec "$cid" cat /var/run/idp_watch/state.json 2>/dev/null || echo "")"
    hb_age="$(docker exec "$cid" python3 -c 'import os, time; p="/var/run/idp_watch/heartbeat"; print(int(time.time() - os.path.getmtime(p)) if os.path.isfile(p) else -1)' 2>/dev/null || echo -1)"
    if [[ -n "$state_json" ]]; then
      local p_state p_en c_fail c_succ last_err paused
      p_state="$(printf '%s' "$state_json" | json_field state)"
      p_en="$(printf '%s' "$state_json" | json_field enabled)"
      c_fail="$(printf '%s' "$state_json" | json_field consecutive_failures)"
      c_succ="$(printf '%s' "$state_json" | json_field consecutive_successes)"
      last_err="$(printf '%s' "$state_json" | json_field last_error)"
      paused="$(printf '%s' "$state_json" | json_field paused)"
      printf "  %-24s %s (provider enabled: %s)\n" "probe state" "$p_state" "$p_en"
      printf "  %-24s %s\n" "consecutive failures" "${c_fail:-0}"
      printf "  %-24s %s\n" "consecutive successes" "${c_succ:-0}"
      if [[ -n "$last_err" && "$last_err" != null ]]; then
        printf "  %-24s %s\n" "last error" "$last_err"
      fi
      printf "  %-24s %s\n" "paused" "${paused:-false}"
    fi
    if [[ "$hb_age" -ge 0 ]]; then
      printf "  %-24s %ss ago\n" "heartbeat age" "$hb_age"
    fi
  fi
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || true
  live_enabled="$(kcadm -- get "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" --fields enabled --format csv --noquotes 2>/dev/null || echo "unknown")"
  kcadm_logout
  printf "  %-24s %s\n" "Keycloak IdP enabled" "$live_enabled"
}

cmd_identity_idp_watch_reset() {
  require_compose; require_compose_file; require_env
  identity_lock
  local cid img
  img="$(env_value IDP_WATCH_IMAGE)"
  [[ -n "$img" ]] || die "IDP_WATCH_IMAGE is not set in .env"
  info "Re-enabling identity provider $IDENTITY_IDP_ALIAS in Keycloak..."
  kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" || die "admin login failed"
  kcadm -- update "identity-provider/instances/$IDENTITY_IDP_ALIAS" -r "$IDENTITY_REALM" -s enabled=true || die "Keycloak update failed"
  kcadm_logout
  cid="$(identity_container idp-watch)"
  if [[ -n "$cid" ]]; then
    info "Stopping idp-watch, clearing state, and restarting..."
    compose_cmd stop idp-watch >/dev/null 2>&1 || true
    docker run --rm -v "$(cluster_project)_idp_watch_state:/var/run/idp_watch" "$img" rm -f /var/run/idp_watch/state.json /var/run/idp_watch/paused \
      || die "Could not clear watcher state volume"
    identity_compose --profile idp-watch up -d --pull never --no-build --no-deps --wait --wait-timeout "$IDENTITY_TIMEOUT" idp-watch
  fi
  identity_journal "idp-watch reset" ok "provider enabled in Keycloak; state cleared; watcher restarted"
  ok "IdP reachability watcher reset (provider enabled=true, state cleared, watcher restarted)"
}

cmd_identity_idp_watch_pause() {
  require_compose; require_compose_file; require_env
  local cid
  cid="$(identity_container idp-watch)"
  [[ -n "$cid" && "$(container_status "$cid")" == running ]] || die "idp-watch is not running"
  docker exec "$cid" touch /var/run/idp_watch/paused || die "Could not touch pause flag"
  identity_journal "idp-watch pause" ok "watcher paused"
  ok "IdP reachability watcher paused (transitions halted)"
}

cmd_identity_idp_watch_resume() {
  require_compose; require_compose_file; require_env
  local cid
  cid="$(identity_container idp-watch)"
  [[ -n "$cid" && "$(container_status "$cid")" == running ]] || die "idp-watch is not running"
  docker exec "$cid" rm -f /var/run/idp_watch/paused || die "Could not clear pause flag"
  identity_journal "idp-watch resume" ok "watcher resumed"
  ok "IdP reachability watcher resumed"
}

cmd_identity_idp_watch() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    status) cmd_identity_idp_watch_status ;;
    reset)  cmd_identity_idp_watch_reset ;;
    pause)  cmd_identity_idp_watch_pause ;;
    resume) cmd_identity_idp_watch_resume ;;
    *) die "Usage: krate identity idp-watch {status|reset|pause|resume}" ;;
  esac
}

cmd_identity() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    up)            cmd_identity_up ;;
    status)        cmd_identity_status ;;
    down)          cmd_identity_down ;;
    recover-admin) cmd_identity_recover_admin ;;
    renew-db-tls)  cmd_identity_renew_db_tls ;;
    logrotate)     cmd_identity_logrotate "$@" ;;
    users)         cmd_identity_users "$@" ;;
    rotate)        cmd_identity_rotate "$@" ;;
    backup)        cmd_identity_backup "$@" ;;
    restore)       cmd_identity_restore "$@" ;;
    idp-watch)     cmd_identity_idp_watch "$@" ;;
    *)
      echo "Usage: krate identity {up|status|down|recover-admin|users ...|rotate KEY [--value]|backup FILE|restore FILE|renew-db-tls|logrotate [--install]|idp-watch {status|reset|pause|resume}}"
      return 1 ;;
  esac
}

# Returns the name of the first running broker container
find_broker() {
  local services=("kafka-92" "kafka-93" "kafka-94" "kafka-95")
  for svc in "${services[@]}"; do
    local cid
    cid=$(compose_cmd ps -q "$svc" 2>/dev/null || true)
    if [[ -n "$cid" ]]; then
      local status
      status=$(docker inspect --format='{{.State.Status}}' "$cid" 2>/dev/null || echo "")
      if [[ "$status" == "running" ]]; then
        docker inspect --format='{{.Name}}' "$cid" | sed 's|^/||'
        return 0
      fi
    fi
  done
  die "No running broker found. Run: krate start"
}

BOOTSTRAP="kafka-92:9092,kafka-93:9093,kafka-94:9094,kafka-95:9095"

# ─── Preflight helpers ────────────────────────────────────────────────────────
# Resolve a single env var from .env, echoing its value (empty if unset).
env_value() {
  [[ -f "$ENV_FILE" ]] || return 0
  grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'" | xargs 2>/dev/null || true
}

# Host ports this compose file will try to bind, resolved from the file itself
# so each variant reports its own set. Numeric mappings are taken as-is;
# ${VAR:-NNN} mappings are resolved from .env, falling back to the NNN default.
get_published_ports() {
  grep -oE '"[^"]+:[0-9]+"' "$COMPOSE_FILE" 2>/dev/null | tr -d '"' | while IFS= read -r map; do
    local host="${map%:*}"   # strip the container port (everything after the last colon)
    if [[ "$host" =~ ^[0-9]+$ ]]; then
      echo "$host"
    elif [[ "$host" =~ \$\{[^}]+:-[^}]+\} ]]; then   # ${VAR:-DEFAULT}
      local inner="${host#*\$\{}"; inner="${inner%\}}"   # VAR:-DEFAULT
      local var="${inner%%:-*}" def="${inner#*:-}" val
      val="$(env_value "$var")"
      echo "${val:-$def}"
    fi
  done | sort -un
}

# ─── TLS certificate ──────────────────────────────────────────────────────────
# FQDN clients use to reach the UI: KAFKA_UI_FQDN from .env, else the host FQDN.
get_fqdn() {
  local f
  f="$(env_value KAFKA_UI_FQDN)"
  if [[ -z "$f" ]]; then
    # `hostname -f` does a resolver lookup that can hang on air-gapped hosts;
    # cap it and fall back to the short hostname.
    if command -v timeout &>/dev/null; then
      f="$(timeout 2 hostname -f 2>/dev/null || true)"
    else
      f="$(hostname -f 2>/dev/null || true)"
    fi
    [[ -n "$f" ]] || f="$(hostname 2>/dev/null || true)"
  fi
  echo "$f"
}

# A subjectAltName entry for a name: IP: for an IPv4 or IPv6 literal (brackets dropped),
# since browsers match an IP host only against an iPAddress SAN; DNS: otherwise.
san_entry() {
  local name="${1#[}"; name="${name%]}"
  if python3 -c 'import ipaddress, sys; ipaddress.ip_address(sys.argv[1])' "$name" 2>/dev/null; then
    echo "IP:$name"
  else
    echo "DNS:$name"
  fi
}

# Generate a self-signed TLS cert (CN/SAN = FQDN, plus the host IP) for nginx.
ensure_public_cert_readable() {
  local mode
  mode="$(python3 -c 'import os, stat, sys; print(stat.S_IMODE(os.stat(sys.argv[1]).st_mode))' "$CERT_CRT")" \
    || die "Cannot inspect the public TLS certificate at $CERT_CRT."
  if (( (mode & 4) == 0 )); then
    [[ ! -L "$CERT_CRT" ]] || die "Public TLS certificate is a symlink without public read access: $CERT_CRT. Fix its target permissions."
    chmod go+r "$CERT_CRT" || die "Cannot make the public TLS certificate readable at $CERT_CRT."
  fi
}

cmd_gen_cert() {
  command -v openssl &>/dev/null || die "openssl not found — needed to generate the TLS certificate."
  [[ ! -L "$CERT_CRT" ]] || die "Refusing to generate a certificate through symlink $CERT_CRT."
  [[ ! -L "$CERT_KEY" ]] || die "Refusing to generate a private key through symlink $CERT_KEY."
  mkdir -p "$CERTS_DIR"
  local fqdn ip san public_host
  fqdn="$(get_fqdn)"
  ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  # The browser-facing name is KEYCLOAK_PUBLIC_URL's host (default localhost); the
  # certificate covers it together with the host FQDN so a fresh install passes the
  # authentication preflight without a second gen-cert.
  public_host="$(public_url_host)"
  san="$(san_entry "$fqdn")"
  [[ -z "$public_host" || "$public_host" == "${fqdn,,}" ]] || san="${san},$(san_entry "$public_host")"
  [[ "${fqdn,,}" == localhost || "$public_host" == localhost ]] || san="${san},DNS:localhost"
  [[ -z "$ip" || ",${san}," == *",IP:${ip},"* ]] || san="${san},IP:${ip}"
  local san_names="${san//DNS:/}"
  info "Generating self-signed TLS certificate (CN=${fqdn}; names ${san_names//IP:/})..."
  openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
    -keyout "$CERT_KEY" -out "$CERT_CRT" \
    -subj "/CN=${fqdn}" -addext "subjectAltName=${san}" >/dev/null 2>&1 \
    || die "openssl failed to generate the certificate."
  chmod 600 "$CERT_KEY"
  ensure_public_cert_readable
  ok "Certificate written to certs/server.crt (replace with an org-CA cert anytime)"
}

# Ensure a cert exists before the proxy starts; generate one if missing.
ensure_cert() {
  if [[ -f "$CERT_CRT" && -f "$CERT_KEY" ]]; then
    ensure_public_cert_readable
    return 0
  fi
  warn "No TLS certificate found — generating a self-signed one."
  cmd_gen_cert
}

# The host of KEYCLOAK_PUBLIC_URL, as nginx's $host spells it: lower case, without
# the port, an IPv6 literal kept in brackets. Empty when the URL has no host.
public_url_host() {
  local host
  host="$(env_value KEYCLOAK_PUBLIC_URL)"; host="${host#*://}"; host="${host%%/*}"
  if [[ "$host" == \[* ]]; then host="${host%%]*}]"; else host="${host%%:*}"; fi
  printf '%s\n' "$host" | tr '[:upper:]' '[:lower:]'
}

# The Host header a browser sends for KEYCLOAK_PUBLIC_URL: the host, plus :port when
# the URL names a port other than https's default (browsers omit :443).
public_url_authority() {
  local authority port
  authority="$(env_value KEYCLOAK_PUBLIC_URL)"; authority="${authority#*://}"; authority="${authority%%/*}"
  if [[ "$authority" == \[* ]]; then port="${authority#*]}"; else port="${authority#"${authority%%:*}"}"; fi
  port="${port#:}"
  if [[ -n "$port" && "$port" != 443 ]]; then printf '%s:%s\n' "$(public_url_host)" "$port"; else public_url_host; fi
}

# The bare public origin: KEYCLOAK_PUBLIC_URL without its /identity path. The realm
# clients' redirect URIs and web origins are built from it (sso/identity.py
# public_origin/checked_origin refuse a path), while the ini's endpoints keep the
# /identity path and are rendered from the .env by identity.py itself.
public_url_origin() {
  local url scheme authority
  url="$(env_value KEYCLOAK_PUBLIC_URL)"
  scheme="${url%%://*}"
  authority="${url#*://}"; authority="${authority%%/*}"
  printf '%s://%s\n' "$scheme" "$authority"
}

# The proxy's Compose environment follows its inputs, so `up` recreates it exactly when
# one changed. KRATE_PROXY_CONF_SHA digests nginx.conf and certs/server.{crt,key}: a new
# release replaces nginx.conf (a new inode the running proxy, bound to the old one, never
# sees) and nginx reads the certificate only at start, while Compose recreates a container
# only when its configuration or image changes. KRATE_PROXY_PUBLIC_HOST is the one Host
# header value the proxy serves in Keycloak sign-in mode (runtime.yml): the authority of
# KEYCLOAK_PUBLIC_URL (host, plus :port unless 443), the only one Keycloak accepts redirects
# for. Empty in local.yml mode: every name is served.
# $1: the authentication mode to plan for (empty: KAFKA_UI_AUTH_CONFIG in .env).
sync_proxy_env() {
  local mode="${1:-}" sha host=""
  [[ -n "$mode" ]] || mode="$(env_value KAFKA_UI_AUTH_CONFIG)"
  sha="$(python3 -c '
import hashlib, sys
digest = hashlib.sha256()
for name in sys.argv[1:]:
    data = open(name, "rb").read()
    digest.update(b"%d\n" % len(data) + data)
print(digest.hexdigest()[:32])' "$SCRIPT_DIR/nginx.conf" "$CERT_CRT" "$CERT_KEY")" \
    || die "Cannot read nginx.conf, certs/server.crt and certs/server.key for the proxy digest"
  [[ "$mode" != runtime.yml ]] || host="$(public_url_authority)"
  [[ "$(env_value KRATE_PROXY_CONF_SHA)" == "$sha" ]] || set_env_file_value "$ENV_FILE" KRATE_PROXY_CONF_SHA "$sha"
  [[ "$(env_value KRATE_PROXY_PUBLIC_HOST)" == "$host" ]] || set_env_file_value "$ENV_FILE" KRATE_PROXY_PUBLIC_HOST "$host"
}

# Returns 0 if a TCP listener already holds the given port on this host.
port_in_use() {
  local port="$1"
  if command -v ss &>/dev/null; then
    ss -Hltn 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -qx "$port"
  else
    # No ss (macOS, minimal hosts): a listener accepts a local connection.
    ( exec 3<>"/dev/tcp/127.0.0.1/${port}" ) 2>/dev/null
  fi
}

# ─── install ──────────────────────────────────────────────────────────────────
cmd_install() {
  local from=""
  if [[ "${1:-}" == --from ]]; then
    [[ -d "${2:-}" ]] || die "Usage: krate install [--from <earlier installation directory>]"
    from="$(cd "$2" && pwd)"
  fi
  step "Krate install"
  echo ""

  # 1. Preflight — fail safe with guidance instead of half-applying. The
  #    takeover source is passed so its .env and certificate are inspected.
  if [[ -z "${KRATE_DEPLOYED:-}" ]]; then
    if ! KRATE_INSTALL_FROM="$from" cmd_doctor; then
      echo ""
      die "Preflight checks failed — fix the issues above, then re-run: krate install"
    fi
    require_compose_file
    echo ""
  fi

  # 2. From an extracted package: load its images, install its release files
  #    into KRATE_HOME and continue there, where the site's state lives.
  if is_package; then
    cmd_load_images
    echo ""
    deploy_release "$from"
    echo ""
    KRATE_DEPLOYED=1 exec "$KRATE_HOME/krate" install
  fi
  # Taken here, in the installation: from a package the exec above replaces this
  # process (and its exit trap), so a lock taken earlier would stay behind.
  identity_lock_if_enabled

  # 3. Settings, passwords and certificate
  info "Preparing settings, passwords and the TLS certificate..."
  prepare
  echo ""

  # 4. Start and wait for the cluster to become healthy
  info "Starting cluster..."
  compose_cmd up -d
  echo ""
  cmd_health || true      # wait for the cluster to settle, then show final health
  echo ""

  sep
  cmd_credentials
  echo ""
  echo -e "  ${DIM}Installed in $SCRIPT_DIR; run its ./krate from now on, e.g.:"
  echo -e "  $SCRIPT_DIR/krate status     — check running services"
  echo -e "  $SCRIPT_DIR/krate logs -f    — follow all logs"
  echo -e "  $SCRIPT_DIR/krate identity logrotate --install   — rotate the identity journal with the host's logrotate${RESET}"
  echo ""
}

# ─── load-images ──────────────────────────────────────────────────────────────
cmd_load_images() {
  require_docker
  [[ -d "$IMAGES_DIR" ]] || die "images/ directory not found in $SCRIPT_DIR"

  shopt -s nullglob
  local tars=("$IMAGES_DIR"/*.tar)
  shopt -u nullglob

  [[ ${#tars[@]} -gt 0 ]] || die "No .tar files found in $IMAGES_DIR"

  info "Loading ${#tars[@]} image(s) into Docker..."
  for tar in "${tars[@]}"; do
    local name
    name="$(basename "$tar")"
    echo -n "    $name ... "
    docker load -i "$tar" 2>&1 | sed -n 's/^Loaded image: //p' || echo ""
  done
  ok "All images loaded"
}

# ─── start ────────────────────────────────────────────────────────────────────
cmd_start() {
  identity_lock_if_enabled
  prepare
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Starting $svc..."
    compose_cmd up -d "$svc"
  else
    info "Starting cluster..."
    compose_cmd up -d
    echo ""
    cmd_health || true      # wait for the cluster to settle, then show final health
  fi
}

# ─── stop ─────────────────────────────────────────────────────────────────────
cmd_stop() {
  require_compose; require_compose_file
  identity_lock_if_enabled
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    info "Stopping $svc (container paused, data preserved)..."
    compose_cmd stop "$svc"
  else
    info "Stopping cluster (containers paused, data preserved)..."
    compose_cmd stop
  fi
  ok "Stopped"
}

# ─── restart ──────────────────────────────────────────────────────────────────
cmd_restart() {
  require_compose; require_compose_file; require_env
  identity_lock_if_enabled
  ensure_cert   # proxy won't start without a TLS cert (e.g. after a cert swap)
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
