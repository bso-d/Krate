# ─── config ───────────────────────────────────────────────────────────────────
cmd_config() {
  local action="${1:-show}"
  shift || true

  case "$action" in
    show)
      local file
      for file in "$ENV_FILE" "$MONITOR_DIR/.env"; do
        [[ -f "$file" ]] || continue
        sep
        echo -e "${BOLD}  $file${RESET}"
        sep
        cat "$file"
      done
      sep
      [[ -f "$ENV_FILE" ]] || warn ".env does not exist yet; krate setup creates it."
      ;;
    set)
      local kv="${1:-}" file="$ENV_FILE" template="$ENV_TEMPLATE"
      [[ "$kv" == *=* ]] || die "Usage: krate config set KEY=VALUE"
      local key="${kv%%=*}"
      local val="${kv#*=}"
      [[ "$key" =~ ^[A-Z0-9_]+_IMAGE$ ]] && die "Image pins come from .env.template; change $key there, or export it in the shell for one run."
      # Keycloak is initialised with these; they may be set here only while
      # no identity database exists. Afterwards they change in Keycloak and
      # .env together (krate identity rotate), and an unclear state is refused.
      case "$key" in
        KEYCLOAK_DB_PASSWORD|KEYCLOAK_ADMIN_PASSWORD|KEYCLOAK_CLI_CLIENT_SECRET|KEYCLOAK_KAFBAT_CLIENT_SECRET)
          local state
          state="$(identity_state)" || exit 1
          case "$state" in
            pristine) ;;
            existing) die "The identity database already uses $key (identity state: $state). Change it on both sides with: krate identity rotate $key" ;;
            *) die "Cannot set $key while the identity state is unclear (identity state: $state)" ;;
          esac
          ;;
      esac
      # Monitoring keys live in monitoring/.env; everything else in .env.
      if ! grep -qE "^${key}=" "$ENV_TEMPLATE" && [[ -f "$MONITOR_DIR/.env.template" ]] \
          && grep -qE "^${key}=" "$MONITOR_DIR/.env.template"; then
        file="$MONITOR_DIR/.env"
        template="$MONITOR_DIR/.env.template"
      fi
      if [[ ! -f "$file" ]]; then
        cp "$template" "$file"
      fi
      chmod 600 "$file"
      set_env_file_value "$file" "$key" "$val"
      ok "Set ${key} in ${file#"$SCRIPT_DIR"/}"
      ;;
    *)
      die "Usage: krate config [show | set KEY=VALUE]"
      ;;
  esac
}

# ─── uninstall ────────────────────────────────────────────────────────────────
cmd_uninstall() {
  require_compose; require_compose_file
  identity_lock_if_enabled

  local purge=false
  [[ "${1:-}" == "--purge" ]] && purge=true

  if $purge; then
    echo ""
    warn "WARNING: --purge will delete all Kafka data (broker logs, ZK state, offsets)"
    warn "and the identity database (Keycloak users and settings, volume keycloak_db_data)."
    warn "This is irreversible. Keep a copy first: krate identity backup <file>"
    echo ""
    read -rp "Type 'yes' to confirm purge: " confirm
    [[ "$confirm" == "yes" ]] || die "Aborted."
    info "Removing containers and volumes..."
    identity_compose down -v
  else
    info "Removing containers (volumes preserved)..."
    identity_compose down
  fi
  ok "Done"
}

# ─── monitor (observability stack) ───────────────────────────────────────────
# The stack in monitoring/ is shared by every variant. Rather than hardcode a
# network name and broker list per variant, discover both from the cluster that
# is actually running: the compose project name varies with the directory a
# bundle was extracted into, so a hardcoded external network would break.
# In a bundle the stack sits beside the CLI; in the repo it lives once at the
# root and is shared by every variant.
MONITOR_DIR="$SCRIPT_DIR/monitoring"
[[ -d "$MONITOR_DIR" ]] || MONITOR_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)/monitoring"

# The monitoring/.env keys render.py reads. They, the render sources and the cluster
# certificate decide KRATE_RENDER_REVISION, so a change of any other key (a GRAFANA_*
# key, a publish address) no longer recreates Perses, Alertmanager and the gateway:
# hashing the whole .env file did exactly that, and a changed public URL or group did
# not reach the consumers at all (harness/phase4/lab6, Phase 4 defect 7).
# scripts/check-identity.py asserts this list equals the keys render.py reads.
KRATE_RENDER_ENV_KEYS=(
  ALERT_EMAIL_TO ALERTMANAGER_EMAIL_ENABLED ALERTMANAGER_SMTP_REQUIRE_TLS
  GF_SMTP_ENABLED GF_SMTP_FROM_ADDRESS GF_SMTP_FROM_NAME GF_SMTP_HOST GF_SMTP_PASSWORD
  GF_SMTP_SKIP_VERIFY GF_SMTP_USER
  KEYCLOAK_ADMIN_GROUP KEYCLOAK_PUBLIC_URL KEYCLOAK_SESSION_IDLE_MINUTES
  KEYCLOAK_SESSION_MAX_HOURS KEYCLOAK_VIEWER_GROUP
  OAUTH2_PROXY_CLIENT_SECRET OAUTH2_PROXY_COOKIE_SECRET
  PERSES_ADMIN_PASSWORD PERSES_ADMIN_USER PERSES_AUTH_MODE PERSES_ENCRYPTION_KEY
  PERSES_GROUP_PROOF_MINUTES PERSES_IDP PERSES_PORT
  PERSES_SYNC_CLIENT_SECRET
)

render_revision() {
  local env_file="$MONITOR_DIR/.env" key val
  {
    for key in "${KRATE_RENDER_ENV_KEYS[@]}"; do
      val="$(env_value_file "$env_file" "$key")"
      [[ -n "$val" ]] || val="$(env_value "$key")"
      printf '%s=%s\n' "$key" "$val"
    done
    find "$MONITOR_DIR/auth/perses" "$MONITOR_DIR/render.py" "$MONITOR_DIR/perses" \
      "$CERT_CRT" "$CERT_KEY" -type f ! -path '*/__pycache__/*' 2>/dev/null \
      | LC_ALL=C sort | xargs cat 2>/dev/null
  } | cksum | cut -d' ' -f1
}

# The monitoring/.env keys the Perses and perses-gateway outputs of render.py
# read directly. The session timings reach those outputs only through the
# derived site (realm_site: group-proof minutes, session hours), so they are
# covered by perses_site_digest below instead of as raw keys: 15->16 minutes
# leaves the derived proof at 5 and must not recreate Perses (formal 4a U23),
# while 15->18 moves it to 6 and must. The gateway also proxies the realm
# logout and Alertmanager mail settings, so it shares this revision.
KRATE_PERSES_REVISION_KEYS=(
  ALERT_EMAIL_TO ALERTMANAGER_EMAIL_ENABLED ALERTMANAGER_SMTP_REQUIRE_TLS
  GF_SMTP_ENABLED GF_SMTP_FROM_ADDRESS GF_SMTP_FROM_NAME GF_SMTP_HOST
  GF_SMTP_SKIP_VERIFY GF_SMTP_USER
  OAUTH2_PROXY_CLIENT_SECRET
  PERSES_ADMIN_PASSWORD PERSES_ADMIN_USER PERSES_AUTH_MODE PERSES_ENCRYPTION_KEY
  PERSES_IDP
)

# The environment keys realm_site derives the Perses site from.
KRATE_PERSES_SITE_KEYS=(
  KEYCLOAK_PUBLIC_URL KEYCLOAK_VIEWER_GROUP KEYCLOAK_ADMIN_GROUP
  KEYCLOAK_SESSION_IDLE_MINUTES KEYCLOAK_SESSION_MAX_HOURS
  PERSES_GROUP_PROOF_MINUTES PERSES_PORT
)

perses_site_digest() {
  # The derived Perses site as JSON: in local mode render.py uses an empty site,
  # so the digest is empty too and a realm timing change recreates nothing here.
  # Without a configured realm (realm_site requires its keys) fall back to the
  # raw key values: conservative, the same behavior as before for that shape.
  local env_file="$MONITOR_DIR/.env" key val mode
  local args=()
  for key in "${KRATE_PERSES_SITE_KEYS[@]}"; do
    val="$(env_value_file "$env_file" "$key")"
    [[ -n "$val" ]] || val="$(env_value "$key")"
    args+=("$key=$val")
  done
  mode="$(env_value_file "$env_file" PERSES_AUTH_MODE local)"
  if [[ "$mode" == local ]]; then
    printf 'local-empty-site\n'
    return 0
  fi
  if ! command -v python3 >/dev/null; then
    printf '%s\n' "${args[@]}"
    return 0
  fi
  local site
  site="$(python3 - "$MONITOR_DIR" "${args[@]}" <<'PYEOF'
import json, sys
sys.path.insert(0, sys.argv[1])
import render
env = {}
for item in sys.argv[2:]:
    key, _, value = item.partition('=')
    env[key] = value
try:
    print(json.dumps(render.realm_site(env), sort_keys=True))
except render.ConfigError:
    print('RAW-FALLBACK')
PYEOF
)"
  if [[ "$site" == RAW-FALLBACK ]]; then
    printf '%s\n' "${args[@]}"
  else
    printf '%s\n' "$site"
  fi
}

perses_revision() {
  local env_file="$MONITOR_DIR/.env" key val
  {
    for key in "${KRATE_PERSES_REVISION_KEYS[@]}"; do
      val="$(env_value_file "$env_file" "$key")"
      [[ -n "$val" ]] || val="$(env_value "$key")"
      printf '%s=%s\n' "$key" "$val"
    done
    perses_site_digest
    find "$MONITOR_DIR/auth/perses" "$MONITOR_DIR/render.py" "$MONITOR_DIR/perses" \
      "$CERT_CRT" "$CERT_KEY" -type f ! -path '*/__pycache__/*' 2>/dev/null \
      | LC_ALL=C sort | xargs cat 2>/dev/null
  } | cksum | cut -d' ' -f1
}

# Alertmanager reads only its rendered SMTP/route file. Keep its Compose revision
# independent of Perses mode, clients and gateway certificates so an SSO switch
# does not restart alert delivery or the Alertmanager data process.
alertmanager_revision() {
  local env_file="$MONITOR_DIR/.env" key val
  local keys=(
    ALERT_EMAIL_TO ALERTMANAGER_EMAIL_ENABLED ALERTMANAGER_SMTP_REQUIRE_TLS
    GF_SMTP_ENABLED GF_SMTP_FROM_ADDRESS GF_SMTP_FROM_NAME GF_SMTP_HOST
    GF_SMTP_PASSWORD GF_SMTP_SKIP_VERIFY GF_SMTP_USER
  )
  {
    for key in "${keys[@]}"; do
      val="$(env_value_file "$env_file" "$key")"
      [[ -n "$val" ]] || val="$(env_value "$key")"
      printf '%s=%s\n' "$key" "$val"
    done
    cat "$MONITOR_DIR/render.py"
  } | cksum | cut -d' ' -f1
}

# The docker network the brokers are attached to, read from the running
# broker container (container_name is fixed per edition). Only a broker is
# asked: the proxy and Kafbat also sit on the identity network, which sorts
# first in a container's network list and must not be handed to the exporter.
monitor_network() {
  local state
  state="$(docker inspect -f '{{.State.Status}}' "$BROKER_CONTAINER" 2>/dev/null)" || return 1
  [[ "$state" == running ]] || return 1
  docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$BROKER_CONTAINER" 2>/dev/null \
    | tr ' ' '\n' | grep -v '^$' | head -1
}

# One --kafka.server= flag per broker, taken from the internal bootstrap list so
# the exporter uses the same listener the brokers use for each other.
monitor_targets() {
  local out=""
  local IFS=','
  for hp in $BOOTSTRAP; do
    out+="--kafka.server=$hp "
  done
  echo "${out% }"
}

# Count configured broker services independently of their runtime state.
monitor_broker_count() {
  local services
  services="$(compose_cmd config --services)" || return 1
  printf '%s\n' "$services" | awk '/^kafka-[0-9]+$/ { count++ } END { if (count < 1) exit 1; print count }'
}

monitor_compose() {
  [[ -d "$MONITOR_DIR" ]] || die "monitoring/ not found in $SCRIPT_DIR
This bundle was built without the observability stack."
  local net
  net="$(monitor_network)" || net=""
  if [[ "$1" == "up" && -z "$net" ]]; then
    die "The cluster is not running — start it first: krate start"
  fi
  local expected
  expected="$(monitor_broker_count)" || expected=""
  if [[ "$1" == "up" && -z "$expected" ]]; then
    die "Cannot determine the configured broker count from cluster Compose services."
  fi
  # down/ps/logs must still work after the broker containers are removed.
  net="${net:-krate-unused-network}"

  local env_file="$MONITOR_DIR/.env"
  if [[ ! -f "$env_file" ]]; then
    cp "$MONITOR_DIR/.env.template" "$env_file"
    chmod 600 "$env_file"
  fi
  sync_image_pins "$env_file" "$MONITOR_DIR/.env.template"

  # SSO-only services run in native/gateway mode; down/ps/logs always include
  # them so switching back to local mode still stops and shows them.
  local profiles=""
  case "$(env_value_file "$env_file" PERSES_AUTH_MODE local)" in
    native|gateway) profiles="perses-sso" ;;
  esac
  [[ "$1" == "up" ]] || profiles="perses-sso"

  # Recreate the rendered-config consumers whenever their inputs change, including a
  # renewed gateway certificate — but only for the inputs they actually read.
  local revision alert_revision perses_rev
  revision="$(render_revision)"
  alert_revision="$(alertmanager_revision)"
  perses_rev="$(perses_revision)"

  # Which monitoring UIs sign people in through the Krate realm: Grafana with
  # GRAFANA_AUTH_CONFIG=realm.ini, Perses with PERSES_IDP=krate.
  local grafana_realm=false perses_realm=false
  [[ "$(env_value_file "$env_file" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]] && grafana_realm=true
  [[ "$(env_value_file "$env_file" PERSES_IDP)" == krate ]] && perses_realm=true

  # In realm mode the containers resolve the realm's public host to the Docker host,
  # whose published 443 is the cluster proxy; idp-wait holds them until the realm
  # answers; and Grafana's own port, which has no login left, moves to the loopback
  # interface. With no UI on the realm the discovery URL is empty and idp-wait
  # exits at once.
  local idp_host="" idp_url="" public grafana_bind="" grafana_sha=""
  # The IdP host mapping is always exported, even with no UI on the realm: it
  # only adds a hosts entry, and gating it on the realm flags recreated Perses
  # (extra_hosts is part of its Compose config) on a Grafana-only auth switch
  # (formal 4a U22). The discovery URL stays gated so idp-wait still exits at
  # once with nothing on the realm.
  public="$(env_value KEYCLOAK_PUBLIC_URL)"; public="${public%/}"
  idp_host="$(public_url_host)"
  if $grafana_realm || $perses_realm; then
    idp_url="$public/realms/$IDENTITY_REALM/.well-known/openid-configuration"
  fi
  if $grafana_realm; then
    grafana_bind=127.0.0.1
    # Grafana reads realm.ini, the cluster CA and the rendered client secret at start
    # only, so a change of any of them must recreate it; Compose compares environments.
    grafana_sha="$( { cat "$MONITOR_DIR/auth/realm.ini" "$CERT_CRT" 2>/dev/null
                      env_value_file "$env_file" GRAFANA_OAUTH_CLIENT_SECRET; } | cksum | cut -d' ' -f1)"
  fi

  KRATE_RENDER_REVISION="$revision" \
  KRATE_ALERTMANAGER_REVISION="$alert_revision" \
  KRATE_PERSES_REVISION="$perses_rev" \
  COMPOSE_PROFILES="$profiles" \
  PERSES_CERTS_DIR="$CERTS_DIR" \
  KAFKA_EXPECTED_BROKERS="${expected:-1}" \
  KAFKA_NETWORK="$net" \
  KAFKA_EXPORTER_TARGETS="$(monitor_targets)" \
  CLUSTER_LABEL="$KRATE_VARIANT" \
  GRAFANA_BIND="$grafana_bind" \
  KRATE_IDP_HOST="$idp_host" \
  IDP_DISCOVERY_URL="$idp_url" \
  KRATE_GRAFANA_AUTH_SHA="$grafana_sha" \
  KEYCLOAK_PUBLIC_URL="$(env_value KEYCLOAK_PUBLIC_URL)" \
  KEYCLOAK_VIEWER_GROUP="$(env_value KEYCLOAK_VIEWER_GROUP)" \
  KEYCLOAK_ADMIN_GROUP="$(env_value KEYCLOAK_ADMIN_GROUP)" \
  KEYCLOAK_SESSION_IDLE_MINUTES="$(env_value KEYCLOAK_SESSION_IDLE_MINUTES)" \
  KEYCLOAK_SESSION_MAX_HOURS="$(env_value KEYCLOAK_SESSION_MAX_HOURS)" \
  PERSES_IDP="$(env_value_file "$env_file" PERSES_IDP)" \
  PERSES_GROUP_PROOF_MINUTES="$(env_value_file "$env_file" PERSES_GROUP_PROOF_MINUTES)" \
  MONITOR_PROJECT="krate-${KRATE_VARIANT}-monitoring" \
  "${COMPOSE_BIN[@]}" -p "krate-${KRATE_VARIANT}-monitoring" --env-file "$env_file" -f "$MONITOR_DIR/docker-compose.yml" "$@"
}

# Monitoring host ports that something other than the monitoring stack holds.
monitor_port_conflicts() {
  local own entry key port seen=""
  own="$(docker ps --filter "label=com.docker.compose.project=krate-${KRATE_VARIANT}-monitoring" --format '{{.Ports}}')"
  for entry in GRAFANA_PORT:3000 PROM_PORT:9090 LOKI_PORT:3100 PERSES_PORT:3443; do
    key="${entry%%:*}"
    port="$(env_value_file "$MONITOR_DIR/.env" "$key" "${entry#*:}")"
    # Two monitoring services on one host port fail only after Compose has
    # started part of the stack; report the duplicate before anything starts.
    if [[ " $seen " == *" $port "* ]]; then
      echo "$key=$port(duplicate)"
      continue
    fi
    seen+=" $port"
    [[ "$own" == *":${port}->"* ]] && continue
    if port_in_use "$port"; then
      echo "$key=$port"
    fi
  done
}

# ─── Grafana on the Krate realm ──────────────────────────────────────────────
# A monitoring UI on the realm needs a public name: inside a container
# "localhost" is the container itself, so the token and userinfo calls it makes
# to KEYCLOAK_PUBLIC_URL would never reach Keycloak (harness/phase4/lab3 L-2).
refuse_loopback_public_url() {
  local host
  host="$(public_url_host)"
  # One rule with sso/identity.py's refuse_loopback_public_url: any 127.0.0.0/8 address in
  # dotted or inet_aton shorthand, the two unspecified addresses, and localhost by name. A
  # hostname is never refused, so 127.example.com stays legal. The old exact-name list let
  # 127.0.0.2 through here while the Python rule refused it (PR #42 review).
  if [[ "$host" == localhost || "$host" == 0.0.0.0 || "$host" == :: || "$host" == '[::]' ||
        "$host" == ::1 || "$host" == '[::1]' || "$host" == '::ffff:127.'* ||
        "$host" =~ ^127(\.[0-9]{1,3}){0,3}$ || "$host" =~ ^[0-9]+$ ]]; then
    die "KEYCLOAK_PUBLIC_URL names the loopback or unspecified host '$host', which a monitoring UI on the realm cannot use: inside a container, localhost is the container itself. Set the public name first:
  krate config set KEYCLOAK_PUBLIC_URL=https://<fqdn>/identity
  krate gen-cert && krate auth apply"
  fi
}

# Grafana's admin API from the host, with the local-mode Basic credentials in the
# environment of the call: no password or token ever reaches a command line (the
# gate samples ps to prove it, rows Z4a/Z4b).
grafana_admin() {
  local env_file="$MONITOR_DIR/.env"
  GRAFANA_URL="http://127.0.0.1:$(env_value_file "$env_file" GRAFANA_PORT 3000)" \
  GRAFANA_ADMIN_USER="$(env_value_file "$env_file" GRAFANA_USER admin)" \
  GRAFANA_ADMIN_PASSWORD="$(env_value_file "$env_file" GRAFANA_PASSWORD)" \
    python3 "$MONITOR_DIR/grafana-admin.py" "$@"
}

# The realm's krate-grafana client: created when absent, converged when it differs.
# The secret reaches Keycloak through identity.py's environment and kcadm's standard
# input, never as an argument. Scopes are compared and reported, not converged: a
# PUT of the representation never changes a client's scopes.
identity_keycloak_running() {
  local cid
  cid="$(identity_container keycloak)" || return 1
  [[ -n "$cid" && "$(container_status "$cid")" == running ]]
}

identity_reconcile_grafana_client() {
  local origin="$1" optional="${2:-}" sso id verdict
  sso="$(sso_dir)"
  if [[ "$optional" == optional ]]; then
    # Called from `monitor up`, which must reach Compose even during a Keycloak outage:
    # idp-wait is what names that failure (row U13), not this login. kcadm_login itself
    # dies when the container is stopped, so reachability is checked first and a refused
    # login is a warning; the next `monitor up` reconciles the client.
    if ! identity_keycloak_running; then
      warn "Keycloak is not running: the krate-grafana client is not reconciled now (a later krate monitor up does it)"
      return 0
    fi
    kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
      || { warn "Keycloak did not accept the master admin login: the krate-grafana client is not reconciled now (a later krate monitor up does it)"; return 0; }
  else
    kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
      || die "Keycloak refused the master admin login. Check: krate identity status"
  fi
  id="$(kcadm_client_id "$IDENTITY_REALM" krate-grafana)" || die "Keycloak query failed"
  local err
  if [[ -z "$id" ]]; then
    # kcadm announces a creation on stderr; only a real failure reaches the operator.
    err="$(mktemp)" || die "Cannot create a temporary file"
    GRAFANA_OAUTH_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_OAUTH_CLIENT_SECRET)" \
      python3 "$sso/identity.py" grafana-client --origin "$origin" --with-secret \
      | KCADM_STDIN=1 kcadm -- create clients -r "$IDENTITY_REALM" -f - >/dev/null 2>"$err" \
      || { sed 's/^/  /' "$err" >&2; rm -f "$err"
           die "Cannot create the krate-grafana client: either its representation did not render or Keycloak refused it"; }
    rm -f "$err"
    identity_journal "monitor realm" created "krate-grafana client"
    ok "Created the krate-grafana client in realm $IDENTITY_REALM"
    kcadm_logout
    return 0
  fi
  # With the secret, so a rotated GRAFANA_OAUTH_CLIENT_SECRET is detected and converged
  # instead of leaving Keycloak on the old value while Grafana reads the new one.
  verdict="$(kcadm -- get "clients/$id" -r "$IDENTITY_REALM" \
    | GRAFANA_OAUTH_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_OAUTH_CLIENT_SECRET)" \
      python3 "$sso/identity.py" grafana-client --origin "$origin" --with-secret client-differs)" \
    || die "Cannot compare the krate-grafana client with the plan"
  case "$verdict" in
    *scopes-differ*) warn "krate-grafana: its scopes differ from the plan, and a client update never changes scopes — set them in Keycloak" ;;
  esac
  case "$verdict" in
    same*) ok "krate-grafana client unchanged" ;;
    differs*)
      err="$(mktemp)" || die "Cannot create a temporary file"
      GRAFANA_OAUTH_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_OAUTH_CLIENT_SECRET)" \
        python3 "$sso/identity.py" grafana-client --origin "$origin" --with-secret \
        | KCADM_STDIN=1 kcadm -- update "clients/$id" -r "$IDENTITY_REALM" -f - -m >/dev/null 2>"$err" \
        || { sed 's/^/  /' "$err" >&2; rm -f "$err"
             die "Cannot update the krate-grafana client: either its representation did not render or Keycloak refused it"; }
      rm -f "$err"
      identity_journal "monitor realm" reconciled "krate-grafana client"
      ok "krate-grafana client updated from the plan" ;;
    *) die "Unexpected comparison result for the krate-grafana client: $verdict" ;;
  esac
  kcadm_logout
}

identity_reconcile_perses_clients() {
  local optional="${1:-}" sso
  sso="$(sso_dir)"
  if [[ "$optional" == optional ]]; then
    if ! identity_keycloak_running; then
      warn "Keycloak is not running: the Perses clients are not reconciled now (a later krate monitor up does it)"
      return 0
    fi
    kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
      || { warn "Keycloak did not accept the master admin login: the Perses clients are not reconciled now (a later krate monitor up does it)"; return 0; }
  else
    kcadm_login master user "$(env_value KEYCLOAK_ADMIN_USER)" "$(env_value KEYCLOAK_ADMIN_PASSWORD)" \
      || die "Keycloak refused the master admin login. Check: krate identity status"
  fi
  local client_name id verdict err
  for client_name in krate-perses krate-perses-sync; do
    id="$(kcadm_client_id "$IDENTITY_REALM" "$client_name")" || die "Keycloak query failed"
    if [[ -z "$id" ]]; then
      err="$(mktemp)" || die "Cannot create a temporary file"
      OAUTH2_PROXY_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" OAUTH2_PROXY_CLIENT_SECRET)" \
      PERSES_SYNC_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" PERSES_SYNC_CLIENT_SECRET)" \
        python3 "$sso/identity.py" perses-clients --env-file "$ENV_FILE" --monitor-env-file "$MONITOR_DIR/.env" --client "$client_name" --with-secret \
        | KCADM_STDIN=1 kcadm -- create clients -r "$IDENTITY_REALM" -f - >/dev/null 2>"$err" \
        || { sed 's/^/  /' "$err" >&2; rm -f "$err"
             die "Cannot create the $client_name client: either its representation did not render or Keycloak refused it"; }
      rm -f "$err"
      identity_journal "monitor reconciled" created "$client_name client"
      ok "Created the $client_name client in realm $IDENTITY_REALM"
      continue
    fi
    verdict="$(kcadm -- get "clients/$id" -r "$IDENTITY_REALM" \
      | OAUTH2_PROXY_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" OAUTH2_PROXY_CLIENT_SECRET)" \
        PERSES_SYNC_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" PERSES_SYNC_CLIENT_SECRET)" \
        python3 "$sso/identity.py" perses-clients --env-file "$ENV_FILE" --monitor-env-file "$MONITOR_DIR/.env" client-differs "$client_name" --with-secret)" \
      || die "Cannot compare the $client_name client with the plan"
    case "$verdict" in
      *scopes-differ*) warn "$client_name: its scopes differ from the plan, and a client update never changes scopes — set them in Keycloak" ;;
    esac
    case "$verdict" in
      same*) ok "$client_name client unchanged" ;;
      differs*)
        err="$(mktemp)" || die "Cannot create a temporary file"
        OAUTH2_PROXY_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" OAUTH2_PROXY_CLIENT_SECRET)" \
        PERSES_SYNC_CLIENT_SECRET="$(env_value_file "$MONITOR_DIR/.env" PERSES_SYNC_CLIENT_SECRET)" \
          python3 "$sso/identity.py" perses-clients --env-file "$ENV_FILE" --monitor-env-file "$MONITOR_DIR/.env" --client "$client_name" --with-secret \
          | KCADM_STDIN=1 kcadm -- update "clients/$id" -r "$IDENTITY_REALM" -f - -m >/dev/null 2>"$err" \
          || { sed 's/^/  /' "$err" >&2; rm -f "$err"
               die "Cannot update the $client_name client: either its representation did not render or Keycloak refused it"; }
        rm -f "$err"
        identity_journal "monitor reconciled" reconciled "$client_name client"
        ok "$client_name client updated from the plan" ;;
      *) die "Unexpected comparison result for the $client_name client: $verdict" ;;
    esac
  done
  kcadm_logout
}

# The alert-seeding service account and its token. Grafana's own API creates both;
# the token stays on the host (seed-alerting.py runs there) in a 0600 file under
# monitoring/auth/secrets/, which import_site_files carries across an upgrade and
# no release file contains. Only the token's name is printed: the value goes from
# the helper's standard output straight into the file, and its id and expiry into
# the meta file beside it.
# Writes the helper's token document into the 0600 token and meta files and prints
# only the token's name: the value goes from standard input straight into the file,
# never into a shell variable, a log line or an argument.
monitor_write_seed_token() {
  python3 -c '
import json, os, sys
data = json.load(sys.stdin)
token_path, meta_path = sys.argv[1], sys.argv[2]
with open(token_path, "w", encoding="utf-8") as handle:
    handle.write(data["key"] + "\n")
os.chmod(token_path, 0o600)
with open(meta_path, "w", encoding="utf-8") as handle:
    handle.write("id=%d\nexpires=%d\n" % (data["id"], data["expires"]))
os.chmod(meta_path, 0o600)
print(data["name"])' "$MONITOR_DIR/auth/secrets/grafana-seed.token" "$MONITOR_DIR/auth/secrets/grafana-seed.meta"
}

# The alert-seeding service account and its 90-day token. Grafana's own API creates
# both; the token stays on the host (seed-alerting.py runs there) in a 0600 file
# under monitoring/auth/secrets/, which import_site_files carries across an upgrade
# and no release file contains.
monitor_grafana_seed_token() {
  local days="${1:-90}" dir="$MONITOR_DIR/auth/secrets" meta="$MONITOR_DIR/auth/secrets/grafana-seed.meta"
  local account name expires now
  install -d -m 700 "$dir" || die "Cannot create $dir"
  # Re-running the switch must not pile up tokens: one with more than 30 days left stays
  # in use (the same threshold monitor_grafana_seed_renew uses).
  if [[ -f "$meta" ]]; then
    expires="$(sed -n 's/^expires=//p' "$meta")"
    now="$(date -u +%s)"
    if [[ "$expires" =~ ^[0-9]+$ && $((expires - now)) -ge 2592000 ]]; then
      set_env_file_value "$MONITOR_DIR/.env" GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE auth/secrets/grafana-seed.token
      ok "Grafana seed token still valid for $(( (expires - now) / 86400 )) days; not creating another"
      return 0
    fi
  fi
  account="$(grafana_admin service-account --name krate-seed --role Admin \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["id"])')" \
    || die "Grafana refused the krate-seed service account — is it running? (krate monitor status)"
  name="$(grafana_admin token-create --account-id "$account" --days "$days" | monitor_write_seed_token)" \
    || die "Grafana refused the seed token"
  set_env_file_value "$MONITOR_DIR/.env" GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE auth/secrets/grafana-seed.token
  ok "Grafana seed token $name created (id and expiry in monitoring/auth/secrets/grafana-seed.meta)"
}

# The same helper with the seed token instead of the Basic admin, which realm mode
# turned off: a service account may manage the tokens of its own account.
grafana_admin_token() {
  local env_file="$MONITOR_DIR/.env" token_file
  token_file="$MONITOR_DIR/$(env_value_file "$env_file" GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE)"
  [[ -f "$token_file" ]] || die "No Grafana seed token at $token_file — run: krate monitor realm"
  GRAFANA_URL="http://127.0.0.1:$(env_value_file "$env_file" GRAFANA_PORT 3000)" \
  GRAFANA_SERVICE_ACCOUNT_TOKEN="$(cat "$token_file")" \
    python3 "$MONITOR_DIR/grafana-admin.py" "$@"
}

# The seed token lives 90 days. Renew it while it is still valid, so alert seeding
# never stops: the successor is written first and only then is the old id deleted
# (Grafana keeps expired tokens listed, so the deletion is by id). 30 days of room
# means a renewal happens at the latest 60 days into a token's life.
monitor_grafana_seed_renew() {
  local meta="$MONITOR_DIR/auth/secrets/grafana-seed.meta" expires now old_id account name
  # Without the record, or with an unreadable one, grafana_admin_token has nothing to
  # authenticate with: every admin call then fails with an error that does not name the
  # cause. Say what recreates it instead of returning silently (PR #42 review).
  if [[ ! -f "$meta" ]]; then
    warn "No Grafana seed-token record ($meta is missing), so the Grafana admin calls that need it will fail. Recreate it: krate monitor realm"
    return 0
  fi
  expires="$(sed -n 's/^expires=//p' "$meta")"
  old_id="$(sed -n 's/^id=//p' "$meta")"
  now="$(date -u +%s)"
  if [[ ! "$expires" =~ ^[0-9]+$ || ! "$old_id" =~ ^[0-9]+$ ]]; then
    warn "The Grafana seed-token record is unreadable, so it cannot be renewed and the admin calls that need it will fail. Recreate it: krate monitor realm"
    return 0
  fi
  [[ $((expires - now)) -lt 2592000 ]] || return 0
  info "Renewing the Grafana seed token (it expires in $(( (expires - now) / 86400 )) days)"
  # Grafana may be created but not started (idp-wait holds it during an outage), so a
  # renewal that cannot run is a warning: the current token still has up to 30 days. An
  # expired or deleted token fails here too, and that case has a different remedy, so the
  # warning names both causes rather than asserting an outage.
  if ! account="$(grafana_admin_token service-account --name krate-seed --role Admin \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["id"])')"; then
    warn "Cannot renew the Grafana seed token: Grafana did not answer, or the token it was given has expired or been deleted. The token has $(( (expires - now) / 86400 )) days left. If Grafana is running, recreate the token: krate monitor realm; otherwise a later krate monitor up renews it"
    return 0
  fi
  name="$(grafana_admin_token token-create --account-id "$account" --days 90 | monitor_write_seed_token)" \
    || die "Grafana refused the successor seed token; the previous one is still in place"
  # The success line follows the deletion's own result: printing "is deleted" after a failed
  # delete contradicted the warning above it and left an untracked live credential (PR #42).
  if grafana_admin_token token-delete --account-id "$account" --token-id "$old_id" >/dev/null; then
    ok "Grafana seed token $name created; the previous one (id $old_id) is deleted"
  else
    warn "The previous Grafana seed token (id $old_id) could not be deleted; delete it in Grafana"
    ok "Grafana seed token $name created; the previous one (id $old_id) is STILL VALID until it is deleted or expires"
  fi
}

# What every `krate monitor up` re-checks while Grafana is on the realm, before
# Compose decides what to recreate: realm.ini is regenerated (written only when it
# changed, so an unchanged file does not recreate Grafana), the client is converged,
# and the seed token is renewed while it is still valid.
monitor_realm_refresh() {
  local ini="$MONITOR_DIR/auth/realm.ini" origin
  origin="$(public_url_origin)"
  python3 "$(sso_dir)/identity.py" grafana-ini --env-file "$ENV_FILE" --output "$ini.new" >/dev/null \
    || die "Cannot render monitoring/auth/realm.ini"
  if [[ -f "$ini" ]] && cmp -s "$ini" "$ini.new"; then
    rm -f "$ini.new"
  else
    mv "$ini.new" "$ini"
    chmod 644 "$ini"
    ok "Updated monitoring/auth/realm.ini"
  fi
  identity_reconcile_grafana_client "$origin" optional
  monitor_grafana_seed_renew
}

# ─── Grafana sessions across a sign-in switch ────────────────────────────────
# Grafana keeps its sessions in its own database, which survives the recreate that applies
# another GRAFANA_AUTH_CONFIG, and the browser's session cookie names no port: a session made
# with Grafana's own login kept working at the Krate sign-in address after the switch to
# realm.ini (seen live, 2026-10-17: the local admin's session, created before the switch, was
# still active after it). Krate sign-in means Krate sign-in only, so `monitor up` ends the
# sessions the new sign-in does not allow:
#   to realm.ini    every user's sessions, BEFORE the recreate: only the local admin's Basic
#                   login can end them, and realm mode turns it off;
#   from realm.ini  external-login users' sessions, right AFTER the recreate, with the same
#                   Basic login.
# Both go through Grafana's admin API (monitoring/grafana-admin.py end-sessions). A sign-in is
# "realm" for realm.ini and "local" for any other file (Grafana's own login, whatever site file
# carries it). The sign-ins whose sessions the database may hold are kept in GRAFANA_AUTH_APPLIED
# ("local", "realm" or "local,realm"), widened by the one the container runs: a run that is
# refused or stops half-way leaves the sign-in it still owes in that record, so the next run
# repeats the step instead of finding nothing to do.

# The sign-in file Grafana's container was created with, read from its own GF_PATHS_CONFIG
# through a template that prints that one variable: the admin password sits in the same
# environment and never leaves docker. Empty when there is no such container.
monitor_grafana_auth_running() {
  local name="krate-${KRATE_VARIANT}-monitoring-grafana" inventory line id="" selected state config value
  # The name filter is a substring filter: select the exact name below. A failed list
  # is UNKNOWN, never the successful absence of a container. Include stopped containers.
  inventory="$(docker container ls --all --no-trunc --filter "name=$name" \
    --format '{{.ID}} {{.Names}}' 2>/dev/null)" || return 1
  if [[ -n "$inventory" ]]; then
    while IFS= read -r line; do
      [[ "$line" =~ ^([0-9a-f]{64})\ ([A-Za-z0-9][A-Za-z0-9_.-]*)$ ]] || return 1
      if [[ "${BASH_REMATCH[2]}" == "$name" ]]; then
        [[ -z "$id" ]] || return 1
        id="${BASH_REMATCH[1]}"
      fi
    done <<< "$inventory"
  fi
  [[ -n "$id" ]] || return 0
  # Inspect the validated ID, not the name again; disappearance is UNKNOWN. Emit only
  # state and the selected key, never the environment containing the admin password.
  selected="$(docker container inspect -f '{{.State.Status}}
{{range .Config.Env}}{{with split . "="}}{{if eq (index . 0) "GF_PATHS_CONFIG"}}{{if eq (len .) 2}}{{index . 0}}={{index . 1}}{{println}}{{else}}INVALID_SELECTED_ENV_SHAPE{{println}}{{end}}{{end}}{{end}}{{end}}' "$id" 2>/dev/null)" || return 1
  [[ "$selected" == *$'\n'* ]] || return 1
  state="${selected%%$'\n'*}"
  config="${selected#*$'\n'}"
  case "$state" in
    created|running|paused|restarting|removing|exited|dead) ;;
    *) return 1 ;;
  esac
  [[ "$config" =~ ^GF_PATHS_CONFIG=/etc/krate/auth/([A-Za-z0-9_.-]+)$ ]] || return 1
  value="${BASH_REMATCH[1]}"
  [[ "$value" != . && "$value" != .. ]] || return 1
  printf '%s\n' "$value"
  return 0
}

# The sign-in of a Grafana config file: "realm" for realm.ini, "local" for any other file, and
# nothing for no file.
monitor_grafana_class() {
  case "${1:-}" in
    "") ;;
    realm.ini) echo realm ;;
    *) echo local ;;
  esac
}

# The sign-ins whose sessions Grafana's database may hold ("local", "realm" or "local,realm"):
# supplied record, known running class and optional target. Empty for a Grafana
# that never ran: successful absent discovery and no applied record.
monitor_grafana_holders() {
  # Pure merge of the staged record ($1), known running class ($2), and optional
  # target ($3). No Docker call can replace the caller's single discovery snapshot.
  local joined=",${1:-},${2:-},${3:-}," held=""
  [[ "$joined" != *,local,* ]] || held="local"
  [[ "$joined" != *,realm,* ]] || held="${held:+$held,}realm"
  printf '%s\n' "$held"
  return 0
}

# What `monitor up` owes Grafana's sessions around its Compose run: "all" (end every user's
# before the recreate, going to realm.ini), "external" (end external-login users' after it, going to
# a local sign-in) or nothing.
monitor_grafana_session_plan() {
  local target="$1" held=",$2,"
  if [[ "$target" == realm && "$held" == *,local,* ]]; then
    echo all
  elif [[ "$target" == local && "$held" == *,realm,* ]]; then
    echo external
  fi
  return 0
}

# Record the sign-ins whose sessions Grafana's database may hold ($1).
monitor_grafana_record_holders() {
  local recorded
  [[ -f "$MONITOR_DIR/.env" ]] || return 0
  recorded="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_APPLIED)" || return 1
  if [[ "$recorded" != "$1" ]]; then
    set_env_file_value "$MONITOR_DIR/.env" GRAFANA_AUTH_APPLIED "$1" || return 1
  fi
  return 0
}

# End the sessions of one scope (all | external) with the local admin's Basic login and say
# how many. A failure is fatal: the switch promises that no session of the old sign-in
# survives it, so a run that cannot keep the promise does not finish the switch ($2: seconds
# to wait for a Grafana that is starting or was just recreated).
monitor_grafana_end_sessions() {
  local scope="$1" wait_seconds="${2:-0}" result counts
  if ! result="$(grafana_admin end-sessions --scope "$scope" --wait-seconds "$wait_seconds")"; then
    if [[ "$scope" == all ]]; then
      die "The Grafana sessions made with Grafana's own login could not be ended, so Grafana was not recreated and Krate sign-in is not applied: those sessions would stay valid at the Krate sign-in address. Grafana has to be running with its own login, and GRAFANA_PASSWORD has to be the password Grafana's volume holds (krate monitor status; to set one: docker exec <grafana container> grafana cli admin reset-admin-password <new>, then krate config set GRAFANA_PASSWORD=<new>). Each attempt is a login that Grafana counts, and it locks a login out after repeated failures: correct the password before you run krate monitor up again. If Grafana is stopped, or already runs with Krate sign-in, start it with its own login first, then switch again:
  krate config set GRAFANA_AUTH_CONFIG=local.ini && krate monitor up
  krate config set GRAFANA_AUTH_CONFIG=realm.ini && krate monitor up"
    fi
    die "Grafana is up with its own login, but external-login users' sessions could not be ended: they would stay valid on Grafana's own address. Correct GRAFANA_PASSWORD if it is wrong (Grafana locks a login out after repeated failures), then run krate monitor up again: it repeats this until it succeeds (krate monitor status)."
  fi
  counts="$(printf '%s' "$result" | python3 -c 'import json, sys
data = json.load(sys.stdin)
print(data["sessions_ended"], data["users_ended"])')" \
    || die "grafana-admin.py end-sessions returned no count, so the ended sessions cannot be confirmed"
  if [[ "$scope" == all ]]; then
    ok "Ended ${counts%% *} Grafana session(s) of ${counts##* } user(s): sessions made with Grafana's own login do not carry over into Krate sign-in"
  else
    ok "Ended ${counts%% *} Grafana session(s) of ${counts##* } user(s): external-login users' sessions do not carry over into Grafana's own login"
  fi
}

# Local Grafana users whose e-mail a realm user also has: after the switch Grafana
# refuses that sign-in ("User sync failed"), and taking the local user over is not
# an option (harness/phase4/lab4 Q1: e-mail linking handed the local account the
# server admin role). Every match remains visible; only corroborated local accounts
# receive the explicit retirement command. External linkage ownership stays unknown.
grafana_list_collisions() {
  local users emails page parsed rows offset matches login email state auth_class
  users="$(grafana_admin local-users)" || die "Grafana refused its user list"
  kcadm_login "$IDENTITY_REALM" client krate-cli "$(env_value KEYCLOAK_CLI_CLIENT_SECRET)" \
    || die "Keycloak refused the krate-cli client login. Check: krate identity status"
  # Page through the realm instead of asking for one 1000-row page: past that limit the
  # check silently compared against a partial realm. And a failed page is fatal rather than
  # an empty list, because reporting "no collisions" for a realm that was never read is worse
  # than stopping (PR #42 review).
  emails=""
  offset=0
  while :; do
    page="$(kcadm -- get users -r "$IDENTITY_REALM" --offset "$offset" --limit 100 \
      --fields email)" \
      || { kcadm_logout; die "Keycloak refused its user list, so the collision check cannot say whether a local Grafana user holds a realm e-mail. Check: krate identity status"; }
    parsed="$(printf '%s' "$page" | python3 -c '
import json, sys
try:
    users = json.load(sys.stdin)
    if not isinstance(users, list):
        raise ValueError()
    emails = []
    for user in users:
        if not isinstance(user, dict):
            raise ValueError()
        email = user.get("email")
        if email is not None and (not isinstance(email, str)
                or any(char in email for char in "\x00\t\r\n")):
            raise ValueError()
        if email and email.strip():
            emails.append(email.strip().lower())
except (ValueError, TypeError):
    sys.exit("Keycloak user page has an invalid JSON shape")
print(len(users))
print("\n".join(emails))
')" || { kcadm_logout; die "Keycloak returned an invalid user page, so the collision check cannot say whether a local Grafana user holds a realm e-mail. Check: krate identity status"; }
    rows="${parsed%%$'\n'*}"
    [[ "$rows" -eq 0 ]] && break
    if [[ "$parsed" == *$'\n'* ]]; then
      emails+="${parsed#*$'\n'}"
      emails+=$'\n'
    fi
    [[ "$rows" -lt 100 ]] && break
    offset=$((offset + 100))
  done
  kcadm_logout
  # Preserve every human match. Only corroborated local accounts get retirement advice.
  matches="$(printf '%s' "$users" | KRATE_REALM_EMAILS="$emails" python3 -c '
import json, os, sys
try:
    users = json.load(sys.stdin)
    if not isinstance(users, list):
        raise ValueError()
    realm = {line.strip() for line in os.environ["KRATE_REALM_EMAILS"].splitlines() if line.strip()}
    matches = []
    for user in users:
        if not isinstance(user, dict):
            raise ValueError()
        login, email = user.get("login"), user.get("email")
        disabled, auth_class = user.get("isDisabled"), user.get("authClass")
        if (not isinstance(login, str) or not login.strip()
                or not isinstance(email, str) or type(disabled) is not bool
                or auth_class not in ("local", "external")
                or any(char in login or char in email for char in "\x00\t\r\n")):
            raise ValueError()
        email = email.strip().lower()
        if email and email in realm:
            matches.append("%s\t%s\t%s\t%s" %
                           (login, email, "disabled" if disabled else "enabled", auth_class))
except (ValueError, TypeError):
    sys.exit("Grafana collision inventory has an invalid JSON shape")
print("\n".join(matches))')" || die "Grafana returned an invalid collision inventory"
  [[ -n "$matches" ]] || return 0
  while IFS=$'\t' read -r login email state auth_class; do
    case "$auth_class" in
      local)
        # Disabled local users still hold the address; preserve the observed remedy.
        printf '%b  !%b Local Grafana user %s (%s) holds the e-mail of realm user %s: that sign-in fails until the local user is retired\n' "$YELLOW" "$RESET" "$login" "$state" "$email"
        printf '         krate monitor grafana-user retire %q\n' "$login"
        ;;
      external)
        printf '%b  !%b External Grafana user %s (%s) shares the e-mail %s with a realm user. Its ownership by this realm is unknown; verify its authentication linkage before changing this account.\n' "$YELLOW" "$RESET" "$login" "$state" "$email"
        ;;
      *) die "Grafana returned an invalid authentication class" ;;
    esac
  done <<< "$matches"
}

# Grafana's address: with Krate sign-in (GRAFANA_AUTH_CONFIG=realm.ini) the cluster proxy
# serves it over TLS at /grafana/, and Grafana's own port is on the loopback interface.
grafana_address() {
  if [[ "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini && -n "$(public_url_host)" ]]; then
    printf 'https://%s/grafana/\n' "$(public_url_authority)"
  else
    printf 'http://%s:%s\n' "$(hostname -f 2>/dev/null || hostname)" "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_PORT 3000)"
  fi
}

# Perses' address. With the Krate realm (PERSES_IDP=krate) only the public name works:
# the realm client's redirect URI is built from it (monitoring/render.py realm_site
# public_url), so the host name of this machine would not sign in.
perses_address() {
  local port host
  port="$(env_value_file "$MONITOR_DIR/.env" PERSES_PORT 3443)"
  [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_IDP)" == krate ]] && host="$(public_url_host)"
  # Without a public name (KEYCLOAK_PUBLIC_URL unset) only the host name is left to print.
  [[ -n "${host:-}" ]] || host="$(hostname -f 2>/dev/null || hostname)"
  printf 'https://%s:%s\n' "$host" "$port"
}

# Grafana and Perses addresses and logins.
monitor_logins() {
  echo "Grafana:  $(grafana_address)"
  if [[ "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]]; then
    echo "Sign-in:  Krate sign-in (realm $IDENTITY_REALM); the user below is Grafana's own login, kept for the rollback on this host"
  fi
  echo "User:     $(env_value_file "$MONITOR_DIR/.env" GRAFANA_USER admin)"
  echo "Password: $(env_value_file "$MONITOR_DIR/.env" GRAFANA_PASSWORD changeme)"
  echo "Perses:   $(perses_address)"
  if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local)" == local ]]; then
    echo "User:     $(env_value_file "$MONITOR_DIR/.env" PERSES_ADMIN_USER admin)"
    echo "Password: $(env_value_file "$MONITOR_DIR/.env" PERSES_ADMIN_PASSWORD)"
  elif [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_IDP)" == krate ]]; then
    echo "Sign-in:  Krate sign-in (realm $IDENTITY_REALM)"
  else
    echo "Sign-in:  company SSO ($(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local) mode)"
  fi
}

# Prometheus's own verdict on its last configuration reload, as "<timestamp> <successful>"
# read over one metrics request inside the container (the host port is loopback-only).
# Exits non-zero when either metric is missing, which is how a stopped or unreachable
# Prometheus is told from a rejected configuration.
monitor_prometheus_reload_state() {
  monitor_compose exec -T prometheus wget -q -O - http://127.0.0.1:9090/metrics 2>/dev/null | awk '
    $1 == "prometheus_config_last_reload_success_timestamp_seconds" { timestamp = $2 }
    $1 == "prometheus_config_last_reload_successful" { successful = $2 }
    END { if (timestamp == "" || successful == "") exit 1; printf "%s %s\n", timestamp, successful }'
}

# Reload Prometheus and prove the result. The lifecycle API is off, so the reload is a
# SIGHUP; a signal always "succeeds", so the answer comes from the reload metrics: a
# rejected file leaves prometheus_config_last_reload_successful at 0 with the previous
# configuration still in use (harness/phase4/lab4 Q4).
monitor_reload_prometheus() {
  local before state timestamp successful waited=0
  before="$(monitor_prometheus_reload_state)" \
    || die "Prometheus did not answer on http://127.0.0.1:9090/metrics — is the stack up? (krate monitor status)"
  local before_ts="${before%% *}" before_ok="${before##* }"
  monitor_compose kill -s SIGHUP prometheus
  while :; do
    if state="$(monitor_prometheus_reload_state)"; then
      timestamp="${state%% *}"
      successful="${state##* }"
      # The flag describes THIS reload only once the timestamp moved, and a rejection is a
      # flip of the flag to 0: reading the flag first reported a good file as rejected when
      # an earlier reload had already left it at 0.
      if [[ "$timestamp" != "$before_ts" && "${successful%%.*}" == 1 ]]; then
        ok "Prometheus reloaded its configuration and alert rules."
        return 0
      fi
      if [[ "${successful%%.*}" == 0 && "${before_ok%%.*}" == 1 ]]; then
        die "Prometheus rejected the configuration and keeps running with the previous one. Fix monitoring/prometheus/prometheus.yml (or alerts.yml), then: krate monitor reload. The error: krate monitor logs prometheus"
      fi
    fi
    sleep 0.5
    waited=$((waited + 1))
    if [[ "$waited" -ge 20 ]]; then
      # A configuration rejected twice in a row never moves the success timestamp, so the
      # polling budget expires with the flag still 0: report the rejection, not a missing
      # reload. ${successful:-1} keeps set -u safe when no read ever succeeded.
      if [[ "${successful:-1}" == 0* ]]; then
        die "Prometheus rejected the configuration and keeps running with the previous one, and did so before this reload too. Fix monitoring/prometheus/prometheus.yml (or alerts.yml), then: krate monitor reload. The error: krate monitor logs prometheus"
      fi
      die "Prometheus reported no reload after 20 polls of its metrics (about 10 s) — is it running and healthy? (krate monitor status, krate monitor logs prometheus)"
    fi
  done
}

cmd_monitor() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)
      require_compose; require_compose_file; require_env
      local running_config running_class recorded held widened target_config target_class session_plan
      # Stage one known discovery before preparation, record writes or any Compose action.
      running_config="$(monitor_grafana_auth_running)" \
        || die "Grafana container sign-in state could not be determined; no session record or Compose action was performed. Check Docker access and the container configuration, then retry."
      running_class="$(monitor_grafana_class "$running_config")" \
        || die "Grafana container sign-in class could not be determined"
      info "Starting observability stack..."
      command -v python3 >/dev/null || die "python3 is required to initialize editable Grafana alerts."
      # The same preparation as the cluster commands: a cluster still running
      # under a legacy project name is adopted here too, so monitor_network
      # finds its brokers instead of looking in the fixed project.
      adopt_legacy_project
      ensure_cert
      monitor_prepare
      # While Grafana is on the realm, refresh its sign-in inputs and its seed token
      # first: Compose then recreates Grafana exactly when one of them changed.
      if [[ "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]]; then
        monitor_realm_refresh
      fi
      if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_IDP)" == krate ]]; then
        identity_reconcile_perses_clients optional
      fi
      local conflicts
      conflicts="$(monitor_port_conflicts | xargs)"
      [[ -z "$conflicts" ]] || die "Host ports already in use or configured twice: $conflicts. Choose free, distinct ones, e.g. krate config set GRAFANA_PORT=13000"
      # A sign-in switch ends the Grafana sessions the new sign-in does not allow: every
      # user's before the recreate (only the local admin's Basic login can, and realm mode
      # turns it off), the realm users' after it. What a refused or half-finished run still
      # owes stays in GRAFANA_AUTH_APPLIED, so the next run repeats it; a run that changes
      # nothing ends nothing.
      recorded="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_APPLIED)" \
        || die "Grafana session record could not be read"
      target_config="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" \
        || die "Grafana target sign-in could not be read"
      target_class="$(monitor_grafana_class "$target_config")" \
        || die "Grafana target sign-in class could not be determined"
      held="$(monitor_grafana_holders "$recorded" "$running_class")" \
        || die "Grafana session holders could not be determined"
      widened="$(monitor_grafana_holders "$recorded" "$running_class" "$target_class")" \
        || die "Grafana session holders could not be determined"
      session_plan="$(monitor_grafana_session_plan "$target_class" "$held")" \
        || die "Grafana session transition could not be determined"
      if [[ "$session_plan" == all ]]; then
        # Compose refuses a stopped cluster only when it runs: refuse before anyone is signed out.
        monitor_network >/dev/null || die "The cluster is not running — start it first: krate start"
        monitor_grafana_end_sessions all 30 || die "Grafana session revocation failed"
        monitor_grafana_record_holders "$target_class" || die "Grafana session record could not be written"
      else
        monitor_grafana_record_holders "$widened" || die "Grafana session record could not be written"
      fi
      # Compose leaves a dropped profile's services running. In local mode remove
      # the SSO services first, so the previous mode's guard cannot act on Perses.
      if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local)" == local ]]; then
        monitor_compose rm -s -f oauth2-proxy perses-sync >/dev/null \
          || die "Dropped monitoring SSO services could not be removed; Grafana sign-in transition stopped"
      fi
      monitor_compose up -d || die "Monitoring startup failed; Grafana sign-in transition remains owed"
      if [[ "$session_plan" == external ]]; then
        monitor_grafana_end_sessions external 120 || die "Grafana session revocation failed"
        monitor_grafana_record_holders "$target_class" || die "Grafana session record could not be written"
      fi
      if [[ "$(env_value_file "$MONITOR_DIR/.env" PERSES_IDP)" == krate ]]; then
        local current_issuer
        current_issuer="$(env_value KEYCLOAK_PUBLIC_URL)"
        current_issuer="${current_issuer%/}/realms/$IDENTITY_REALM"
        set_env_file_value "$MONITOR_DIR/.env" PERSES_ISSUER_APPLIED "$current_issuer"
      fi
      python3 "$MONITOR_DIR/seed-alerting.py" "$MONITOR_DIR/.env"
      echo ""
      # Realm mode: the cluster proxy serves Grafana over TLS at /grafana/, and its own
      # port is on the loopback interface (use it for the local login rollback).
      ok "Grafana:    $(grafana_address)"
      # Prometheus (and Loki) answer on PROM_BIND/LOKI_BIND only, 127.0.0.1 by
      # default: the address printed is the one that works.
      local prom_bind prom_host
      prom_bind="$(env_value_file "$MONITOR_DIR/.env" PROM_BIND 127.0.0.1)"
      if [[ "$prom_bind" == 0.0.0.0 ]]; then
        prom_host="$(hostname -f 2>/dev/null || hostname)"
      else
        prom_host="$prom_bind"
      fi
      ok "Prometheus: http://${prom_host}:$(env_value_file "$MONITOR_DIR/.env" PROM_PORT 9090)$([[ "$prom_bind" == 0.0.0.0 ]] || echo ' (this host only; PROM_BIND)')"
      ok "Perses:     $(perses_address) ($(env_value_file "$MONITOR_DIR/.env" PERSES_AUTH_MODE local) sign-in)"
      note_smtp
      ;;
    down)
      require_compose
      local running_config running_class recorded held
      running_config="$(monitor_grafana_auth_running)" \
        || die "Grafana container sign-in state could not be determined; no session record or Compose action was performed. Check Docker access and the container configuration, then retry."
      running_class="$(monitor_grafana_class "$running_config")" \
        || die "Grafana container sign-in class could not be determined"
      recorded="$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_APPLIED)" \
        || die "Grafana session record could not be read"
      held="$(monitor_grafana_holders "$recorded" "$running_class")" \
        || die "Grafana session holders could not be determined"
      monitor_grafana_record_holders "$held" || die "Grafana session record could not be written"
      monitor_compose down "$@"
      ;;
    status)  require_compose; monitor_compose ps ;;
    logs)    require_compose; monitor_compose logs --tail 100 "$@" ;;
    reload)
      # Re-read the configuration and alert rules without restarting Prometheus
      # (SIGHUP, then Prometheus's own reload metrics: the lifecycle API is off).
      require_compose
      monitor_reload_prometheus
      ;;
    realm)
      # Prepare the switch while Grafana still signs in locally: only the Basic
      # admin can read what this checks (harness/phase4/lab6 L5-4). Every later
      # krate monitor up regenerates realm.ini and reconciles the client.
      require_compose; require_compose_file; require_env
      command -v python3 >/dev/null || die "python3 is required for the Grafana realm switch"
      [[ -f "$MONITOR_DIR/grafana-admin.py" ]] \
        || die "monitoring/grafana-admin.py is missing: was this package built with the observability stack?"
      if [[ "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" != local.ini ]]; then
        die "Grafana already signs in with $(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini), and krate monitor realm runs against the local login: it is the only one that can read what this command checks.
To go back to the local login: krate config set GRAFANA_AUTH_CONFIG=local.ini && krate monitor up"
      fi
      refuse_loopback_public_url
      local state origin blocked
      state="$(identity_state)" || exit 1
      [[ "${state%% *}" == existing ]] || die "No identity database (state: $state). Run: krate identity up, then krate auth apply"
      origin="$(public_url_origin)"
      # Refuse a Grafana whose state realm mode would hide from the API: after the
      # switch a database SSO setting, a public dashboard and a snapshot answer
      # 404/403, so an operator would lose sight of them (harness/phase4/lab6 L5-4).
      blocked="$(grafana_admin reads | python3 -c '
import json, sys
data = json.load(sys.stdin)
found = []
# A degraded read is not a clean one: null with a note means "not readable with these
# credentials", never "nothing there" (harness/phase4/team/t-grafana-admin.md, section g).
notes = data.get("notes") or []
if notes:
    found.append("Grafana did not answer every read cleanly (%s)" % "; ".join(notes))
source = data.get("sso_settings_source")
if source != "system":
    found.append("the generic_oauth SSO setting is not the ini-derived one (source=%r)" % source)
for key, label in (("public_dashboards", "public dashboard"), ("snapshots", "snapshot")):
    count = data.get(key) or 0
    if count:
        found.append("%d %s%s" % (count, label, "" if count == 1 else "s"))
print("; ".join(found))')" \
        || die "Grafana did not answer with the Basic admin on http://127.0.0.1:$(env_value_file "$MONITOR_DIR/.env" GRAFANA_PORT 3000) — is the stack up (krate monitor status), and is GRAFANA_PASSWORD the password Grafana's volume holds?"
      [[ -z "$blocked" ]] || die "Grafana carries state that realm mode hides from its API: $blocked.
Remove it first — a public dashboard under Dashboards → Share → Public dashboard, a snapshot under Dashboards → Snapshots, a database SSO setting through Grafana's provisioning API — then run: krate monitor realm"
      if [[ -n "$(fill_secrets "$MONITOR_DIR/.env" 24 GRAFANA_OAUTH_CLIENT_SECRET | xargs)" ]]; then
        ok "Generated GRAFANA_OAUTH_CLIENT_SECRET in monitoring/.env"
      fi
      monitor_grafana_seed_token 90
      grafana_list_collisions
      identity_reconcile_grafana_client "$origin"
      python3 "$(sso_dir)/identity.py" grafana-ini --env-file "$ENV_FILE" --output "$MONITOR_DIR/auth/realm.ini" >/dev/null \
        || die "Cannot write monitoring/auth/realm.ini"
      ok "Wrote monitoring/auth/realm.ini"
      echo ""
      info "Next: krate config set GRAFANA_AUTH_CONFIG=realm.ini && krate monitor up (ends every Grafana session made with Grafana's own login)"
      ;;
    grafana-user)
      local gsub="${1:-}"; shift || true
      case "$gsub" in
        retire)
          [[ $# -eq 1 ]] || die "Usage: krate monitor grafana-user retire <login>"
          require_compose; require_env
          # This command speaks to Grafana as the Basic admin. Realm mode turns Basic off
          # ([auth.basic] enabled = false, and row U2 asserts a Basic call answers 401), and
          # the seed service account may not administer users either: disabling a user needs
          # the global-org ActionUsersDisable permission, i.e. a Grafana server admin, while
          # krate-seed is an org Admin (grafana-v12.2.0 api.go:561-568). Say so and give the
          # sequence that works, instead of failing with a misleading credential hint.
          if [[ "$(env_value_file "$MONITOR_DIR/.env" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]]; then
            die "Grafana is in realm mode, where the Basic admin this command needs is disabled and the seed service account may not administer users. Roll back, retire, and switch again:
  krate config set GRAFANA_AUTH_CONFIG=local.ini && krate monitor up
  krate monitor grafana-user retire $1
  krate config set GRAFANA_AUTH_CONFIG=realm.ini && krate monitor up"
          fi
          # Retiring moves the e-mail aside AND disables the account: disabling
          # alone still fails the realm sign-in with "User sync failed"
          # (harness/phase4/lab6 L5-5). Folders and dashboards the user owns stay.
          local retired_email
          retired_email="$(grafana_admin retire-user --login "$1" \
            | python3 -c 'import json, sys; print(json.load(sys.stdin)["email"])')" \
            || die "Grafana refused to retire $1 — is it running, and is GRAFANA_PASSWORD right?"
          ok "Retired the local Grafana user $1: disabled, e-mail moved to $retired_email, its folders and dashboards untouched"
          ;;
        *) die "Usage: krate monitor grafana-user retire <login>" ;;
      esac
      ;;
    ui) monitor_logins ;;
    *)
      echo "Usage: krate monitor {up|down|status|logs|reload|ui|realm|grafana-user retire <login>}"
      return 1 ;;
  esac
}

# Read a key from an arbitrary env file, with a default. Quotes and CR are stripped: a
# CRLF-edited monitoring/.env must not make identity_realm_ui compare realm.ini\r and
# report local (Compose itself tolerates CRLF).
env_value_file() {
  local file="$1" key="$2" default="${3:-}" v=""
  [[ -f "$file" ]] && v="$(grep -E "^${key}=" "$file" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"'"'"'\r')"
  echo "${v:-$default}"
}

# Alerting works without SMTP; only delivery is off. Say so rather than let an
# operator assume email is configured.
# Generate the per-install secrets of the parallel Perses stack, and refuse
# unsafe defaults, before the monitoring-init renderer reads monitoring/.env.
monitor_prepare() {
  local env_file="$MONITOR_DIR/.env"
  prepare_monitor_env
  for bind_var in PROM_BIND LOKI_BIND; do
    local bind_val; bind_val="$(env_value_file "$env_file" "$bind_var" 127.0.0.1)"
    if [[ "$bind_val" != 127.0.0.1 ]]; then
      warn "$bind_var is '$bind_val' (not loopback 127.0.0.1): this backing service has no authentication of its own and is exposed to the host network"
    fi
  done
  # prepare_monitor_env only warns here, because it also runs on cluster start;
  # the monitoring stack itself does not start on the insecure default.
  if [[ "$(env_value_file "$env_file" GRAFANA_PASSWORD)" == changeme ]]; then
    die "GRAFANA_PASSWORD is changeme (insecure) and Grafana's volume exists with it.
Change it in Grafana (docker exec <grafana container> grafana cli admin reset-admin-password <new>),
record it with: krate config set GRAFANA_PASSWORD=<new>, then: krate monitor up"
  fi
  # A monitoring UI on the realm needs a public name that is not loopback, and Grafana
  # needs the seed token `krate monitor realm` created. Both are refused here, before
  # Compose runs, so nothing is created or recreated by a refused run.
  if [[ "$(env_value_file "$env_file" GRAFANA_AUTH_CONFIG local.ini)" == realm.ini ]]; then
    refuse_loopback_public_url
    [[ -f "$MONITOR_DIR/auth/secrets/grafana-seed.meta" ]] || die "GRAFANA_AUTH_CONFIG=realm.ini but monitoring/auth/secrets/grafana-seed.meta is missing: the realm switch was never completed here.
Run: krate monitor realm     (or go back: krate config set GRAFANA_AUTH_CONFIG=local.ini, then krate monitor up)"
  fi
  if [[ "$(env_value_file "$env_file" PERSES_IDP)" == krate ]]; then
    refuse_loopback_public_url
    local p_mode
    p_mode="$(env_value_file "$env_file" PERSES_AUTH_MODE local)"
    [[ "$p_mode" == native ]] || die "PERSES_IDP=krate requires PERSES_AUTH_MODE=native (got $p_mode)"
    local current_issuer applied_issuer
    current_issuer="$(env_value KEYCLOAK_PUBLIC_URL)"
    current_issuer="${current_issuer%/}/realms/$IDENTITY_REALM"
    applied_issuer="$(env_value_file "$env_file" PERSES_ISSUER_APPLIED)"
    if [[ -n "$applied_issuer" && "$applied_issuer" != "$current_issuer" ]]; then
      set_env_file_value "$env_file" OAUTH2_PROXY_COOKIE_SECRET "$(random_secret 32)"
      ok "Regenerated OAUTH2_PROXY_COOKIE_SECRET for new issuer"
    fi
  fi
  mkdir -p "$MONITOR_DIR/auth/perses"
  python3 - "$env_file" <<'PY' || die "monitoring/.env is not ready for the Perses stack (see above)."
import re, sys
path = sys.argv[1]
text = open(path).read()

def value(key):
    found = re.findall(r'^%s=(.*)$' % re.escape(key), text, re.M)
    return found[-1].strip().strip('"\'') if found else ''

mode = value('PERSES_AUTH_MODE') or 'local'
if mode == 'local' and len(value('PERSES_ADMIN_PASSWORD')) < 12:
    sys.exit('  PERSES_ADMIN_PASSWORD in monitoring/.env is shorter than 12 characters; set a longer one or empty it to generate one.')
if mode in ('native', 'gateway') and not value('OAUTH2_PROXY_CLIENT_SECRET'):
    sys.exit('  Set OAUTH2_PROXY_CLIENT_SECRET (the Perses OIDC client secret) in monitoring/.env.')
if mode == 'native' and not value('PERSES_SYNC_CLIENT_SECRET'):
    sys.exit('  Set PERSES_SYNC_CLIENT_SECRET (the access guard client secret) in monitoring/.env.')
PY
  # The rendered stack, checked before anything is created or recreated: no monitoring
  # service on an identity network, Grafana on exactly the two networks it needs, and
  # in realm mode its port on the loopback interface with the issuer route and the
  # rendered secret present.
  monitor_compose config --format json \
    | python3 "$(sso_dir)/preflight.py" --directory "$SCRIPT_DIR" --mode monitoring \
    || die "Monitoring preflight failed (see above); nothing was started or recreated."
}

note_smtp() {
  local en; en="$(env_value_file "$MONITOR_DIR/.env" GF_SMTP_ENABLED false)"
  if [[ "$en" != "true" ]]; then
    warn "Email delivery is off (GF_SMTP_ENABLED=false). Alerts still fire and show in Grafana."
    warn "To enable: krate config set GF_SMTP_ENABLED=true (and GF_SMTP_HOST, ALERT_EMAIL_TO, ...), then krate monitor up"
  fi
}

# ─── doctor (preflight) ───────────────────────────────────────────────────────
# Read-only checks run before touching the host. Catches the things that bite
# a shared box: busy host ports, a firewalld/Docker NAT zone conflict, and a
# missing/old Docker or Compose. Returns non-zero if a blocking issue is found.
cmd_doctor() {
  sep
  echo -e "${BOLD}  Preflight Check${RESET}"
  sep
  echo ""

  local problems=0

  # ── Docker engine + daemon ──
  info "Docker engine"
  if command -v docker &>/dev/null; then
    local dv
    dv=$(docker --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if version_gte "$dv" "25.0.3"; then
      ok "Docker $dv"
    else
      warn "Docker $dv — minimum required: 25.0.3"
      problems=$((problems + 1))
    fi
    if docker info &>/dev/null 2>&1; then
      ok "daemon is running"
    else
      err "daemon not running or not accessible — try: sudo systemctl start docker"
      problems=$((problems + 1))
    fi
  else
    err "docker not found — run: krate docker-install"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Compose ──
  info "Docker Compose"
  if [[ ${#COMPOSE_BIN[@]} -gt 0 ]]; then
    local cv
    cv=$(get_compose_version)
    if version_gte "$cv" "1.29.2"; then
      ok "${COMPOSE_BIN[*]} $cv"
    else
      warn "${COMPOSE_BIN[*]} $cv — minimum required: 1.29.2"
      problems=$((problems + 1))
    fi
  else
    err "Docker Compose not found — run: krate docker-install"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Bundle files ──
  info "Bundle files"
  if [[ -f "$COMPOSE_FILE" ]]; then
    ok "docker-compose.yml"
  else
    err "docker-compose.yml missing in $SCRIPT_DIR"
    problems=$((problems + 1))
  fi
  # A package keeps the site's settings and certificate in its installation.
  # On a first install they may still sit in the takeover source (`install
  # --from DIR`, or the package directory itself), which deploy_release copies
  # into KRATE_HOME; check there, so an existing certificate counts.
  local site_dir="$SCRIPT_DIR" src
  if is_package; then
    site_dir="$KRATE_HOME"
    ok "installs into $KRATE_HOME"
    if [[ ! -f "$KRATE_HOME/.env" ]]; then
      for src in "${KRATE_INSTALL_FROM:-}" "$SCRIPT_DIR"; do
        if [[ -n "$src" && -f "$src/.env" ]]; then
          site_dir="$src"
          ok "site files taken over from $src"
          break
        fi
      done
    fi
  fi
  if [[ -f "$site_dir/.env" ]]; then
    ok ".env present in $site_dir (kept)"
  else
    ok "no .env yet — install creates it with generated passwords"
  fi
  if [[ -f "$site_dir/certs/server.crt" && -f "$site_dir/certs/server.key" ]]; then
    ok "TLS certificate present in $site_dir/certs (kept)"
  elif command -v openssl &>/dev/null; then
    ok "no TLS cert yet — will be generated with openssl on install"
  else
    err "no TLS cert and openssl not found — install/start will fail to generate one"
    warn "Install openssl (e.g. apt-get install -y openssl) or drop a cert in certs/server.{crt,key}"
    problems=$((problems + 1))
  fi
  echo ""

  # ── Architecture match ──
  # The bundled images are arch-specific; running them on a mismatched host
  # fails at container start with "exec format error". Catch it here instead.
  info "Architecture"
  if [[ -f "$SCRIPT_DIR/.bundle-arch" ]]; then
    local bundle_arch host_arch
    bundle_arch="$(tr -d '[:space:]' < "$SCRIPT_DIR/.bundle-arch")"
    host_arch="$(docker version --format '{{.Server.Arch}}' 2>/dev/null || true)"
    if [[ -z "$host_arch" ]]; then
      warn "bundle is $bundle_arch; could not determine host arch to compare"
    elif [[ "$bundle_arch" == "$host_arch" ]]; then
      ok "bundle $bundle_arch matches host $host_arch"
    else
      err "bundle is $bundle_arch but this host is $host_arch — images will not run (exec format error)."
      err "Use the $host_arch bundle instead (kafka-<mode>-<ver>-$host_arch.tar.gz)."
      problems=$((problems + 1))
    fi
  else
    warn "no .bundle-arch marker — cannot verify architecture (older bundle?)"
  fi
  echo ""

  # ── Host port availability ──
  info "Host port availability"
  local busy=0 ports
  ports="$(get_published_ports)"
  for p in $ports; do
    if port_in_use "$p"; then
      warn "port $p is already in use"
      busy=$((busy + 1))
    else
      ok "port $p free"
    fi
  done
  if (( busy > 0 )); then
    warn "If this cluster is already running, in-use ports are expected (it's us)."
    warn "Otherwise free them or change the external ports in .env before installing."
  fi
  echo ""

  # ── Firewall / Docker NAT compatibility ──
  info "Firewall (Docker NAT compatibility)"
  if command -v firewall-cmd &>/dev/null && firewall-cmd --state &>/dev/null 2>&1; then
    if firewall-cmd --get-zones 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
      local tgt
      tgt="$(firewall-cmd --info-zone=docker 2>/dev/null | awk -F': ' '/target:/{print $2}' | tr -d '[:space:]')"
      if [[ "$tgt" == "ACCEPT" ]]; then
        ok "firewalld active, 'docker' zone present (target ACCEPT)"
      else
        warn "firewalld 'docker' zone target is '${tgt:-unknown}', not ACCEPT — containers may not reach each other."
        warn "Fix: firewall-cmd --permanent --zone=docker --set-target=ACCEPT && firewall-cmd --reload && systemctl restart docker"
        problems=$((problems + 1))
      fi
    else
      warn "firewalld is active but has no 'docker' zone."
      warn "Docker can abort with: Failed to program NAT chain: INVALID_ZONE: docker"
      warn "Fix: firewall-cmd --permanent --new-zone=docker && firewall-cmd --permanent --zone=docker --set-target=ACCEPT && firewall-cmd --reload && systemctl restart docker"
      problems=$((problems + 1))
    fi
  else
    ok "firewalld not active — no NAT-zone conflict expected"
  fi
  echo ""

  # ── iptables backend consistency ──
  # If Docker's FORWARD rules end up in BOTH iptables-legacy and iptables-nft,
  # one stale layer's default-drop silently blocks container-to-container traffic.
  # Listing iptables rules needs root, so report honestly when we can't inspect.
  info "iptables backend"
  if [[ "$(id -u)" != "0" ]]; then
    warn "not root — skipped the legacy/nft split-brain check (re-run as root to verify)"
  else
    local legacy_docker=false nft_docker=false
    if iptables-legacy -S FORWARD 2>/dev/null | grep -q 'DOCKER'; then legacy_docker=true; fi
    if iptables-nft     -S FORWARD 2>/dev/null | grep -q 'DOCKER'; then nft_docker=true; fi
    if $legacy_docker && $nft_docker; then
      err "Docker FORWARD rules exist in BOTH iptables-legacy and iptables-nft (split-brain)."
      err "Container networking can break. Align on one backend, e.g.:"
      err "  update-alternatives --set iptables /usr/sbin/iptables-nft && systemctl restart docker"
      problems=$((problems + 1))
    elif $legacy_docker || $nft_docker; then
      ok "single iptables backend ($($legacy_docker && echo legacy || echo nf_tables))"
    else
      warn "no Docker FORWARD rules found in either backend — is Docker running? (couldn't verify)"
    fi
  fi
  echo ""

  sep
  if (( problems == 0 )); then
    ok "All preflight checks passed."
    return 0
  else
    warn "$problems blocking issue(s) found — resolve them before 'krate install'."
    return 1
  fi
}

# ─── docker-check ─────────────────────────────────────────────────────────────
cmd_docker_check() {
  sep
  echo -e "${BOLD}  Docker Environment Check${RESET}"
  sep
  echo ""

  local all_ok=true

  # ── Docker binary + min version ──
  if command -v docker &>/dev/null; then
    local dv
    dv=$(docker --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    ok "docker found at $(command -v docker)"
    if version_gte "$dv" "25.0.3"; then
      ok "Docker Engine $dv"
    else
      warn "Docker Engine $dv — minimum required: 25.0.3"
      all_ok=false
    fi
  else
    err "docker not found in PATH"
    all_ok=false
  fi

  # ── Docker daemon ──
  if docker info &>/dev/null 2>&1; then
    ok "Docker daemon is running"
  else
    err "Docker daemon is not running or not accessible"
    warn "  sudo systemctl start docker"
    warn "  newgrp docker  (if recently added to docker group)"
    all_ok=false
  fi

  # ── Compose binary + min version ──
  if [[ ${#COMPOSE_BIN[@]} -gt 0 ]]; then
    local cv
    cv=$(get_compose_version)
    if version_gte "$cv" "1.29.2"; then
      ok "${COMPOSE_BIN[*]} ($cv)"
    else
      warn "${COMPOSE_BIN[*]} $cv — minimum required: 1.29.2"
      all_ok=false
    fi
  else
    err "Docker Compose not found"
    warn "  Need: 'docker compose' plugin (v2) OR 'docker-compose' ≥1.29.2"
    all_ok=false
  fi

  echo ""
  if $all_ok; then
    ok "Docker is ready"
  else
    warn "Issues found. Run: krate docker-install"
    return 1
  fi
}

# ─── docker-install ───────────────────────────────────────────────────────────
cmd_docker_install() {
  [[ -d "$DOCKER_OFFLINE_DIR" ]] || die "docker-offline/ not found in $SCRIPT_DIR
This bundle was not packaged with Docker. On an internet-connected build machine, rebuild it with:
  make docker-debs UBUNTU_VERSION=<jammy|noble> ARCH=<amd64|arm64>
  make bundle VERSION=vN ARCH=<amd64|arm64> INCLUDE_DOCKER=1
Then transfer the rebuilt bundle to this offline VM."

  shopt -s nullglob
  local debs=("$DOCKER_OFFLINE_DIR"/*.deb)
  shopt -u nullglob

  [[ ${#debs[@]} -gt 0 ]] || die "No .deb files in $DOCKER_OFFLINE_DIR
On an internet-connected build machine, rebuild the bundle with:
  make docker-debs UBUNTU_VERSION=<jammy|noble> ARCH=<amd64|arm64>
  make bundle VERSION=vN ARCH=<amd64|arm64> INCLUDE_DOCKER=1
Then transfer the rebuilt bundle to this offline VM."

  info "Installing Docker CE from ${#debs[@]} bundled packages..."
  echo ""

  local order=(containerd.io docker-ce-cli docker-ce docker-compose-plugin)
  local -a matches
  for pkg in "${order[@]}"; do
    matches=()
    for f in "${debs[@]}"; do
      if [[ "$(basename "$f")" == "${pkg}_"* ]]; then
        matches+=("$f")
      fi
    done
    if [[ ${#matches[@]} -eq 1 ]]; then
      echo "  Installing $(basename "${matches[0]}")..."
      sudo dpkg -i "${matches[0]}" || true
    elif [[ ${#matches[@]} -eq 0 ]]; then
      warn "Package not found in bundle: $pkg"
    else
      die "Multiple packages found for $pkg; refusing to choose one:
$(printf '  %s\n' "${matches[@]}")"
    fi
  done

  echo ""
  info "Resolving any remaining dependencies..."
  sudo apt-get install -f -y 2>/dev/null || true

  sudo systemctl enable docker
  sudo systemctl start docker

  if ! groups "$USER" 2>/dev/null | grep -q '\bdocker\b'; then
    sudo usermod -aG docker "$USER"
    warn "Added $USER to docker group."
    warn "Run 'newgrp docker' or log out and back in before using Docker without sudo."
  fi

  echo ""
  ok "$(docker --version)"
  ok "$(docker compose version 2>/dev/null || docker-compose version 2>/dev/null)"
  ok "Docker installed successfully."
}

# ─── lag ──────────────────────────────────────────────────────────────────────
cmd_lag() {
  require_compose; require_compose_file

  local group=""
  local topic=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --group|-g) group="$2"; shift 2 ;;
      --topic|-t) topic="$2"; shift 2 ;;
      -*)         die "Unknown option: $1. Usage: krate lag [group] [--topic <topic>]" ;;
      *)          group="$1"; shift ;;
    esac
  done

  local broker
  broker=$(find_broker)

  if [[ -n "$group" ]]; then
    # ── Detailed view: one group, per-partition breakdown ─────────────────────
    sep
    printf "${BOLD}  Consumer Group: %s${RESET}\n" "$group"
    [[ -n "$topic" ]] && printf "  Topic filter:   %s\n" "$topic"
    sep
    echo ""

    local raw
    raw=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server "$BOOTSTRAP" \
      --describe --group "$group") || die "Failed to describe group '$group'"

    if echo "$raw" | grep -qiE "does not exist|group .* not found"; then
      die "Consumer group '$group' does not exist."
    fi

    [[ -n "$topic" ]] && raw=$(echo "$raw" | awk -v t="$topic" 'NR==1 || $2==t')

    printf "  ${BOLD}%-32s %-9s %-15s %-15s %-10s %-22s${RESET}\n" \
      "TOPIC" "PARTITION" "CURRENT-OFFSET" "LOG-END-OFFSET" "LAG" "CONSUMER-ID"
    sep

    local total_lag=0 partition_count=0

    while IFS= read -r line; do
      [[ "$line" =~ ^GROUP ]] && continue
      [[ -z "$(echo "$line" | tr -d '[:space:]')" ]] && continue

      local grp t part cur_off log_end lag consumer_id
      grp=$(         echo "$line" | awk '{print $1}')
      t=$(           echo "$line" | awk '{print $2}')
      part=$(        echo "$line" | awk '{print $3}')
      cur_off=$(     echo "$line" | awk '{print $4}')
      log_end=$(     echo "$line" | awk '{print $5}')
      lag=$(         echo "$line" | awk '{print $6}')
      consumer_id=$( echo "$line" | awk '{print $7}')

      # Truncate consumer-id for readability
      local short_cid="${consumer_id:0:20}"
      [[ "${#consumer_id}" -gt 20 ]] && short_cid="${short_cid}…"

      local lag_col
      if [[ "$lag" =~ ^[0-9]+$ ]]; then
        if   [[ "$lag" -eq 0 ]];    then lag_col="${GREEN}${lag}${RESET}"
        elif [[ "$lag" -lt 1000 ]]; then lag_col="${YELLOW}${lag}${RESET}"
        else                             lag_col="${RED}${lag}${RESET}"
        fi
        total_lag=$((total_lag + lag))
        ((partition_count += 1)) || true
      else
        lag_col="${DIM}${lag:-—}${RESET}"
      fi

      printf "  %-32s %-9s %-15s %-15s %-10b %-22s\n" \
        "$t" "$part" "$cur_off" "$log_end" "$lag_col" "$short_cid"

    done <<< "$raw"

    sep
    printf "  Partitions: %-6s  Total lag: " "$partition_count"
    if   [[ "$total_lag" -eq 0 ]];    then echo -e "${GREEN}${total_lag}${RESET}  (caught up)"
    elif [[ "$total_lag" -lt 1000 ]]; then echo -e "${YELLOW}${total_lag}${RESET}"
    else                                   echo -e "${RED}${total_lag}${RESET}  — consumer is behind"
    fi
    echo ""

  else
    # ── Summary view: all groups ──────────────────────────────────────────────
    sep
    echo -e "${BOLD}  Consumer Group Lag Summary${RESET}"
    [[ -n "$topic" ]] && echo -e "  Topic filter: ${topic}"
    sep
    echo ""

    local groups
    groups=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
      --bootstrap-server "$BOOTSTRAP" \
      --list 2>/dev/null | grep -v "^$" | sort) || die "Failed to list consumer groups"

    if [[ -z "$groups" ]]; then
      warn "No consumer groups found."
      return
    fi

    printf "  ${BOLD}%-42s %-12s %-12s %s${RESET}\n" "GROUP" "PARTITIONS" "TOTAL LAG" "STATUS"
    sep

    local group_count=0 lagging_count=0

    while IFS= read -r grp; do
      [[ -z "$grp" ]] && continue

      local raw_desc
      raw_desc=$(docker exec "$broker" /opt/kafka/bin/kafka-consumer-groups.sh \
        --bootstrap-server "$BOOTSTRAP" \
        --describe --group "$grp" 2>/dev/null || true)

      [[ -n "$topic" ]] && raw_desc=$(echo "$raw_desc" | awk -v t="$topic" 'NR==1 || $2==t')

      local total_lag=0 part_count=0
      while IFS= read -r line; do
        [[ "$line" =~ ^GROUP ]] && continue
        [[ -z "$(echo "$line" | tr -d '[:space:]')" ]] && continue
        local lag
        lag=$(echo "$line" | awk '{print $6}')
        if [[ "$lag" =~ ^[0-9]+$ ]]; then
          total_lag=$((total_lag + lag))
          ((part_count += 1)) || true
        fi
      done <<< "$raw_desc"

      # Skip groups with no matching partitions when filtering by topic
      [[ "$part_count" -eq 0 && -n "$topic" ]] && continue

      local status_col
      if   [[ "$total_lag" -eq 0 ]];    then status_col="${GREEN}caught up${RESET}"
      elif [[ "$total_lag" -lt 1000 ]]; then status_col="${YELLOW}lagging${RESET}";  ((lagging_count += 1)) || true
      else                                   status_col="${RED}behind${RESET}";    ((lagging_count += 1)) || true
      fi

      printf "  %-42s %-12s %-12s %b\n" "$grp" "$part_count" "$total_lag" "$status_col"
      ((group_count += 1)) || true

    done <<< "$groups"

    echo ""
    sep
    printf "  %s group(s)   %s with lag > 0\n" "$group_count" "$lagging_count"
    echo ""
    echo -e "  ${DIM}Drill down:  krate lag <group-name>"
    echo -e "  Topic only:  krate lag --topic <topic-name>${RESET}"
    echo ""
  fi
}

