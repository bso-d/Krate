# ─── dispatch ─────────────────────────────────────────────────────────────────
CMD="${1:-help}"
shift || true

# In an extracted package, everything but install and the host checks runs the
# installed copy, which holds the site's settings and certificates.
if is_package; then
  case "$CMD" in
    install|doctor|docker-check|docker-install|load-images|studio|help|--help|-h) ;;
    *)
      [[ -x "$KRATE_HOME/krate" ]] || die "Not installed yet. Run: ./krate install"
      exec "$KRATE_HOME/krate" "$CMD" "$@"
      ;;
  esac
fi

case "$CMD" in
  install)        cmd_install "$@" ;;
  load-images)    cmd_load_images ;;
  start)          cmd_start "$@" ;;
  setup)          cmd_setup ;;
  credentials)    cmd_credentials ;;
  build)          cmd_build ;;
  package)        cmd_package "$@" ;;
  stop)           cmd_stop "$@" ;;
  restart)        cmd_restart "$@" ;;
  down)           cmd_down ;;
  status)         cmd_status ;;
  logs)           cmd_logs "$@" ;;
  health)         cmd_health "$@" ;;
  lag)            cmd_lag "$@" ;;
  ui)             cmd_ui ;;
  studio)         cmd_studio "$@" ;;
  auth)           cmd_auth "$@" ;;
  identity)       cmd_identity "$@" ;;
  config)         cmd_config "$@" ;;
  uninstall)      cmd_uninstall "$@" ;;
  monitor)        cmd_monitor "$@" ;;
  doctor)         cmd_doctor ;;
  gen-cert)       cmd_gen_cert ;;
  docker-check)   cmd_docker_check ;;
  docker-install) cmd_docker_install ;;
  help|--help|-h) cmd_help ;;
  *)              err "Unknown command: $CMD"; cmd_help; exit 1 ;;
esac
