# ─── status ───────────────────────────────────────────────────────────────────
cmd_status() {
  require_compose; require_compose_file
  compose_cmd ps
}

# ─── logs ─────────────────────────────────────────────────────────────────────
cmd_logs() {
  require_compose; require_compose_file
  local follow=false
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=true; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done

  if $follow; then
    compose_cmd logs -f --tail=50 "${args[@]}"
  else
    compose_cmd logs --tail=100 "${args[@]}"
  fi
}

# ─── health ───────────────────────────────────────────────────────────────────
# Count containers still in Docker's transient "starting" state — i.e. inside
# their healthcheck start_period, not yet settled either way.
health_pending_count() {
  local cid n=0 h
  while IFS= read -r cid; do
    [[ -z "$cid" ]] && continue
    h=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo none)
    [[ "$h" == "starting" ]] && n=$((n + 1))
  done <<< "$1"
  echo "$n"
}

cmd_health() {
  require_compose; require_compose_file

  # A service reports "starting" until its start_period elapses, so a one-shot
  # check straight after `krate start` is a false negative (the proxy is the
  # usual victim — it only starts once the UI, and thus every broker, is up).
  # Wait for the cluster to settle by default; an already-settled cluster
  # returns immediately, so this costs nothing once things are steady.
  local wait=true timeout=120
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-wait) wait=false; shift ;;
      --timeout) timeout="${2:?--timeout needs a value in seconds}"; shift 2 ;;
      *)         die "Unknown option: $1 (usage: krate health [--no-wait] [--timeout N])" ;;
    esac
  done
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds"

  local container_ids
  container_ids=$(compose_cmd ps -q 2>/dev/null || true)

  if [[ -z "$container_ids" ]]; then
    warn "No containers running. Run: krate start"
    return 1
  fi

  if $wait; then
    local waited=0 interval=3 pending
    pending=$(health_pending_count "$container_ids")
    while (( pending > 0 )) && (( waited < timeout )); do
      if [[ -t 1 ]]; then
        printf "\r  ${DIM}waiting for %d service(s) to settle... %ds/%ds${RESET}" \
          "$pending" "$waited" "$timeout"
      fi
      sleep "$interval"
      waited=$(( waited + interval ))
      container_ids=$(compose_cmd ps -q 2>/dev/null || true)
      pending=$(health_pending_count "$container_ids")
    done
    if [[ -t 1 ]]; then
      printf "\r\033[K"
    fi
  fi

  sep
  echo -e "${BOLD}  Service Health${RESET}"
  sep
  echo ""

  local all_ok=true crashing=""

  while IFS= read -r cid; do
    [[ -z "$cid" ]] && continue
    local name status health restarting restarts service state label
    # One inspect per container; one that vanished since `ps` reads as gone instead of
    # stopping the report (errexit).
    state="$(docker inspect --format '{{.Name}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.State.Restarting}}|{{.RestartCount}}|{{index .Config.Labels "com.docker.compose.service"}}' "$cid" 2>/dev/null || true)"
    if [[ -z "$state" ]]; then
      printf "  %-35s %b\n" "${cid:0:12}" "${RED}gone${RESET}"
      all_ok=false
      continue
    fi
    IFS='|' read -r name status health restarting restarts service <<< "$state"
    name="${name#/}"

    if [[ "$health" == "healthy" ]]; then
      label="${GREEN}healthy${RESET}"
    elif [[ "$health" == "none" && "$status" == "running" && "$restarting" != true ]]; then
      label="${GREEN}running${RESET}"
    elif [[ "$health" == "starting" && "$restarting" != true && "$restarts" == 0 ]]; then
      label="${YELLOW}starting${RESET}"
      all_ok=false
    else
      if [[ "$restarting" == true ]]; then label="${RED}restarting${RESET}"; else label="${RED}${health/none/$status}${RESET}"; fi
      all_ok=false
      # A container its restart policy restarted (RestartCount), or is restarting, is
      # crash-looping, also when sampled while starting. krate logs takes the Compose
      # service name, not the container name.
      if [[ "$restarting" == true || "$restarts" != 0 || "$status" == exited ]]; then crashing+=" ${service:-$name}"; fi
    fi

    printf "  %-35s %b\n" "$name" "$label"
  done <<< "$container_ids"

  echo ""
  if $all_ok; then
    ok "All services healthy"
  else
    if [[ -n "$crashing" ]]; then
      warn "Not healthy:$crashing keeps restarting (restarted by its restart policy) or exited. Check: krate logs${crashing}"
    elif $wait && (( $(health_pending_count "$container_ids") > 0 )); then
      warn "Still starting after ${waited}s of ${timeout}s — the cluster may just need longer."
      warn "Retry with a longer wait: krate health --timeout $(( timeout * 2 ))"
    else
      warn "Some services not ready. Run: krate logs <service>"
    fi
    return 1
  fi
}

# ─── ui ───────────────────────────────────────────────────────────────────────
cmd_ui() {
  local user pass fqdn hp port_suffix="" public
  user="$(env_value KAFKA_UI_USER)"
  pass="$(env_value KAFKA_UI_PASSWORD)"
  fqdn="$(get_fqdn)"
  hp="$(env_value KAFKA_UI_HTTPS_PORT)"; hp="${hp:-443}"
  [[ "$hp" != "443" ]] && port_suffix=":${hp}"

  sep
  echo -e "${BOLD}  Kafbat UI${RESET}"
  sep
  if [[ "$(env_value KAFKA_UI_AUTH_CONFIG)" == "runtime.yml" ]]; then
    # In Keycloak sign-in mode the proxy serves KEYCLOAK_PUBLIC_URL's host only.
    public="$(env_value KEYCLOAK_PUBLIC_URL)"; public="${public%/}"
    echo "  URL       ${public%/identity}/"
    echo "  Sign-in   Keycloak (realm krate) — manage users with krate identity users"
  else
    echo "  URL       https://${fqdn}${port_suffix}/"
    [[ -n "$user" ]] && echo "  Username  $user"
    [[ -n "$pass" ]] && echo "  Password  $pass"
  fi
  echo -e "  ${DIM}TLS is a self-signed cert — trust certs/server.crt or proceed past the browser warning.${RESET}"
  sep
}

# ─── studio ───────────────────────────────────────────────────────────────────
cmd_studio() {
