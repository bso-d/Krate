# ── ZK observability configuration ──────────────────────────────────────────
# Copied to .env on first `kafka monitor up`.

# Grafana publishes its port on all host interfaces by default.
# Change the default admin credentials before exposing Grafana remotely.
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Host ports
GRAFANA_PORT=3000
PROM_PORT=9090

# Prometheus on-disk retention
PROM_RETENTION=15d

# Configured broker count for direct Compose startup.
# kafka monitor supplies the count from configured cluster services.
KAFKA_EXPECTED_BROKERS=4

# Monitoring container references.
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0@sha256:9b67b273d1e54052e7ce77c46ecd1c6619fdee7e2ed26717e6272806fbc94150
PROMETHEUS_IMAGE=prom/prometheus:v3.6.0@sha256:76947e7ef22f8a698fc638f706685909be425dbe09bd7a2cd7aca849f79b5f64
GRAFANA_IMAGE=grafana/grafana:12.2.0@sha256:74144189b38447facf737dfd0f3906e42e0776212bf575dc3334c3609183adf7
