+package io.kafbat.ui.config.auth;
+
+import org.springframework.security.oauth2.client.registration.ReactiveClientRegistrationRepository;
+import org.springframework.security.oauth2.client.web.OAuth2AuthorizationRequestCustomizers;
+import org.springframework.security.oauth2.client.web.server.DefaultServerOAuth2AuthorizationRequestResolver;
+import org.springframework.security.oauth2.client.web.server.ServerOAuth2AuthorizationRequestResolver;
+import org.springframework.security.oauth2.core.endpoint.OAuth2AuthorizationRequest;
+import org.springframework.web.server.ServerWebExchange;
+import reactor.core.publisher.Mono;
+
+/** PKCE plus a bounded, non-authoritative identity hint; OAuth authentication remains Spring's. */
+public final class NativeLoginSupport {
+  private NativeLoginSupport() { }
+
+  public static ServerOAuth2AuthorizationRequestResolver resolver(ReactiveClientRegistrationRepository clients) {
+    var delegate = new DefaultServerOAuth2AuthorizationRequestResolver(clients);
+    delegate.setAuthorizationRequestCustomizer(OAuth2AuthorizationRequestCustomizers.withPkce());
+    return new ServerOAuth2AuthorizationRequestResolver() {
+      @Override
+      public Mono<OAuth2AuthorizationRequest> resolve(ServerWebExchange exchange) {
+        return hint(delegate.resolve(exchange), exchange);
+      }
+
+      @Override
+      public Mono<OAuth2AuthorizationRequest> resolve(ServerWebExchange exchange, String id) {
+        return hint(delegate.resolve(exchange, id), exchange);
+      }
+    };
+  }
+
+  private static Mono<OAuth2AuthorizationRequest> hint(
+      Mono<OAuth2AuthorizationRequest> request, ServerWebExchange exchange) {
+    String hint = exchange.getRequest().getQueryParams().getFirst("login_hint");
+    if (hint == null || hint.isBlank() || hint.length() > 254 || hint.chars().anyMatch(Character::isISOControl)) {
+      return request;
+    }
+    // Only this non-authoritative hint is copied. Password, role, state, nonce,
+    // redirect_uri and other caller parameters can never override the OIDC request.
+    return request.map(original -> OAuth2AuthorizationRequest.from(original)
+        .additionalParameters(params -> params.put("login_hint", hint.strip()))
+        .authorizationRequestUri((String) null)
+        .build());
+  }
+}
