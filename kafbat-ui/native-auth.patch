+package io.kafbat.ui.config.auth;
+
+import io.kafbat.ui.service.rbac.AccessControlService;
+import java.util.Collection;
+import java.util.List;
+import org.springframework.core.env.Environment;
+import org.springframework.security.authentication.ReactiveAuthenticationManager;
+import org.springframework.security.authentication.UserDetailsRepositoryReactiveAuthenticationManager;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.core.userdetails.User;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.security.oauth2.client.registration.ReactiveClientRegistrationRepository;
+import org.springframework.security.oauth2.client.web.server.DefaultServerOAuth2AuthorizationRequestResolver;
+import org.springframework.security.oauth2.client.web.server.ServerOAuth2AuthorizationRequestResolver;
+import org.springframework.security.oauth2.client.web.OAuth2AuthorizationRequestCustomizers;
+import org.springframework.security.oauth2.core.endpoint.OAuth2AuthorizationRequest;
+import org.springframework.util.Assert;
+import org.springframework.web.server.ServerWebExchange;
+import reactor.core.publisher.Mono;
+
+/** Local shared login and an optional identity hint; OAuth authentication remains Spring's. */
+public final class NativeLoginSupport {
+  private NativeLoginSupport() { }
+
+  public static boolean sharedEnabled(Environment environment) {
+    return environment.getProperty("auth.oauth2.allow-shared-login", Boolean.class, false);
+  }
+
+  public static ReactiveAuthenticationManager sharedManager(Environment environment, AccessControlService acs) {
+    String username = environment.getRequiredProperty("spring.security.user.name");
+    String password = environment.getRequiredProperty("spring.security.user.password");
+    String role = environment.getRequiredProperty("auth.oauth2.shared-role");
+    Assert.hasText(username, "Shared username is required");
+    Assert.hasText(password, "Shared password is required");
+    Assert.isTrue(acs.isRbacEnabled() && acs.getRoles().stream().anyMatch(r -> role.equals(r.getName())),
+        "Shared login requires a configured RBAC role");
+    var encoder = new BCryptPasswordEncoder();
+    String hash = encoder.encode(password);
+    var manager = new UserDetailsRepositoryReactiveAuthenticationManager(
+        name -> Mono.<org.springframework.security.core.userdetails.UserDetails>just(
+            new SharedUser(username, hash, role)).filter(u -> u.getUsername().equals(name)));
+    manager.setPasswordEncoder(encoder);
+    return manager;
+  }
+
+  private static final class SharedUser extends User implements RbacUser {
+    private final String role;
+
+    SharedUser(String username, String hash, String role) {
+      super(username, hash, List.of(new SimpleGrantedAuthority(role)));
+      this.role = role;
+    }
+
+    @Override
+    public String name() { return getUsername(); }
+
+    @Override
+    public Collection<String> groups() { return List.of(role); }
+  }
+
+  public static ServerOAuth2AuthorizationRequestResolver resolver(ReactiveClientRegistrationRepository clients) {
+    var delegate = new DefaultServerOAuth2AuthorizationRequestResolver(clients);
+    delegate.setAuthorizationRequestCustomizer(OAuth2AuthorizationRequestCustomizers.withPkce());
+    return new ServerOAuth2AuthorizationRequestResolver() {
+      @Override
+      public Mono<OAuth2AuthorizationRequest> resolve(ServerWebExchange exchange) {
+        return hint(delegate.resolve(exchange), exchange);
+      }
+
+      @Override
+      public Mono<OAuth2AuthorizationRequest> resolve(ServerWebExchange exchange, String id) {
+        return hint(delegate.resolve(exchange, id), exchange);
+      }
+    };
+  }
+
+  private static Mono<OAuth2AuthorizationRequest> hint(
+      Mono<OAuth2AuthorizationRequest> request, ServerWebExchange exchange) {
+    String hint = exchange.getRequest().getQueryParams().getFirst("login_hint");
+    if (hint == null || hint.isBlank() || hint.length() > 254 || hint.chars().anyMatch(Character::isISOControl)) {
+      return request;
+    }
+    // Only this non-authoritative hint is copied. Password, role, state, nonce,
+    // redirect_uri and other caller parameters can never override the OIDC request.
+    return request.map(original -> OAuth2AuthorizationRequest.from(original)
+        .additionalParameters(params -> params.put("login_hint", hint.strip()))
+        .authorizationRequestUri((String) null)
+        .build());
+  }
+}
