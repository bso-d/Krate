@@ -0,0 +1,27 @@
+import { ssoLoginUrl } from 'components/AuthPage/SignIn/BasicSignIn/ssoLogin';
+
+it('passes only the entered identity hint, safely encoded', () => {
+  expect(
+    ssoLoginUrl(
+      '/oauth2/authorization/keycloak',
+      ' person+test@example.com '
+    )
+  ).toBe(
+    '/oauth2/authorization/keycloak?login_hint=person%2Btest%40example.com'
+  );
+});
+
+it.each(['', '   ', 'a\nb', 'a'.repeat(255)])(
+  'rejects an invalid hint',
+  (value) => {
+    expect(() =>
+      ssoLoginUrl('/oauth2/authorization/keycloak', value)
+    ).toThrow();
+  }
+);
+
+it('cannot redirect to an arbitrary server', () => {
+  expect(() =>
+    ssoLoginUrl('https://other.example', 'user@example.com')
+  ).toThrow();
+});
