@@ -0,0 +1,57 @@
+import React from 'react';
+import { screen } from '@testing-library/react';
+import { render } from 'lib/testHelpers';
+import { AuthType } from 'generated-sources';
+import SignInForm from 'components/AuthPage/SignIn/SignIn';
+
+it('keeps the native username/password form and adds one independent SSO button', () => {
+  render(
+    <SignInForm
+      authType={AuthType.LOGIN_FORM}
+      oAuthProviders={[
+        {
+          clientName: 'SSO',
+          authorizationUri: '/oauth2/authorization/keycloak',
+        },
+      ]}
+    />
+  );
+  expect(screen.getByLabelText('Username / email')).toBeInTheDocument();
+  expect(screen.getByLabelText('Password')).toHaveAttribute('type', 'password');
+  expect(screen.getByRole('button', { name: 'Log in' })).toBeInTheDocument();
+  expect(
+    screen.getByRole('button', { name: 'Sign in with SSO' })
+  ).toBeEnabled();
+  expect(
+    screen.getByRole('button', { name: 'Sign in with SSO' })
+  ).toHaveAttribute('type', 'button');
+  expect(
+    screen.queryByText('Use an account issued by the organization')
+  ).not.toBeInTheDocument();
+});
+
+it('preserves native basic-login mode', () => {
+  render(<SignInForm authType={AuthType.LOGIN_FORM} />);
+  expect(screen.getByLabelText('Username')).toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: 'Sign in with SSO' })
+  ).not.toBeInTheDocument();
+});
+
+it('preserves other OAuth provider configurations', () => {
+  render(
+    <SignInForm
+      authType={AuthType.OAUTH2}
+      oAuthProviders={[
+        {
+          clientName: 'Company',
+          authorizationUri: '/oauth2/authorization/company',
+        },
+      ]}
+    />
+  );
+  expect(
+    screen.getByRole('button', { name: 'Log in with Company' })
+  ).toBeInTheDocument();
+  expect(screen.queryByLabelText('Password')).not.toBeInTheDocument();
+});
