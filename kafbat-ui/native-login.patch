@@ -0,0 +1,77 @@
+import { csrfMiddleware, csrfToken, postForm, withCsrfHeader } from 'lib/csrf';
+
+const setCookie = (value: string) => {
+  Object.defineProperty(document, 'cookie', {
+    value,
+    writable: true,
+    configurable: true,
+  });
+};
+
+describe('csrf', () => {
+  afterEach(() => {
+    setCookie('');
+    document.body.innerHTML = '';
+  });
+
+  it('reads the XSRF-TOKEN cookie among others', () => {
+    setCookie('SESSION=abc; XSRF-TOKEN=tok%2D1; other=2');
+    expect(csrfToken()).toBe('tok-1');
+  });
+
+  it('returns no token without the cookie', () => {
+    setCookie('SESSION=abc');
+    expect(csrfToken()).toBeUndefined();
+  });
+
+  it('adds the header to unsafe methods only and keeps existing headers', () => {
+    setCookie('XSRF-TOKEN=tok');
+    const post = withCsrfHeader({
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+    });
+    expect(post.headers).toEqual({
+      'content-type': 'application/json',
+      'X-XSRF-TOKEN': 'tok',
+    });
+    expect(withCsrfHeader({ method: 'DELETE' }).headers).toEqual({
+      'X-XSRF-TOKEN': 'tok',
+    });
+    expect(withCsrfHeader({ method: 'get' }).headers).toBeUndefined();
+    expect(withCsrfHeader({}).headers).toBeUndefined();
+  });
+
+  it('leaves the request unchanged when no token is available', () => {
+    setCookie('');
+    const init = { method: 'POST', headers: { a: 'b' } };
+    expect(withCsrfHeader(init)).toBe(init);
+  });
+
+  it('applies the header through the generated-client middleware', async () => {
+    setCookie('XSRF-TOKEN=tok');
+    const result = await csrfMiddleware.pre({
+      url: '/api/x',
+      init: { method: 'PATCH' },
+    });
+    expect(result).toEqual({
+      url: '/api/x',
+      init: { method: 'PATCH', headers: { 'X-XSRF-TOKEN': 'tok' } },
+    });
+  });
+
+  it('submits a hidden POST form carrying the _csrf field', () => {
+    setCookie('XSRF-TOKEN=tok');
+    const submit = jest
+      .spyOn(HTMLFormElement.prototype, 'submit')
+      .mockImplementation(() => {});
+    postForm('/base/logout');
+    const form = document.querySelector('form') as HTMLFormElement;
+    expect(form).toHaveAttribute('method', 'post');
+    expect(form).toHaveAttribute('action', '/base/logout');
+    const field = form.querySelector('input') as HTMLInputElement;
+    expect(field.type).toBe('hidden');
+    expect(field.name).toBe('_csrf');
+    expect(field.value).toBe('tok');
+    expect(submit).toHaveBeenCalledTimes(1);
+  });
+});
