diff --git a/frontend/src/lib/csrf.ts b/frontend/src/lib/csrf.ts
new file mode 100644
index 0000000..d82ae16
--- /dev/null
+++ b/frontend/src/lib/csrf.ts
@@ -0,0 +1,55 @@
+export const CSRF_COOKIE = 'XSRF-TOKEN';
+export const CSRF_HEADER = 'X-XSRF-TOKEN';
+export const CSRF_FIELD = '_csrf';
+
+const SAFE_METHODS = ['GET', 'HEAD', 'OPTIONS', 'TRACE'];
+
+/** The token Spring Security issued in the readable XSRF-TOKEN cookie, if any. */
+export function csrfToken(): string | undefined {
+  const entry = document.cookie
+    .split(';')
+    .map((part) => part.trim())
+    .find((part) => part.startsWith(`${CSRF_COOKIE}=`));
+  if (!entry) return undefined;
+  const value = entry.slice(CSRF_COOKIE.length + 1);
+  return value ? decodeURIComponent(value) : undefined;
+}
+
+/** Adds X-XSRF-TOKEN to a request whose method can change state. */
+export function withCsrfHeader(init: RequestInit = {}): RequestInit {
+  const method = (init.method || 'GET').toUpperCase();
+  const token = csrfToken();
+  if (SAFE_METHODS.includes(method) || !token) return init;
+  const headers: Record<string, string> = {};
+  new Headers(init.headers).forEach((value, key) => {
+    headers[key] = value;
+  });
+  headers[CSRF_HEADER] = token;
+  return { ...init, headers };
+}
+
+/** Generated-client middleware: every unsafe API call carries the token. */
+export const csrfMiddleware = {
+  pre: async ({ url, init }: { url: string; init: RequestInit }) => ({
+    url,
+    init: withCsrfHeader(init),
+  }),
+};
+
+/** Navigates with a POST, as a hidden form, so the server-side logout matcher accepts it. */
+export function postForm(action: string): void {
+  const form = document.createElement('form');
+  form.method = 'post';
+  form.action = action;
+  form.style.display = 'none';
+  const token = csrfToken();
+  if (token) {
+    const field = document.createElement('input');
+    field.type = 'hidden';
+    field.name = CSRF_FIELD;
+    field.value = token;
+    form.appendChild(field);
+  }
+  document.body.appendChild(form);
+  form.submit();
+}
