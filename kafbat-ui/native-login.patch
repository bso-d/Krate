index 0000000..9d5330d
--- /dev/null
+++ b/frontend/src/components/AuthPage/SignIn/BasicSignIn/ssoLogin.ts
@@ -0,0 +1,20 @@
+export function ssoLoginUrl(
+  authorizationUri: string,
+  username: string
+): string {
+  if (authorizationUri !== '/oauth2/authorization/keycloak') {
+    throw new Error('Unable to start SSO');
+  }
+  const hint = username.trim();
+  if (
+    !hint ||
+    hint.length > 254 ||
+    Array.from(hint).some(
+      (c) => c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127
+    )
+  ) {
+    throw new Error('Enter your company email to continue with SSO');
+  }
+  const query = new URLSearchParams({ login_hint: hint });
+  return `${window.basePath || ''}${authorizationUri}?${query}`;
+}
