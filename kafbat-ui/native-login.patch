+import React from 'react';
+import { screen } from '@testing-library/react';
+import { render } from 'lib/testHelpers';
+import { AuthType } from 'generated-sources';
+import SignInForm from 'components/AuthPage/SignIn/SignIn';
+
+const keycloak = [
+  {
+    clientName: 'Keycloak',
+    authorizationUri: '/oauth2/authorization/keycloak',
+  },
+];
+
+it('renders only the provider button in OAUTH2 mode: no local credential form', () => {
+  render(<SignInForm authType={AuthType.OAUTH2} oAuthProviders={keycloak} />);
+  expect(
+    screen.getByRole('button', { name: 'Log in with Keycloak' })
+  ).toBeInTheDocument();
+  expect(screen.queryByLabelText('Username')).not.toBeInTheDocument();
+  expect(screen.queryByLabelText('Password')).not.toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: 'Log in' })
+  ).not.toBeInTheDocument();
+});
+
+it('keeps the native credential form in LOGIN_FORM mode without any SSO button', () => {
+  render(<SignInForm authType={AuthType.LOGIN_FORM} />);
+  expect(screen.getByLabelText('Username')).toHaveAttribute(
+    'autocomplete',
+    'username'
+  );
+  expect(screen.getByLabelText('Password')).toHaveAttribute('type', 'password');
+  expect(screen.getByRole('button', { name: 'Log in' })).toBeInTheDocument();
+  expect(
+    screen.queryByRole('button', { name: /sso/i })
+  ).not.toBeInTheDocument();
+});
