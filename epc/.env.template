# Kafbat UI login credentials
# krate (setup, start, install) generates a password while this is empty;
# `krate credentials` shows it. Set your own with:
# krate config set KAFKA_UI_PASSWORD=...
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=

# local.yml keeps password login; pingfederate.yml is generated using sso/configure.py.
# A missing selected config fails startup; there is no automatic password fallback.
# runtime.yml enables shared Admin + Keycloak SSO; configure with ./krate auth.
# SSO: Compose >=2.20.2; run ./krate identity up, then ./krate auth configure,
# select runtime.yml with ./krate config set KAFKA_UI_AUTH_CONFIG=runtime.yml,
# then ./krate auth apply.
KAFKA_UI_AUTH_CONFIG=local.yml
# Optional JVM truststore arguments for the enterprise CA; never disable TLS checks.
KAFKA_UI_JAVA_OPTS=

# Fully-qualified domain name clients use to reach the UI (https://<FQDN>/).
# Used as the CN/SAN of the auto-generated self-signed TLS certificate.
# Leave blank to fall back to the VM's hostname.
KAFKA_UI_FQDN=

# Host ports for the nginx TLS proxy. The UI is served over HTTPS on 443;
# HTTP on 80 redirects to HTTPS. Change only if these clash on the VM.
KAFKA_UI_HTTPS_PORT=443
KAFKA_UI_HTTP_PORT=80

# Keycloak is the local identity service (realm "krate"); it can also broker
# PingFederate. `krate identity up` starts it and sets KEYCLOAK_ENABLED=true,
# after which every krate command includes the sso profile. krate generates the
# Keycloak secrets left at REPLACE_ME before Keycloak's database first starts;
# afterwards change one only with `krate identity rotate KEY`. `krate auth
# configure` sets KEYCLOAK_PUBLIC_URL, and `krate auth apply` asks for the
# secret PingFederate issued for Keycloak (PING_KEYCLOAK_CLIENT_SECRET).
KEYCLOAK_ENABLED=false
KEYCLOAK_PUBLIC_URL=https://localhost/identity
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME
KEYCLOAK_DB_PASSWORD=REPLACE_ME
KEYCLOAK_KAFBAT_CLIENT_SECRET=REPLACE_ME
# Service-account client krate-cli in realm krate. `krate identity users`
# manages local users with it; the master admin is not needed for that.
KEYCLOAK_CLI_CLIENT_SECRET=REPLACE_ME
PING_KEYCLOAK_CLIENT_SECRET=REPLACE_ME
# Realm groups that `krate identity users add --viewer|--admin` assigns and
# that Kafbat maps to its viewer and administrator roles (claim "groups").
KEYCLOAK_VIEWER_GROUP=KRATE_VIEWERS
KEYCLOAK_ADMIN_GROUP=KRATE_ADMINS
# Token and browser-session limits written into the realm plan. Keycloak reads
# the plan only when the realm is first created; change an existing realm
# through Keycloak administration (see docs/identity-foundation.md).
KEYCLOAK_ACCESS_TOKEN_MINUTES=5
KEYCLOAK_SESSION_IDLE_MINUTES=15
KEYCLOAK_SESSION_MAX_HOURS=8
# Private Docker network for Keycloak, its database, the proxy and Kafbat (no
# route to the host or outside). The proxy gets the fixed address below, and
# Keycloak accepts X-Forwarded-* headers from that address only. Change both
# together when the range is already in use on this host; `krate identity up`
# refuses a subnet that another Docker network uses.
KRATE_IDENTITY_SUBNET=172.29.250.0/24
KRATE_IDENTITY_PROXY_IP=172.29.250.10

# Local cluster defaults for kafbat.yml. Add any additional clusters there.
KAFKA_UI_CLUSTER_NAME=cluster-epc
KAFKA_UI_READONLY=false

# ─── Cluster identity ───────────────────────────────────────────────────────
# Shared by both nodes and embedded in on-disk storage at first boot. Do NOT
# change it after the cluster has started — the brokers will refuse to mount
# their log dirs. Regenerate only for a genuinely fresh cluster:
#   python3 -c "import uuid,base64;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
CLUSTER_ID=2E9jpFXaQP--89X_SBs4Xg

# ─── Broker host ports ──────────────────────────────────────────────────────
# EPC exposes the brokers directly on 9092/9093 — there is no 190xx range.
KAFKA_BROKER_92_PORT=9092
KAFKA_BROKER_93_PORT=9093

# Hostname/IP that OFF-BOX clients use to reach the brokers. This is what the
# brokers advertise, so 'localhost' works only for clients running on this VM.
# Set it to this host's FQDN or IP before pointing any remote producer/consumer
# at the cluster, then: ./krate restart
KAFKA_ADVERTISED_HOST=localhost

# ─── Storage ────────────────────────────────────────────────────────────────
# Broker log directories are bind-mounted under this path (NOT docker named
# volumes under /var/lib/docker), so Kafka data lands on the /data disk.
# './krate' creates <KAFKA_DATA_DIR>/krate/broker-{92,93} and chowns them to
# KAFKA_UID:KAFKA_GID, which is the uid the apache/kafka image runs as.
KAFKA_DATA_DIR=/data
KAFKA_UID=1000
KAFKA_GID=1000

# ─── Topic defaults (2-broker cluster) ──────────────────────────────────────
# RF and min ISR are fixed in docker-compose.yml (2 and 1) because a 2-broker
# cluster cannot honour the 4-broker defaults. These remain tunable:
KAFKA_NUM_PARTITIONS=24
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_SEGMENT_BYTES=1073741824

# ─── Disk ceiling ───────────────────────────────────────────────────────────
# BOTH brokers write to this one disk, and RF=2 means every record is stored
# twice — so /data holds 2x the logical data. Time-based retention alone cannot
# bound that: a traffic spike fills the disk long before 168h elapses.
#
# KAFKA_LOG_RETENTION_BYTES caps ONE partition replica. Total worst case is:
#
#   /data used  =  topics x partitions x 2 (RF)  x  KAFKA_LOG_RETENTION_BYTES
#
# At the 2 GiB default with 24 partitions, each topic can reach 96 GB on /data:
#
#   topics :   1      2      4      6      8
#   /data  :  96GB  192GB  384GB  576GB  768GB   (of 1000 GB)
#
# So ~6 topics of 24 partitions sit inside a 60% budget. Raise the cap only
# after checking that line. Run `./krate disk` to see current usage.
#
# Topic auto-creation is OFF by default, so that ceiling holds: clients cannot
# silently add topics — and disk. Creating topics explicitly is unaffected —
# the Kafbat UI, kafka-topics.sh and any AdminClient use the CreateTopics API,
# which this setting does not govern. Kafka's own internal topics
# (__consumer_offsets, __transaction_state) are also created regardless.
# Set to true only if a producer relies on writing to a topic that does not
# exist yet; then re-check the ceiling above.
KAFKA_LOG_RETENTION_BYTES=2147483648

# Share of the data disk Kafka should stay under. `./krate disk` warns past it.
KAFKA_DATA_BUDGET_PCT=60

# Let clients create topics implicitly by producing to them (see above).
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

# ─── Container images (single source of truth) ──────────────────────────────
# These pins are consumed by BOTH docker-compose.yml and the Makefile's bundle
# step, so the images that get saved into the offline bundle always match the
# images the cluster runs. Change a pin here and everything follows. Do not use
# floating tags (e.g. :latest) — the bundle must be reproducible offline.
KAFKA_IMAGE=apache/kafka:3.9.1@sha256:4ceccc577f03f51f6af8dbfda55194d0d892f4fa7913ffbded567ce3895622ed
# Built locally with make kafbat-ui; included in both offline bundles.
KAFKA_UI_IMAGE=krate/kafka-ui:1.5.0-sso.5@sha256:6983e44dd23667bff4fba37841611c5d0e168507aedf33b7f0debd3fc3538a78
NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0@sha256:b0f60d489d51c5d113390bdf5461d4c06e6051be026c05549f2e1e10ec352bcc
KEYCLOAK_DB_IMAGE=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
