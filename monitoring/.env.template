# Krate observability stack — shared by every variant.
#
# `krate monitor up` fills KAFKA_NETWORK, KAFKA_EXPORTER_TARGETS and
# CLUSTER_LABEL automatically by inspecting the running cluster, so you normally
# only edit the ports, credentials and SMTP settings below.

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_AUTH_CONFIG=local.ini
# Host-side file for an approved Grafana service-account token used by alert seeding.
# Required when SSO disables Basic auth. Relative paths resolve from this .env.
GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE=

# ─── Prometheus ─────────────────────────────────────────────────────────────
PROM_PORT=9090
PROM_RETENTION=15d

# ─── Loki ───────────────────────────────────────────────────────────────────
LOKI_PORT=3100

# ─── Email alerting (optional; the stack runs fine without it) ──────────────
# Grafana sends alert email through this relay. Leave GF_SMTP_ENABLED=false and
# alerts still fire and show in the UI — they just are not emailed. Recipients
# and which rules notify are configured in the Grafana UI, so no redeploy is
# needed to change them.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=krate-alerts@example.com
GF_SMTP_FROM_NAME=Krate
GF_SMTP_SKIP_VERIFY=false
# Default recipient for the provisioned contact point.
ALERT_EMAIL_TO=ops@example.com

# ─── Perses (parallel dashboards over HTTPS; Grafana keeps running) ────────
PERSES_PORT=3443
# local:   Perses' own login with the admin below (default, no IdP needed).
# native:  company SSO; IdP groups become native Perses Viewer/Admin roles.
# gateway: company SSO; the gateway enforces Viewer/Admin, Perses auth is off.
# For native/gateway run sso/configure.py --app perses (see sso/guides).
PERSES_AUTH_MODE=local
PERSES_ADMIN_USER=admin
# At least 12 characters. `krate monitor up` refuses the empty default.
PERSES_ADMIN_PASSWORD=
# Generated by `krate monitor up` when empty (exactly 32 characters).
PERSES_ENCRYPTION_KEY=
# SSO only. The Perses OIDC client secret (shared by OAuth2 Proxy) and the
# access guard's client-credentials secret, both from your IAM team.
OAUTH2_PROXY_CLIENT_SECRET=
PERSES_SYNC_CLIENT_SECRET=
# SSO only. Generated by `krate monitor up` when empty.
OAUTH2_PROXY_COOKIE_SECRET=

# ─── VictoriaLogs (parallel log store for Perses) ───────────────────────────
VICTORIALOGS_RETENTION=7d

# ─── Alertmanager (parallel alert email) ────────────────────────────────────
# Uses the GF_SMTP_* relay and ALERT_EMAIL_TO above. Follows GF_SMTP_ENABLED
# unless set; while Grafana email is also on, recipients get both emails.
ALERTMANAGER_EMAIL_ENABLED=
# STARTTLS is required unless the relay uses port 465 (implicit TLS).
ALERTMANAGER_SMTP_REQUIRE_TLS=true

# ─── Filled in by `krate monitor up` (override only for manual runs) ────────
# The cluster's docker network, so the exporter can reach brokers by name.
KAFKA_NETWORK=krate_kafka-network
# One --kafka.server=host:port per broker, space separated.
KAFKA_EXPORTER_TARGETS=--kafka.server=kafka-92:9092
# Label applied to every scraped series.
CLUSTER_LABEL=krate
# Compose project name, so two variants can be monitored side by side.
MONITOR_PROJECT=krate-monitoring
# Directory holding server.crt and server.key for Perses HTTPS (the cluster's).
PERSES_CERTS_DIR=../certs

# ─── Images (pinned — the bundle must be reproducible offline) ──────────────
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0@sha256:9b67b273d1e54052e7ce77c46ecd1c6619fdee7e2ed26717e6272806fbc94150
PROMETHEUS_IMAGE=prom/prometheus:v3.6.0@sha256:76947e7ef22f8a698fc638f706685909be425dbe09bd7a2cd7aca849f79b5f64
GRAFANA_IMAGE=grafana/grafana:12.2.0@sha256:74144189b38447facf737dfd0f3906e42e0776212bf575dc3334c3609183adf7
LOKI_IMAGE=grafana/loki:3.5.0@sha256:4c431d2e6b9b38718694b31c5d56be7c80dc69c513215fde1aeb5b02cd4e2665
FLUENT_BIT_IMAGE=cr.fluentbit.io/fluent/fluent-bit:5.1.3@sha256:c5542543523c9678398dd78d927c05e8425ec15b038f226b67b3b019b1a70845
LOG_DISCOVERY_IMAGE=python:3.14.8-slim-trixie@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1@sha256:d00a542e409ee618a4edc67da14dd48c5da66726bbd5537ab2af9c1dfc442c8a
PERSES_IMAGE=persesdev/perses:v0.54.0@sha256:a0e34ddaf9d7599d96036611af205b948c1179646844202d869f3bcf3d5d9e9c
